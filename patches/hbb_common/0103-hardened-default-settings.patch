+
+#[cfg(test)]
+mod remotesmith_hardened_defaults_tests {
+    use super::*;
+
+    // DEC-10 / AC-10: hardened defaults are in place and the temporary password is off.
+    #[test]
+    fn hardened_defaults() {
+        let d = remotesmith_default_settings();
+        assert_eq!(d.get("approve-mode").map(String::as_str), Some("password"));
+        assert_eq!(d.get("direct-server").map(String::as_str), Some("Y"));
+        assert_eq!(d.get("enable-lan-discovery").map(String::as_str), Some("Y"));
+        let o = remotesmith_overwrite_settings();
+        assert_eq!(
+            o.get("verification-method").map(String::as_str),
+            Some("use-permanent-password")
+        );
+        assert_eq!(o.get("allow-hide-cm").map(String::as_str), Some("N"));
+        assert!(!option2bool("allow-hide-cm", "N"));
+        assert!(option2bool(keys::OPTION_DIRECT_SERVER, "Y"));
+    }
+
+    #[test]
+    fn temporary_password_cannot_be_reenabled() {
+        // OVERWRITE_SETTINGS wins over whatever is stored, and the stored value is dropped.
+        let overwrite = RwLock::new(remotesmith_overwrite_settings());
+        let defaults = RwLock::new(remotesmith_default_settings());
+        let mut stored = HashMap::new();
+        stored.insert(
+            "verification-method".to_owned(),
+            "use-both-passwords".to_owned(),
+        );
+        assert_eq!(
+            get_or(&overwrite, &stored, &defaults, "verification-method").as_deref(),
+            Some("use-permanent-password")
+        );
+        assert!(!is_option_can_save(
+            &overwrite,
+            "verification-method",
+            &defaults,
+            "use-both-passwords"
+        ));
+        // A default the user changes is saved; setting it back to the default clears it.
+        assert!(is_option_can_save(&overwrite, "direct-server", &defaults, "N"));
+        assert!(!is_option_can_save(&overwrite, "direct-server", &defaults, "Y"));
+        assert_eq!(
+            get_or(&overwrite, &HashMap::new(), &defaults, "approve-mode").as_deref(),
+            Some("password")
+        );
+    }
+}
