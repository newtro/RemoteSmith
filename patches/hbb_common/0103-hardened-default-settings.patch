+/// RemoteSmith hardened defaults (DEC-10). The user can change these in Settings.
+/// `approve-mode=password`: sessions need the password, no click-to-accept by default.
+/// `direct-server=Y`: direct IP access (port 21118) on, so the LAN works without the server.
+/// `enable-lan-discovery=Y`: LAN discovery on.
+pub fn remotesmith_default_settings() -> HashMap<String, String> {
+    HashMap::from([
+        ("approve-mode".to_owned(), "password".to_owned()),
+        (keys::OPTION_DIRECT_SERVER.to_owned(), "Y".to_owned()),
+        ("enable-lan-discovery".to_owned(), "Y".to_owned()),
+    ])
+}
+
+/// RemoteSmith fixed settings (DEC-10, AC-10): only the permanent password is accepted,
+/// the temporary (one-time) password stays disabled and cannot be turned back on.
+/// `allow-hide-cm=N`: the renamed (custom-client) build would otherwise honour hide_cm with the
+/// hardened password-only defaults, letting a session run with no host-side indicator (§6.2a).
+pub fn remotesmith_overwrite_settings() -> HashMap<String, String> {
+    HashMap::from([
+        (
+            "verification-method".to_owned(),
+            "use-permanent-password".to_owned(),
+        ),
+        ("allow-hide-cm".to_owned(), "N".to_owned()),
+    ])
+}
+
