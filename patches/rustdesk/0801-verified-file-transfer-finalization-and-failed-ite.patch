+    // RemoteSmith(0801): host-side uploads through handle_fs, as the server process drives it.
+    #[cfg(not(any(target_os = "ios")))]
+    async fn upload(id: i32, dir: &std::path::Path, size: u64, blocks: &[&[u8]]) -> Vec<Message> {
+        let (tx, mut rx) = unbounded_channel();
+        let (mut write_jobs, mut read_jobs) = (Vec::new(), Vec::new());
+        let mut msgs = vec![ipc::FS::NewWrite {
+            path: dir.to_string_lossy().to_string(),
+            id,
+            file_num: 0,
+            files: vec![("up.bin".to_owned(), 1_600_000_000)],
+            overwrite_detection: false,
+            total_size: size,
+            conn_id: 1,
+            file_sizes: vec![size],
+        }];
+        for b in blocks {
+            msgs.push(ipc::FS::WriteBlock {
+                id,
+                file_num: 0,
+                data: b.to_vec().into(),
+                compressed: false,
+            });
+        }
+        msgs.push(ipc::FS::WriteDone { id, file_num: 0 });
+        for m in msgs {
+            handle_fs(m, &mut write_jobs, &mut read_jobs, &tx, None, 1).await;
+        }
+        let mut out = Vec::new();
+        while let Ok(Data::RawMessage(bytes)) = rx.try_recv() {
+            out.push(Message::parse_from_bytes(&bytes).unwrap());
+        }
+        out
+    }
+
+    #[test]
+    #[cfg(not(any(target_os = "ios")))]
+    fn upload_is_verified_before_done() {
+        use base::message_proto::file_response;
+        let dir = std::env::temp_dir().join(format!("rs_cm_upload_{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).unwrap();
+        let kind = |m: &Message| match &m.file_response().union {
+            Some(file_response::Union::Done(_)) => "done".to_owned(),
+            Some(file_response::Union::Error(e)) => format!("error: {}", e.error),
+            other => format!("{:?}", other),
+        };
+        let rt = Runtime::new().unwrap();
+        // Short data, properly terminated: an error, never done, and no final file.
+        let out = rt.block_on(upload(8001, &dir, 5, &[b"abc", b""]));
+        assert_eq!(out.len(), 1);
+        assert!(kind(&out[0]).contains("received 3 bytes, 5 listed"), "{}", kind(&out[0]));
+        assert!(!dir.join("up.bin").exists() && !dir.join("up.bin.download").exists());
+        // Complete data: done, file in place.
+        let out = rt.block_on(upload(8002, &dir, 3, &[b"abc", b""]));
+        assert_eq!(out.iter().map(kind).collect::<Vec<_>>(), vec!["done"]);
+        assert_eq!(fs::read(dir.join("up.bin")).unwrap(), b"abc");
+        let _ = fs::remove_dir_all(&dir);
+    }
