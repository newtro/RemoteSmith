+        job.write(block(2005, 0, b"abc")).await.unwrap();
+        let err = job.finish().await.expect("rename failure must fail the job");
+        assert!(err.starts_with("a: "), "{}", err);
+        assert_eq!(names_in(&dir), vec!["a"]);
