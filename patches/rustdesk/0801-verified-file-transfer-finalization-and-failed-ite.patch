+    #[test]
+    fn new_transfer_removes_stale_staging_but_resume_keeps_it() {
+        let tmp = TestTempDir::new("rs_xfer_stale");
+        std::fs::create_dir_all(&tmp.path).unwrap();
+        let target = get_string(&tmp.join("f.bin"));
+        let stage = |s: &str| std::fs::write(format!("{target}.{s}"), b"x").unwrap();
+        let digest = FileTransferDigest {
+            file_size: 9,
+            last_modified: 1,
+            ..Default::default()
+        };
+        stage("download");
+        stage("digest");
+        // Resuming: staging data is what the resume continues from.
+        assert!(is_write_need_confirmation(true, &target, &digest).is_ok());
+        assert!(Path::new(&format!("{target}.download")).exists());
+        // A new transfer of the same file: crash leftovers are removed.
+        assert!(matches!(
+            is_write_need_confirmation(false, &target, &digest),
+            Ok(DigestCheckResult::NoSuchFile)
+        ));
+        assert!(names_in(&tmp.path).is_empty(), "{:?}", names_in(&tmp.path));
+    }
+
+    /// A real full disk: a 5 MB disk image (macOS `hdiutil`) and an 8 MB file. The write that
+    /// hits ENOSPC (directly, or deferred to the flush) fails the job and nothing gets the final
+    /// name. Run with: cargo test -p base --lib disk_full -- --ignored
+    #[cfg(target_os = "macos")]
+    #[ignore]
+    #[tokio::test]
+    async fn disk_full_fails_the_job() {
+        let tmp = TestTempDir::new("rs_xfer_full");
+        std::fs::create_dir_all(&tmp.path).unwrap();
+        let img = tmp.join("small.dmg");
+        let mnt = tmp.join("mnt");
+        let run = |args: &[&str]| {
+            let st = std::process::Command::new("hdiutil").args(args).status().unwrap();
+            assert!(st.success(), "hdiutil {:?}", args);
+        };
+        run(&["create", "-size", "5m", "-fs", "HFS+", "-volname", "rsfull", "-quiet", &get_string(&img)]);
+        run(&["attach", "-nobrowse", "-quiet", "-mountpoint", &get_string(&mnt), &get_string(&img)]);
+        let dir = mnt.join("dst");
+        let chunk = vec![7u8; 128 * 1024];
+        let mut job = sized_job(2006, &dir, vec![sized_entry("small", 4), sized_entry("big", 8 << 20)]);
+        job.write(block(2006, 0, b"done")).await.unwrap();
+        let mut failed = None;
+        for _ in 0..64 {
+            if let Err(e) = job.write(block(2006, 1, &chunk)).await {
+                failed = Some(e.to_string());
+                break;
+            }
+        }
+        let err = match failed {
+            Some(e) => e,
+            None => job.finish().await.expect("a full disk must fail the job"),
+        };
+        assert!(err.starts_with("big: "), "{}", err);
+        assert_eq!(job.finish().await.as_deref(), Some(err.as_str()));
+        let names = names_in(&dir);
+        run(&["detach", "-quiet", &get_string(&mnt)]);
+        assert_eq!(names, vec!["small"], "completed file intact, no partial file: {:?}", names);
+    }
 }
