+        // The destination of `a` is a non-empty directory: the verified file cannot be
+        // renamed (as with a file held open on Windows). The failure surfaces when `b` starts.
+        std::fs::create_dir_all(d.dir.join("a/keep")).unwrap();
+        d.block(0, b"abc").await;
+        d.block(0, b"").await;
+        d.block(1, b"b").await;
+        d.done(1).await;
+        assert_eq!(d.remote.job_reports.len(), 1, "{:?}", d.remote.job_reports);
+        assert!(d.remote.job_reports[0].1.as_deref().unwrap().starts_with("a: "));
+        assert!(d.remote.write_jobs.is_empty());
+        // Cancelling the job kept a's verified data staged; nothing of b exists.
+        assert_eq!(d.names(), vec!["a", "a.digest", "a.download"]);
+    }
+
+    #[tokio::test]
+    async fn corrupt_compressed_block_fails_the_download() {
+        let mut d = Download::start(7004, vec![entry("a", 4)]).await;
+        let id = d.id;
+        d.recv(file_response(|fr| {
+            fr.set_block(FileTransferBlock {
+                id,
+                file_num: 0,
+                data: b"not zstd".to_vec().into(),
+                compressed: true,
+                ..Default::default()
+            })
+        }))
+        .await;
+        d.block(0, b"").await;
+        d.done(0).await;
+        assert_eq!(d.remote.job_reports.len(), 1);
+        assert!(d.remote.job_reports[0].1.as_deref().unwrap().contains("corrupt"));
+        assert!(d.names().is_empty(), "{:?}", d.names());
+    }
+
+    #[tokio::test]
+    async fn skip_decision_removes_only_own_stale_staging() {
+        // Overwrite detection on: the peer sends a digest per file and the user decides.
+        let (remote, peer, far) = remote_and_peer().await;
+        remote.handler.lc.write().unwrap().version = hbb_common::get_version_number("1.5.0");
+        let mut d = Download { remote, peer, _far: far, dir: std::env::temp_dir(), id: 7005 };
+        d.dir = std::env::temp_dir().join(format!(
+            "rs_io_loop_skip_{}_{}",
+            std::process::id(),
+            hbb_common::rand::random::<u32>()
+        ));
+        std::fs::create_dir_all(&d.dir).unwrap();
+        for name in ["report", "ours"] {
+            std::fs::write(d.dir.join(name), b"dest").unwrap();
+            std::fs::write(d.dir.join(format!("{name}.download")), b"st").unwrap();
+        }
+        std::fs::write(d.dir.join("report.digest"), b"user notes").unwrap();
+        std::fs::write(d.dir.join("ours.digest"), r#"{"size":4,"modified":1600000000}"#).unwrap();
+        let ui = Data::SendFiles((
+            7005,
+            fs::JobType::Generic,
+            "/remote/dir".to_owned(),
+            d.dir.to_string_lossy().to_string(),
+            0,
+            false,
+            true,
+        ));
+        assert!(d.remote.handle_msg_from_ui(ui, &mut d.peer).await);
+        d.recv(file_response(|fr| {
+            fr.set_dir(FileDirectory {
+                id: 7005,
+                path: "/remote/dir".to_owned(),
+                entries: vec![entry("report", 4), entry("ours", 4)],
+                ..Default::default()
+            })
+        }))
+        .await;
+        for file_num in 0..2 {
+            d.recv(file_response(|fr| {
+                fr.set_digest(FileTransferDigest {
+                    id: 7005,
+                    file_num,
+                    file_size: 4,
+                    last_modified: 1_600_000_000,
+                    ..Default::default()
+                })
+            }))
+            .await;
+            // The existing destination asks the user; nothing is removed before the answer.
+            assert_eq!(d.names().len(), 6, "{:?}", d.names());
+            let skip = Data::SetConfirmOverrideFile((7005, file_num, false, false, false));
+            assert!(d.remote.handle_msg_from_ui(skip, &mut d.peer).await);
+        }
+        assert_eq!(d.names(), vec!["ours", "report", "report.digest", "report.download"]);
+    }
