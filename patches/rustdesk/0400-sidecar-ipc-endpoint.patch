+#[test]
+fn ledger_window() {
+    let boot = 1_000_000;
+    assert_eq!(ledger::qualifies(Some(boot), boot + 60, true), Some(60));
+    assert_eq!(ledger::qualifies(Some(boot), boot + 15 * 60, true), Some(900));
+    assert_eq!(ledger::qualifies(Some(boot), boot + 15 * 60 + 1, true), None);
+    assert_eq!(ledger::qualifies(Some(boot), boot + 60, false), None);
+    assert_eq!(ledger::qualifies(None, boot, true), None);
+    assert_eq!(ledger::qualifies(Some(boot), boot - 1, true), None);
+}
