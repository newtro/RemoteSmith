--- /dev/null
+++ b/src/remotesmith/host.rs
@@ -0,0 +1,97 @@
+//! Facts only the process hosting the RustDesk server knows. On macOS that is the same process
+//! as the endpoint; on Windows the SYSTEM `--server` answers `ipc::Data::RemoteSmithHost` with
+//! them and the user's `--tray` relays them to the sidecar.
+
+use super::protocol::PrebootStatus;
+use super::sessions::{self, ledger::Record, Inbound};
+use hbb_common::config::{self, Config};
+use serde_derive::{Deserialize, Serialize};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct HostFacts {
+    pub sessions: Vec<Inbound>,
+    /// hbb_common's online state: > 0 registered (latency ms), 0 connecting, < 0 failed.
+    pub online_state: i64,
+    pub rendezvous_servers: Vec<String>,
+    pub my_id: String,
+    pub key_fingerprint: Option<String>,
+    /// Only filled where the endpoint cannot compute it itself (Windows: BitLocker needs admin).
+    pub preboot: Option<PrebootStatus>,
+    pub cold_boot: Option<Record>,
+}
+
+impl HostFacts {
+    pub fn to_json(&self) -> String {
+        serde_json::to_string(self).unwrap_or_else(|_| "{}".into())
+    }
+
+    pub fn from_json(s: &str) -> Option<Self> {
+        serde_json::from_str(s).ok()
+    }
+}
+
+/// The host's public-key fingerprint in the format RustDesk shows it (`ipc` config
+/// "fingerprint"), once the key is confirmed by the rendezvous server.
+pub fn key_fingerprint() -> Option<String> {
+    if Config::get_key_confirmed() {
+        let pk = Config::get_key_pair().1;
+        if !pk.is_empty() {
+            return Some(crate::common::pk_to_fingerprint(pk));
+        }
+    }
+    None
+}
+
+/// Cached ledger read (the file changes at most once per boot).
+pub fn cold_boot_record() -> Option<Record> {
+    static CACHE: Mutex<Option<(Instant, Option<Record>)>> = Mutex::new(None);
+    let mut c = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((at, rec)) = c.as_ref() {
+        if at.elapsed() < Duration::from_secs(5) {
+            return rec.clone();
+        }
+    }
+    let rec = sessions::ledger::read();
+    *c = Some((Instant::now(), rec.clone()));
+    rec
+}
+
+pub fn local_facts() -> HostFacts {
+    HostFacts {
+        sessions: sessions::snapshot().0,
+        online_state: config::get_online_state(),
+        rendezvous_servers: Config::get_rendezvous_servers(),
+        my_id: Config::get_id_or(String::new()),
+        key_fingerprint: key_fingerprint(),
+        preboot: host_preboot(),
+        cold_boot: cold_boot_record(),
+    }
+}
+
+/// Windows: BitLocker state, refreshed by a background thread started on first use, so the IPC
+/// handler that calls this never waits on PowerShell.
+#[cfg(windows)]
+fn host_preboot() -> Option<PrebootStatus> {
+    use std::sync::OnceLock;
+    static CACHE: Mutex<Option<PrebootStatus>> = Mutex::new(None);
+    static STARTED: OnceLock<()> = OnceLock::new();
+    STARTED.get_or_init(|| {
+        std::thread::Builder::new()
+            .name("remotesmith-preboot".into())
+            .spawn(|| loop {
+                let p = super::readiness::preboot();
+                *CACHE.lock().unwrap_or_else(|e| e.into_inner()) = Some(p);
+                std::thread::sleep(Duration::from_secs(60));
+            })
+            .ok();
+    });
+    CACHE.lock().unwrap_or_else(|e| e.into_inner()).clone()
+}
+
+#[cfg(not(windows))]
+fn host_preboot() -> Option<PrebootStatus> {
+    None
+}
