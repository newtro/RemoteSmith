+            let r = c.recv().await;
+            assert_eq!(r["error"]["code"], "version_mismatch");
+            assert_eq!((r["error"]["min_version"].as_u64(), r["error"]["max_version"].as_u64()), (Some(1), Some(1)));
+            assert!(c.closed_within(Duration::from_secs(1)).await);
+        }
