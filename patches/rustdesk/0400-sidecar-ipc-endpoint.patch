+            assert!(
+                r["type"] == "connect_started"
+                    || r["error"]["code"] == "peer_unavailable",
+                "{r}"
+            );
+            assert!(h.table.lock().unwrap().get("333").map_or(true, |e| e.probed));
+        }
+
+        #[tokio::test]
+        async fn client_cap() {
+            let cfg = ServerConfig {
+                max_clients: 2,
+                ..test_cfg()
+            };
+            let h = start(cfg).await;
+            let mut a = Client::new(&h.path).await;
