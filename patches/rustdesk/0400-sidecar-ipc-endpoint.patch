+            r#"{"v":1,"type":"status","status":{"inbound_sessions":"none"}}"#,
+        ] {
+            assert!(decode::<ServerMessage>(bad.as_bytes()).is_err(), "{bad}");
+        }
+        for ok in [
+            r#"{"v":1,"type":"peers","peers":[]}"#,
+            r#"{"v":1,"type":"peers","peers":[5,{"id":"1"}]}"#,
+            r#"{"v":1,"type":"status","status":{"inbound_sessions":null}}"#,
+            r#"{"v":1,"type":"status","status":{}}"#,
+        ] {
+            assert!(decode::<ServerMessage>(ok.as_bytes()).is_ok(), "{ok}");
+        }
+    }
+
+    #[test]
+    fn decode_errors_never_carry_received_values() {
+        let line = br#"{"v":1,"id":2,"type":"connect","peer_id":{"password":"hunter2"}}"#;
+        let (e, _) = decode::<Request>(line).err().unwrap();
+        let d = e.describe(line.len());
+        assert!(!d.contains("hunter2") && !d.contains("password"), "{d}");
+        assert!(d.contains("unparseable JSON"));
+            }
+
+    #[test]
+    fn negotiation_rule() {
+        assert_eq!(negotiate(1, 1, 1, 1), Some(1));
+        assert_eq!(negotiate(1, 3, 2, 5), Some(3));
+        assert_eq!(negotiate(1, 1, 2, 3), None);
+        assert_eq!(negotiate(4, 5, 1, 3), None);
+        assert_eq!(negotiate(1, 2, 2, 2), Some(2));
+    }
+
+    #[tokio::test]
+    async fn bounded_reader_handles_oversize_and_eof() {
+        let mut data = Vec::new();
+        data.extend_from_slice(b"short\n");
+        data.extend(std::iter::repeat(b'x').take(50));
+        data.extend_from_slice(b"\nafter\npartial");
+        let mut r = tokio::io::BufReader::with_capacity(8, &data[..]);
+        assert_eq!(
+            read_line_bounded(&mut r, 20).await.unwrap(),
+            LineRead::Line(b"short".to_vec())
+        );
+        assert_eq!(
+            read_line_bounded(&mut r, 20).await.unwrap(),
+            LineRead::TooLong
+        );
+        assert_eq!(
+            read_line_bounded(&mut r, 20).await.unwrap(),
+            LineRead::Line(b"after".to_vec())
+        );
+        assert_eq!(read_line_bounded(&mut r, 20).await.unwrap(), LineRead::Eof);
+    }
+
+    #[tokio::test]
+    async fn bounded_reader_exact_boundary() {
+        // max=6: a 5-byte line fits (5 + newline = 6 bytes would be >= max? line len < max).
+        let data = b"12345\n123456\n".to_vec();
+        let mut r = tokio::io::BufReader::with_capacity(3, &data[..]);
+        assert_eq!(
+            read_line_bounded(&mut r, 6).await.unwrap(),
+            LineRead::Line(b"12345".to_vec())
+        );
+        assert_eq!(
+            read_line_bounded(&mut r, 6).await.unwrap(),
+            LineRead::TooLong
+        );
+    }
+}
diff --git a/src/remotesmith/readiness.rs b/src/remotesmith/readiness.rs
new file mode 100644
index 000000000000..65b1111c1a2e
--- /dev/null
+++ b/src/remotesmith/readiness.rs
@@ -0,0 +1,331 @@
+//! Readiness checks (§6.3, AC-55): each one only reads state; none changes a setting.
+//! All of them may block (subprocesses, TCC queries) and run on the collector's readiness thread.
+
+#[cfg(target_os = "macos")]
+use super::protocol::{Permission, PermState};
+use super::protocol::{PermissionStatus, PowerStatus, PrebootStatus, ServiceStatus};
+#[cfg(any(target_os = "macos", windows))]
+use std::process::Command;
+
+#[cfg(target_os = "macos")]
+fn granted(ok: bool) -> PermState {
+    if ok {
+        PermState::Granted
+    } else {
+        PermState::Missing
+    }
+}
+
+/// macOS TCC state of this process, with the same calls upstream uses for its own permission
+/// checks (`is_process_trusted`, `is_can_screen_recording`, `is_can_input_monitoring`), never
+/// prompting. Empty elsewhere.
+pub fn permissions() -> Vec<PermissionStatus> {
+    #[cfg(target_os = "macos")]
+    {
+        use crate::platform::macos;
+        let screen = macos::is_can_screen_recording(false);
+        let audio_detail = if cfg!(feature = "screencapturekit") {
+            "system audio is captured with ScreenCaptureKit, covered by the Screen & System Audio Recording grant"
+        } else {
+            "this build captures no system audio; reported with the Screen Recording grant"
+        };
+        return vec![
+            PermissionStatus {
+                name: Permission::Accessibility,
+                state: granted(macos::is_process_trusted(false)),
+                detail: None,
+            },
+            PermissionStatus {
+                name: Permission::ScreenRecording,
+                state: granted(screen),
+                detail: None,
+            },
+            PermissionStatus {
+                name: Permission::InputMonitoring,
+                state: granted(macos::is_can_input_monitoring(false)),
+                detail: None,
+            },
+            PermissionStatus {
+                name: Permission::SystemAudioRecording,
+                state: granted(screen),
+                detail: Some(audio_detail.into()),
+            },
+        ];
+    }
+    #[allow(unreachable_code)]
+    Vec::new()
+}
+
+/// Is the RemoteSmith service (macOS LaunchDaemon / Windows service) running?
+pub fn service() -> ServiceStatus {
+    #[cfg(target_os = "macos")]
+    {
+        let label = format!("{}_service", crate::get_full_name());
+        return match Command::new("/bin/launchctl").args(["print", "system"]).output() {
+            Ok(out) if out.status.success() => {
+                let text = String::from_utf8_lossy(&out.stdout);
+                match launchd_pid(&text, &label) {
+                    Some(pid) if pid > 0 => ServiceStatus {
+                        running: true,
+                        detail: None,
+                    },
+                    Some(_) => ServiceStatus {
+                        running: false,
+                        detail: Some(format!("{label} is loaded but not running")),
+                    },
+                    None => ServiceStatus {
+                        running: false,
+                        detail: Some(format!("{label} is not installed")),
+                    },
+                }
+            }
+            _ => ServiceStatus {
+                running: false,
+                detail: Some("could not query launchd".into()),
+            },
+        };
+    }
+    #[cfg(windows)]
+    {
+        let running = crate::platform::is_self_service_running();
+        return ServiceStatus {
+            running,
+            detail: (!running).then(|| format!("{} service is not running", crate::get_app_name())),
+        };
+    }
+    #[allow(unreachable_code)]
+    ServiceStatus::default()
+}
+
+/// The pid column of `label` in `launchctl print system`'s services table (0 = not running).
+pub fn launchd_pid(text: &str, label: &str) -> Option<i64> {
+    let mut in_services = false;
+    for line in text.lines() {
+        let t = line.trim();
+        if t.starts_with("services = {") {
+            in_services = true;
+            continue;
+        }
+        if in_services {
+            if t == "}" {
+                break;
+            }
+            let mut f = t.split_whitespace();
+            let pid = f.next();
+            let name = f.last();
+            if name == Some(label) {
+                return pid.and_then(|p| p.parse().ok());
+            }
+        }
+    }
+    None
+}
+
+/// Never sleeps on AC power?
+pub fn power() -> PowerStatus {
+    #[cfg(target_os = "macos")]
+    {
+        return match Command::new("/usr/bin/pmset").args(["-g", "custom"]).output() {
+            Ok(out) if out.status.success() => {
+                parse_pmset_ac_sleep(&String::from_utf8_lossy(&out.stdout))
+            }
+            _ => PowerStatus {
+                sleep_disabled: None,
+                detail: Some("could not run pmset".into()),
+            },
+        };
+    }
+    #[cfg(windows)]
+    {
+        let q = |setting: &str| -> Option<u64> {
+            let out = Command::new("powercfg")
+                .args(["/query", "SCHEME_CURRENT", "SUB_SLEEP", setting])
+                .creation_flags(CREATE_NO_WINDOW)
+                .output()
+                .ok()?;
+            if !out.status.success() {
+                return None;
+            }
+            parse_powercfg_ac(&String::from_utf8_lossy(&out.stdout))
+        };
+        return match (q("STANDBYIDLE"), q("HIBERNATEIDLE")) {
+            (Some(0), Some(0)) | (Some(0), None) => PowerStatus {
+                sleep_disabled: Some(true),
+                detail: None,
+            },
+            (Some(s), h) => PowerStatus {
+                sleep_disabled: Some(false),
+                detail: Some(match h {
+                    Some(h) if s == 0 => format!("on AC the PC hibernates after {} min", h / 60),
+                    Some(h) if h > 0 => format!(
+                        "on AC the PC sleeps after {} min and hibernates after {} min",
+                        s / 60,
+                        h / 60
+                    ),
+                    _ => format!("on AC the PC sleeps after {} min", s / 60),
+                }),
+            },
+            (None, _) => PowerStatus {
+                sleep_disabled: None,
+                detail: Some("could not read the power plan (powercfg)".into()),
+            },
+        };
+    }
+    #[allow(unreachable_code)]
+    PowerStatus::default()
+}
+
+#[cfg(windows)]
+use std::os::windows::process::CommandExt;
+#[cfg(windows)]
+const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+/// `pmset -g custom`: the `sleep` value of the "AC Power:" section (desktops list only that one).
+pub fn parse_pmset_ac_sleep(text: &str) -> PowerStatus {
+    let mut section = "";
+    for line in text.lines() {
+        if !line.starts_with(' ') && line.trim_end().ends_with(':') {
+            section = line.trim_end();
+            continue;
+        }
+        if section != "AC Power:" {
+            continue;
+        }
+        let mut f = line.split_whitespace();
+        if f.next() == Some("sleep") {
+            return match f.next().and_then(|v| v.parse::<u64>().ok()) {
+                Some(0) => PowerStatus {
+                    sleep_disabled: Some(true),
+                    detail: None,
+                },
+                Some(m) => PowerStatus {
+                    sleep_disabled: Some(false),
+                    detail: Some(format!("on AC power the Mac sleeps after {m} min idle")),
+                },
+                None => break,
+            };
+        }
+    }
+    PowerStatus {
+        sleep_disabled: None,
+        detail: Some("no AC sleep setting in pmset output".into()),
+    }
+}
+
+#[cfg_attr(not(windows), allow(dead_code))]
+/// `powercfg /query ... <setting>`: the AC value. The labels are localized, so take the
+/// second-to-last hex value of the output, which is always "Current AC Power Setting Index"
+/// (followed by the DC one).
+pub fn parse_powercfg_ac(text: &str) -> Option<u64> {
+    let vals: Vec<u64> = text
+        .lines()
+        .filter_map(|l| {
+            let i = l.rfind("0x")?;
+            let hex = l[i + 2..].trim();
+            (!hex.is_empty() && hex.len() <= 16)
+                .then(|| u64::from_str_radix(hex, 16).ok())
+                .flatten()
+        })
+        .collect();
+    (vals.len() >= 2).then(|| vals[vals.len() - 2])
+}
+
+/// Would a restart stop at a pre-boot unlock (ASM-1)? macOS: FileVault on (Apple silicon asks
+/// for the password before macOS and RustDesk start). Windows: a BitLocker OS-volume protector
+/// that needs a PIN, password or startup key.
+pub fn preboot() -> PrebootStatus {
+    #[cfg(target_os = "macos")]
+    {
+        return match Command::new("/usr/bin/fdesetup").arg("status").output() {
+            Ok(out) => parse_fdesetup(&String::from_utf8_lossy(&out.stdout)),
+            Err(_) => PrebootStatus {
+                detected: None,
+                detail: Some("could not run fdesetup".into()),
+            },
+        };
+    }
+    #[cfg(windows)]
+    {
+        // Get-BitLockerVolume needs admin: this runs in the SYSTEM server (host facts).
+        let script = "$ErrorActionPreference='Stop'; $v = Get-BitLockerVolume -MountPoint $env:SystemDrive; \
+                      \"status=$($v.ProtectionStatus)\"; $v.KeyProtector | ForEach-Object { \"protector=$($_.KeyProtectorType)\" }";
+        return match Command::new("powershell")
+            .args(["-NoProfile", "-NonInteractive", "-Command", script])
+            .creation_flags(CREATE_NO_WINDOW)
+            .output()
+        {
+            Ok(out) if out.status.success() => {
+                parse_bitlocker(&String::from_utf8_lossy(&out.stdout))
+            }
+            _ => PrebootStatus {
+                detected: None,
+                detail: Some("could not read BitLocker state (Get-BitLockerVolume)".into()),
+            },
+        };
+    }
+    #[allow(unreachable_code)]
+    PrebootStatus::default()
+}
+
+pub fn parse_fdesetup(text: &str) -> PrebootStatus {
+    if text.contains("FileVault is On") {
+        PrebootStatus {
+            detected: Some(true),
+            detail: Some(
+                "FileVault is on: after a restart the Mac waits for a password before RemoteSmith starts"
+                    .into(),
+            ),
+        }
+    } else if text.contains("FileVault is Off") {
+        PrebootStatus {
+            detected: Some(false),
+            detail: None,
+        }
+    } else {
+        PrebootStatus {
+            detected: None,
+            detail: Some("unrecognised fdesetup output".into()),
+        }
+    }
+}
+
+#[cfg_attr(not(windows), allow(dead_code))]
+/// Output of the PowerShell above: `status=On|Off` and one `protector=<KeyProtectorType>` per
+/// protector (enum names, not localized).
+pub fn parse_bitlocker(text: &str) -> PrebootStatus {
+    let mut status = None;
+    let mut blocking = Vec::new();
+    for line in text.lines().map(str::trim) {
+        if let Some(s) = line.strip_prefix("status=") {
+            status = Some(s.to_owned());
+        } else if let Some(p) = line.strip_prefix("protector=") {
+            if matches!(
+                p,
+                "TpmPin" | "TpmPinStartupKey" | "TpmStartupKey" | "Password" | "ExternalKey"
+            ) {
+                blocking.push(p.to_owned());
+            }
+        }
+    }
+    match status.as_deref() {
+        Some("Off") => PrebootStatus {
+            detected: Some(false),
+            detail: None,
+        },
+        Some("On") if blocking.is_empty() => PrebootStatus {
+            detected: Some(false),
+            detail: Some("BitLocker unlocks with the TPM alone".into()),
+        },
+        Some("On") => PrebootStatus {
+            detected: Some(true),
+            detail: Some(format!(
+                "BitLocker asks for {} before Windows starts",
+                blocking.join(" + ")
+            )),
+        },
+        _ => PrebootStatus {
+            detected: None,
+            detail: Some("unrecognised BitLocker state".into()),
+        },
+    }
+}
