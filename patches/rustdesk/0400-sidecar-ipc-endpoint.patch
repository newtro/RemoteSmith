+//! RemoteSmith additions to RustDesk.
+//!
+//! * The local IPC endpoint the RemoteSmith tray (`remotesmith-tray`) talks to: protocol v1 of
+//!   docs/IPC.md in the RemoteSmith repo (DEF-4, DEF-17). Patch range 0400.
+//! * Host-side session and readiness data: the inbound-session registry behind the tray badge
+//!   (§6.2a, AC-60) and the readiness checks including the cold-boot ledger (§6.3, AC-55).
+//!   Patch range 0500.
+//!
+//! Isolation (DEC-5, AC-25): the endpoint and its collectors run on threads of their own, with a
+//! tokio runtime of their own. Nothing RustDesk does waits on them; the only calls *into* this
+//! module from RustDesk code are the session hooks, which take one short mutex and return.
+
+pub mod host;
+pub mod protocol;
+pub mod sessions;
+
+#[cfg(any(target_os = "macos", windows))]
+mod collect;
+#[cfg(any(target_os = "macos", windows))]
+mod presence;
+#[cfg(any(target_os = "macos", windows))]
+mod readiness;
+#[cfg(windows)]
+mod relay;
+#[cfg(any(target_os = "macos", windows))]
+mod server;
+#[cfg(windows)]
+mod winsec;
+
+#[cfg(test)]
+mod tests;
+
+use hbb_common::log;
+
+/// Environment variable that replaces the whole endpoint path (socket path or pipe name), for
+/// tests and dev tools. The private-directory rules still apply to an overridden socket path.
+pub const ENV_IPC_PATH: &str = "REMOTESMITH_IPC_PATH";
+/// File name of the socket inside the fork's per-user IPC directory.
+pub const SOCKET_NAME: &str = "remotesmith-ipc.sock";
+
+/// Where the data for the endpoint comes from.
+#[cfg(any(target_os = "macos", windows))]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Source {
+    /// This process hosts the RustDesk server: sessions, registration and keys are local
+    /// (macOS per-user `--server`; a Windows portable/user-mode server).
+    Local,
+    /// Windows `--tray`: runs with the user's token and relays sessions, registration and
+    /// pre-boot state from the SYSTEM `--server` over RustDesk's own IPC.
+    #[cfg(windows)]
+    Relay,
+}
+
+/// Start the endpoint in a process that hosts the RustDesk server (`start_server(true, ..)`).
+///
+/// macOS: the per-user `--server`, or the UI process when it starts the server itself. A root
+/// process (the login-window `--server`) does not listen: no tray runs there, and the session
+/// hooks still record the cold-boot connection in that process.
+/// Windows: only a server running with a user's token (portable); the SYSTEM `--server` never
+/// creates the pipe (docs/IPC.md §2) - the `--tray` process does, through [`start_relay`].
+pub fn start_local() {
+    #[cfg(target_os = "macos")]
+    {
+        if crate::platform::is_root() {
+            log::info!("remotesmith ipc: not listening in a root process");
+            return;
+        }
+        spawn(Source::Local);
+    }
+    #[cfg(windows)]
+    {
+        if crate::platform::is_root() {
+            return;
+        }
+        spawn(Source::Local);
+    }
+}
+
+/// Start the relaying endpoint in the Windows `--tray` process (the user's own token).
+#[cfg(windows)]
+pub fn start_relay() {
+    if crate::platform::is_root() {
+        log::error!("remotesmith ipc: refusing to create the pipe from a SYSTEM process");
+        return;
+    }
+    spawn(Source::Relay);
+}
+
+/// Block while the endpoint started by this process is running. The Windows `--tray` process
+/// calls it after the tray UI returns (hidden tray, tray error), so the pipe outlives the icon.
+#[cfg(windows)]
+pub fn park() {
+    if let Some(h) = ENDPOINT.lock().unwrap().take() {
+        h.join().ok();
+    }
+}
+
+#[cfg(windows)]
+static ENDPOINT: std::sync::Mutex<Option<std::thread::JoinHandle<()>>> = std::sync::Mutex::new(None);
+
+#[cfg(any(target_os = "macos", windows))]
+fn spawn(source: Source) {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    static STARTED: AtomicBool = AtomicBool::new(false);
+    if STARTED.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    let endpoint = endpoint();
+    let spawned = std::thread::Builder::new()
+        .name("remotesmith-ipc".into())
+        .spawn(move || {
+            let rt = match hbb_common::tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+            {
+                Ok(rt) => rt,
+                Err(e) => {
+                    log::error!("remotesmith ipc: no runtime: {e}");
+                    return;
+                }
+            };
+            rt.block_on(async move {
+                match server::bind(&endpoint).await {
+                    Ok(listener) => {
+                        log::info!("remotesmith ipc: listening on {endpoint}");
+                        // Collectors only run while someone can be served.
+                        let shared = collect::start(source);
+                        server::serve(listener, server::ServerConfig::default(), shared).await;
+                    }
+                    Err(e) => log::error!("remotesmith ipc: cannot listen on {endpoint}: {e}"),
+                }
+            });
+        });
+    match spawned {
+        Ok(_h) => {
+            #[cfg(windows)]
+            {
+                *ENDPOINT.lock().unwrap() = Some(_h);
+            }
+        }
+        // thread::Builder::spawn fails (EAGAIN) rather than panicking; the fork carries on.
+        Err(e) => log::error!("remotesmith ipc: cannot start thread: {e}"),
+    }
+}
+
+/// The endpoint for the current user (docs/IPC.md §2).
+#[cfg(any(target_os = "macos", windows))]
+pub(crate) fn endpoint() -> String {
+    if let Ok(p) = std::env::var(ENV_IPC_PATH) {
+        if !p.is_empty() {
+            return p;
+        }
+    }
+    platform_endpoint()
+}
+
+/// `<the fork's per-user IPC dir>/remotesmith-ipc.sock`, i.e. `/tmp/<AppName>-<uid>/...`: the
+/// same 0700 directory hbb_common creates for RustDesk's own IPC socket.
+#[cfg(target_os = "macos")]
+fn platform_endpoint() -> String {
+    let main = hbb_common::config::Config::ipc_path("");
+    match std::path::Path::new(&main).parent() {
+        Some(dir) => dir.join(SOCKET_NAME).to_string_lossy().into_owned(),
+        None => format!("/tmp/{}-{}/{SOCKET_NAME}", crate::get_app_name(), unsafe {
+            hbb_common::libc::geteuid()
+        }),
+    }
+}
+
+/// `\\.\pipe\<AppName>-ipc-<username>`.
+#[cfg(windows)]
+fn platform_endpoint() -> String {
+    let user = std::env::var("USERNAME").unwrap_or_else(|_| "unknown".into());
+    let user: String = user.chars().filter(|c| *c != '\\' && *c != '/').collect();
+    format!(r"\\.\pipe\{}-ipc-{user}", crate::get_app_name())
+}
+
+/// Answer to `ipc::Data::RemoteSmithHost(None)` on RustDesk's main IPC: the host facts that only
+/// the process hosting the server knows (sessions, registration, keys, pre-boot unlock). The
+/// Windows `--tray` relays them; it is cheap (cached values only) and never blocks the caller.
+pub fn host_facts_json() -> String {
+    host::local_facts().to_json()
+}
diff --git a/src/remotesmith/presence.rs b/src/remotesmith/presence.rs
new file mode 100644
index 000000000000..c0f46b3773c1
--- /dev/null
+++ b/src/remotesmith/presence.rs
@@ -0,0 +1,180 @@
+//! Peer presence (DEF-17, §6.2): LAN discovery (upstream `lan::discover`) and the rendezvous
+//! server's online-state query (upstream `peer_online::query_online_states`), combined into the
+//! IPC's `checking` / `reachable{route}` / `unavailable{reason, last_seen}`.
+
+use super::protocol::{Presence, Reason, Route};
+use super::sessions::now_secs;
+use hbb_common::{config::LanPeers, log, tokio};
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+/// Full probe interval (LAN broadcast + server query).
+pub const PROBE_INTERVAL: Duration = Duration::from_secs(15);
+const QUERY_TIMEOUT: Duration = Duration::from_secs(5);
+
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Entry {
+    /// Answered the last LAN discovery round.
+    pub lan: bool,
+    /// The rendezvous server's answer; `None` when it could not be asked (not registered,
+    /// unreachable) or has not been asked yet.
+    pub id_online: Option<bool>,
+    /// A probe has completed for this peer.
+    pub probed: bool,
+    /// Last time the peer was reachable by any route (Unix seconds).
+    pub last_seen: Option<u64>,
+}
+
+pub type Table = Arc<Mutex<HashMap<String, Entry>>>;
+
+/// Pure mapping from probe results to the wire presence.
+pub fn presence_of(e: &Entry, registered: bool) -> Presence {
+    if e.lan {
+        return Presence::Reachable { route: Route::Lan };
+    }
+    if e.id_online == Some(true) {
+        return Presence::Reachable { route: Route::Id };
+    }
+    if !e.probed {
+        return Presence::Checking;
+    }
+    if e.id_online.is_none() || !registered {
+        return Presence::Unavailable {
+            reason: Reason::ServerUnreachable,
+            detail: Some("not on the LAN, and the ID server cannot be asked".into()),
+            last_seen: e.last_seen,
+        };
+    }
+    Presence::Unavailable {
+        reason: Reason::Offline,
+        detail: None,
+        last_seen: e.last_seen,
+    }
+}
+
+fn apply(table: &Table, ids: &[String], lan: &HashSet<String>, online: Option<&HashSet<String>>) {
+    let now = now_secs();
+    let mut t = table.lock().unwrap_or_else(|e| e.into_inner());
+    t.retain(|k, _| ids.contains(k));
+    for id in ids {
+        let e = t.entry(id.clone()).or_default();
+        e.lan = lan.contains(id);
+        e.id_online = online.map(|o| o.contains(id));
+        e.probed = true;
+        if e.lan || e.id_online == Some(true) {
+            e.last_seen = Some(now);
+        }
+    }
+}
+
+/// Seed `last_seen` from the time RustDesk last saved the peer (its last session), so a peer
+/// never seen online since startup still shows a meaningful "last seen".
+pub fn seed_last_seen(table: &Table, id: &str, saved_at: Option<u64>) {
+    let mut t = table.lock().unwrap_or_else(|e| e.into_inner());
+    let e = t.entry(id.to_owned()).or_default();
+    if e.last_seen.is_none() {
+        e.last_seen = saved_at;
+    }
+}
+
+/// Ask the rendezvous server which of `ids` are online. `None` when the query fails.
+pub async fn query_server(ids: Vec<String>) -> Option<HashSet<String>> {
+    if ids.is_empty() {
+        return Some(HashSet::new());
+    }
+    let result: Arc<Mutex<Option<HashSet<String>>>> = Default::default();
+    let r = result.clone();
+    let q = crate::client::peer_online::query_online_states(ids, move |onlines, _offlines| {
+        *r.lock().unwrap_or_else(|e| e.into_inner()) = Some(onlines.into_iter().collect());
+    });
+    if tokio::time::timeout(QUERY_TIMEOUT, q).await.is_err() {
+        return None;
+    }
+    let out = result.lock().unwrap_or_else(|e| e.into_inner()).take();
+    out
+}
+
+/// LAN peers that answered the most recent discovery round.
+fn lan_online() -> HashSet<String> {
+    LanPeers::load()
+        .peers
+        .into_iter()
+        .filter(|p| p.online)
+        .map(|p| p.id)
+        .collect()
+}
+
+/// Probe forever on the calling thread (which must not be inside a tokio runtime: upstream's
+/// `lan::discover` starts its own). `ids` lists the enrolled peers; `registered` says whether
+/// this host is registered with the rendezvous server (an offline answer is only trusted then).
+pub fn run(
+    table: Table,
+    ids: impl Fn() -> Vec<String>,
+    registered: impl Fn() -> bool,
+    changed: impl Fn(),
+) {
+    let rt = match tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+    {
+        Ok(rt) => rt,
+        Err(e) => {
+            log::error!("remotesmith presence: no runtime: {e}");
+            return;
+        }
+    };
+    let mut last_ids: Vec<String> = Vec::new();
+    let mut last_probe: Option<Instant> = None;
+    loop {
+        let cur = ids();
+        let due = last_probe.map_or(true, |t| t.elapsed() >= PROBE_INTERVAL);
+        if !(due || cur != last_ids) || cur.is_empty() {
+            if cur.is_empty() && cur != last_ids {
+                apply(&table, &cur, &HashSet::new(), None);
+                last_ids = cur;
+                changed();
+            }
+            std::thread::sleep(Duration::from_secs(1));
+            continue;
+        }
+        last_probe = Some(Instant::now());
+        if let Err(e) = crate::lan::discover() {
+            log::debug!("remotesmith presence: LAN discovery failed: {e}");
+        }
+        let lan = lan_online();
+        let online = if registered() {
+            rt.block_on(query_server(cur.clone()))
+        } else {
+            None
+        };
+        let before = table.lock().unwrap_or_else(|e| e.into_inner()).clone();
+        apply(&table, &cur, &lan, online.as_ref());
+        let after = table.lock().unwrap_or_else(|e| e.into_inner()).clone();
+        last_ids = cur;
+        if before != after {
+            changed();
+        }
+    }
+}
+
+/// Fresh check of one peer for `connect` (the table may be up to [`PROBE_INTERVAL`] old):
+/// re-reads the LAN results and asks the server again, then updates the table.
+pub async fn probe_now(table: &Table, id: &str, registered: bool) -> Entry {
+    let lan = lan_online();
+    let online = if registered {
+        query_server(vec![id.to_owned()]).await
+    } else {
+        None
+    };
+    let now = now_secs();
+    let mut t = table.lock().unwrap_or_else(|e| e.into_inner());
+    let e = t.entry(id.to_owned()).or_default();
+    e.lan = lan.contains(id);
+    e.id_online = online.map(|o| o.contains(id));
+    e.probed = true;
+    if e.lan || e.id_online == Some(true) {
+        e.last_seen = Some(now);
+    }
+    e.clone()
+}
diff --git a/src/remotesmith/protocol.rs b/src/remotesmith/protocol.rs
new file mode 100644
index 000000000000..e07dc0e7b6c2
--- /dev/null
+++ b/src/remotesmith/protocol.rs
@@ -0,0 +1,1026 @@
+//! RemoteSmith fork <-> sidecar IPC protocol v1 (docs/IPC.md in the RemoteSmith repo).
+//!
+//! A verbatim port of the sidecar's normative serde definitions (`sidecar/src/protocol.rs`), so
+//! both ends decode the same JSON the same way. Keep the two in sync; the shared fixture
+//! `docs/ipc-fixtures/v1.jsonl` is decoded by the tests of both.
+
+use hbb_common::tokio;
+use serde::{Deserialize, Serialize};
+
+/// Protocol version this build speaks natively.
+pub const PROTOCOL_VERSION: u32 = 1;
+/// Lowest protocol version this sidecar accepts.
+pub const MIN_VERSION: u32 = 1;
+/// Highest protocol version this sidecar accepts.
+pub const MAX_VERSION: u32 = 1;
+/// Maximum line length including the trailing newline (docs/IPC.md §3).
+pub const MAX_LINE: usize = 1024 * 1024;
+
+/// Wire envelope: `{"v":1,"id":7,"type":"...", ...body fields}`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Envelope<T> {
+    pub v: u32,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub id: Option<u64>,
+    #[serde(flatten)]
+    pub body: T,
+}
+
+impl<T> Envelope<T> {
+    pub fn new(v: u32, id: Option<u64>, body: T) -> Self {
+        Self { v, id, body }
+    }
+}
+
+/// Client -> server requests.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum Request {
+    Hello {
+        min_version: u32,
+        max_version: u32,
+        client: String,
+        client_version: String,
+    },
+    GetStatus,
+    ListPeers,
+    Connect {
+        peer_id: String,
+    },
+    Subscribe {
+        topics: Vec<Topic>,
+    },
+    Ping,
+    /// Any request type this build does not know.
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Topic {
+    Status,
+    Peers,
+    #[serde(other)]
+    Unknown,
+}
+
+/// Server -> client messages (responses carry `id`, pushed events do not).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum ServerMessage {
+    HelloOk {
+        version: u32,
+        min_version: u32,
+        max_version: u32,
+        #[serde(default, deserialize_with = "lenient")]
+        server: String,
+        #[serde(default, deserialize_with = "lenient")]
+        server_version: String,
+    },
+    Status {
+        status: Box<Status>,
+    },
+    Peers {
+        #[serde(deserialize_with = "peers_array")]
+        peers: Vec<Peer>,
+    },
+    ConnectStarted {
+        peer_id: String,
+    },
+    ConnectResult {
+        peer_id: String,
+        ok: bool,
+        #[serde(
+            default,
+            deserialize_with = "lenient",
+            skip_serializing_if = "Option::is_none"
+        )]
+        reason: Option<Reason>,
+        #[serde(
+            default,
+            deserialize_with = "lenient",
+            skip_serializing_if = "Option::is_none"
+        )]
+        detail: Option<String>,
+    },
+    Subscribed {
+        #[serde(default, deserialize_with = "lenient_vec")]
+        topics: Vec<Topic>,
+    },
+    Pong,
+    Error {
+        error: ErrorBody,
+    },
+    /// Any message type this build does not know; clients ignore it.
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ErrorBody {
+    pub code: ErrorCode,
+    #[serde(default, deserialize_with = "lenient")]
+    pub message: String,
+    /// Only on `version_mismatch`: the server's supported range.
+    #[serde(
+        default,
+        deserialize_with = "lenient",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub min_version: Option<u32>,
+    #[serde(
+        default,
+        deserialize_with = "lenient",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub max_version: Option<u32>,
+}
+
+impl ErrorBody {
+    pub fn new(code: ErrorCode, message: impl Into<String>) -> Self {
+        Self {
+            code,
+            message: message.into(),
+            min_version: None,
+            max_version: None,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ErrorCode {
+    VersionMismatch,
+    HelloRequired,
+    BadRequest,
+    LineTooLong,
+    UnknownType,
+    PeerUnknown,
+    PeerUnavailable,
+    Busy,
+    Internal,
+    #[serde(untagged)]
+    Other(String),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum Platform {
+    Macos,
+    Windows,
+    #[default]
+    #[serde(other)]
+    Other,
+}
+
+/// The fork's status snapshot (docs/IPC.md §7).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct Status {
+    #[serde(deserialize_with = "lenient")]
+    pub app_version: String,
+    #[serde(deserialize_with = "lenient")]
+    pub platform: Platform,
+    #[serde(deserialize_with = "lenient")]
+    pub my_id: Option<String>,
+    #[serde(deserialize_with = "lenient")]
+    pub key_fingerprint: Option<String>,
+    #[serde(deserialize_with = "lenient")]
+    pub service: ServiceStatus,
+    #[serde(deserialize_with = "lenient_vec")]
+    pub permissions: Vec<PermissionStatus>,
+    #[serde(deserialize_with = "lenient")]
+    pub power: PowerStatus,
+    #[serde(deserialize_with = "lenient")]
+    pub preboot_unlock: PrebootStatus,
+    #[serde(deserialize_with = "lenient")]
+    pub server: ServerStatus,
+    #[serde(deserialize_with = "lenient")]
+    pub unattended: UnattendedStatus,
+    #[serde(deserialize_with = "sessions_array")]
+    pub inbound_sessions: Vec<InboundSession>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct ServiceStatus {
+    #[serde(deserialize_with = "lenient")]
+    pub running: bool,
+    #[serde(deserialize_with = "lenient")]
+    pub detail: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct PermissionStatus {
+    pub name: Permission,
+    #[serde(default, deserialize_with = "lenient")]
+    pub state: PermState,
+    #[serde(
+        default,
+        deserialize_with = "lenient",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub detail: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Permission {
+    Accessibility,
+    ScreenRecording,
+    InputMonitoring,
+    SystemAudioRecording,
+    #[serde(untagged)]
+    Other(String),
+}
+
+impl Permission {
+    pub fn display_name(&self) -> String {
+        match self {
+            Permission::Accessibility => "Accessibility".into(),
+            Permission::ScreenRecording => "Screen Recording".into(),
+            Permission::InputMonitoring => "Input Monitoring".into(),
+            Permission::SystemAudioRecording => "Screen & System Audio Recording".into(),
+            Permission::Other(s) => s.clone(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum PermState {
+    Granted,
+    Missing,
+    #[default]
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct PowerStatus {
+    #[serde(deserialize_with = "lenient")]
+    pub sleep_disabled: Option<bool>,
+    #[serde(deserialize_with = "lenient")]
+    pub detail: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct PrebootStatus {
+    #[serde(deserialize_with = "lenient")]
+    pub detected: Option<bool>,
+    #[serde(deserialize_with = "lenient")]
+    pub detail: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct ServerStatus {
+    #[serde(deserialize_with = "lenient")]
+    pub state: RegState,
+    #[serde(deserialize_with = "lenient")]
+    pub host: Option<String>,
+    #[serde(deserialize_with = "lenient")]
+    pub detail: Option<String>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum RegState {
+    Registered,
+    Registering,
+    NotConfigured,
+    Failed,
+    #[default]
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Default)]
+#[serde(default)]
+pub struct UnattendedStatus {
+    #[serde(deserialize_with = "lenient")]
+    pub ready: bool,
+    #[serde(deserialize_with = "lenient")]
+    pub cold_boot_verified_at: Option<u64>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct InboundSession {
+    #[serde(default, deserialize_with = "lenient")]
+    pub conn_id: u64,
+    #[serde(default, deserialize_with = "lenient")]
+    pub peer_id: String,
+    #[serde(default, deserialize_with = "lenient")]
+    pub alias: Option<String>,
+    #[serde(default, deserialize_with = "lenient")]
+    pub kind: SessionKind,
+    #[serde(default, deserialize_with = "lenient")]
+    pub since: Option<u64>,
+}
+
