@@ -0,0 +1,367 @@
+//! Builds the endpoint's snapshot (Status + Peers, docs/IPC.md §7-8) on threads of its own and
+//! publishes it through a `watch` channel; the server only ever reads the latest snapshot.
+//!
+//! Threads: `remotesmith-collect` (snapshot, woken by session changes within milliseconds and
+//! every second otherwise), `remotesmith-ready` (TCC every 5 s; launchd/pmset/fdesetup or the
+//! Windows equivalents every 30 s), `remotesmith-presence` (presence.rs) and, on the Windows
+//! tray, `remotesmith-relay` (relay.rs).
+
+use super::host::{self, HostFacts};
+use super::presence::{self, Table};
+use super::protocol::*;
+use super::readiness;
+use super::sessions;
+use super::Source;
+use hbb_common::config::PeerConfig;
+use hbb_common::log;
+use hbb_common::tokio::sync::watch;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant, UNIX_EPOCH};
+
+/// Everything the endpoint serves.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Snapshot {
+    pub status: Status,
+    pub peers: Vec<Peer>,
+}
+
+/// Handed to the server.
+#[derive(Clone)]
+pub struct Shared {
+    pub snap: watch::Receiver<Snapshot>,
+    pub presence: Table,
+}
+
+impl Shared {
+    /// Is this host registered with the rendezvous server right now?
+    pub fn registered(&self) -> bool {
+        self.snap.borrow().status.server.state == RegState::Registered
+    }
+}
+
+/// A saved peer, as read from RustDesk's peer configs.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SavedPeer {
+    pub id: String,
+    pub alias: Option<String>,
+    pub platform: Option<Platform>,
+    pub saved_at: Option<u64>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Readiness {
+    pub service: ServiceStatus,
+    pub permissions: Vec<PermissionStatus>,
+    pub power: PowerStatus,
+    pub preboot: PrebootStatus,
+}
+
+const MAX_TEXT: usize = 256;
+
+fn clamp(s: &str) -> String {
+    if s.chars().count() <= MAX_TEXT {
+        s.to_owned()
+    } else {
+        s.chars().take(MAX_TEXT).collect()
+    }
+}
+
+fn non_empty(s: &str) -> Option<String> {
+    let t = s.trim();
+    (!t.is_empty()).then(|| clamp(t))
+}
+
+pub fn platform_of(s: &str) -> Option<Platform> {
+    let l = s.to_ascii_lowercase();
+    if l.is_empty() {
+        None
+    } else if l.contains("windows") {
+        Some(Platform::Windows)
+    } else if l.contains("mac") || l.contains("darwin") {
+        Some(Platform::Macos)
+    } else {
+        Some(Platform::Other)
+    }
+}
+
+/// RustDesk's saved peers (the "recent" list: every machine this one has connected to).
+fn load_saved_peers() -> Vec<SavedPeer> {
+    PeerConfig::peers(None)
+        .into_iter()
+        .map(|(id, modified, cfg)| SavedPeer {
+            alias: cfg
+                .options
+                .get("alias")
+                .and_then(|a| non_empty(a))
+                .or_else(|| non_empty(&cfg.info.hostname)),
+            platform: platform_of(&cfg.info.platform),
+            saved_at: modified.duration_since(UNIX_EPOCH).ok().map(|d| d.as_secs()),
+            id,
+        })
+        .collect()
+}
+
+/// The `server` field from the configured rendezvous servers and hbb_common's online state.
+pub fn server_status(servers: &[String], online_state: i64) -> ServerStatus {
+    let host = servers
+        .iter()
+        .map(|s| s.trim())
+        .find(|s| !s.is_empty())
+        .map(|s| {
+            // host:port or [v6]:port -> host
+            let h = if let Some(rest) = s.strip_prefix('[') {
+                rest.split(']').next().unwrap_or(rest)
+            } else {
+                s.rsplit_once(':')
+                    .filter(|(_, p)| p.chars().all(|c| c.is_ascii_digit()))
+                    .map_or(s, |(h, _)| h)
+            };
+            clamp(h)
+        });
+    let Some(host) = host else {
+        return ServerStatus {
+            state: RegState::NotConfigured,
+            host: None,
+            detail: Some("no ID server configured".into()),
+        };
+    };
+    let (state, detail) = match online_state {
+        x if x > 0 => (RegState::Registered, None),
+        0 => (RegState::Registering, Some("connecting to the ID server".into())),
+        _ => (RegState::Failed, Some("cannot reach the ID server".into())),
+    };
+    ServerStatus {
+        state,
+        host: Some(host),
+        detail,
+    }
+}
+
+/// The fork's "Unattended ready" flag (docs/IPC.md §7): a recorded cold-boot login-screen
+/// connection, and every prerequisite passing now. The sidecar re-derives the same checks.
+pub fn unattended_ready(s: &Status) -> bool {
+    let perms_ok = match s.platform {
+        Platform::Macos => [
+            Permission::Accessibility,
+            Permission::ScreenRecording,
+            Permission::InputMonitoring,
+            Permission::SystemAudioRecording,
+        ]
+        .iter()
+        .all(|n| {
+            s.permissions
+                .iter()
+                .any(|p| &p.name == n && p.state == PermState::Granted)
+        }),
+        Platform::Windows => true,
+        Platform::Other => false,
+    };
+    s.unattended.cold_boot_verified_at.is_some()
+        && s.service.running
+        && perms_ok
+        && s.power.sleep_disabled == Some(true)
+        && s.preboot_unlock.detected == Some(false)
+        && s.server.state == RegState::Registered
+}
+
+fn this_platform() -> Platform {
+    if cfg!(target_os = "macos") {
+        Platform::Macos
+    } else if cfg!(windows) {
+        Platform::Windows
+    } else {
+        Platform::Other
+    }
+}
+
+/// Assemble the snapshot. `facts` is `None` when the Windows relay cannot reach the service.
+pub fn build(
+    facts: Option<&HostFacts>,
+    ready: &Readiness,
+    saved: &[SavedPeer],
+    presence: &Table,
+) -> Snapshot {
+    let my_id = facts.map(|f| f.my_id.clone()).filter(|s| !s.is_empty());
+    let alias_of = |id: &str| saved.iter().find(|p| p.id == id).and_then(|p| p.alias.clone());
+    let mut status = Status {
+        app_version: crate::VERSION.to_owned(),
+        platform: this_platform(),
+        my_id: my_id.clone(),
+        key_fingerprint: facts.and_then(|f| f.key_fingerprint.clone()),
+        service: ready.service.clone(),
+        permissions: ready.permissions.clone(),
+        power: ready.power.clone(),
+        preboot_unlock: facts
+            .and_then(|f| f.preboot.clone())
+            .unwrap_or_else(|| ready.preboot.clone()),
+        server: match facts {
+            Some(f) => server_status(&f.rendezvous_servers, f.online_state),
+            None => ServerStatus {
+                state: RegState::Unknown,
+                host: None,
+                detail: Some("the RemoteSmith service is not answering".into()),
+            },
+        },
+        unattended: UnattendedStatus {
+            ready: false,
+            cold_boot_verified_at: facts
+                .and_then(|f| f.cold_boot.as_ref())
+                .map(|r| r.verified_at),
+        },
+        inbound_sessions: facts
+            .map(|f| {
+                f.sessions
+                    .iter()
+                    .map(|s| InboundSession {
+                        conn_id: s.conn_id.max(0) as u64,
+                        peer_id: clamp(&s.peer_id),
+                        alias: alias_of(&s.peer_id).or_else(|| non_empty(&s.name)),
+                        kind: SessionKind::Human,
+                        since: Some(s.since),
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+    };
+    status.unattended.ready = unattended_ready(&status);
+    let registered = status.server.state == RegState::Registered;
+    let table = presence.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    let peers = saved
+        .iter()
+        .filter(|p| Some(&p.id) != my_id.as_ref())
+        .map(|p| Peer {
+            id: p.id.clone(),
+            alias: p.alias.clone(),
+            platform: p.platform,
+            presence: table
+                .get(&p.id)
+                .map(|e| presence::presence_of(e, registered))
+                .unwrap_or(Presence::Checking),
+        })
+        .collect();
+    Snapshot { status, peers }
+}
+
+fn spawn(name: &str, f: impl FnOnce() + Send + 'static) {
+    if let Err(e) = std::thread::Builder::new().name(name.into()).spawn(f) {
+        log::error!("remotesmith: cannot start {name}: {e}");
+    }
+}
+
+/// Start the collector threads and return what the server needs.
+pub fn start(source: Source) -> Shared {
+    let (tx, rx) = watch::channel(Snapshot::default());
+    let table: Table = Default::default();
+    let saved: Arc<Mutex<Vec<SavedPeer>>> = Default::default();
+    let ready: Arc<Mutex<Readiness>> = Default::default();
+
+    #[cfg(windows)]
+    let relay = match source {
+        Source::Relay => Some(super::relay::start()),
+        Source::Local => None,
+    };
+
+    // Readiness.
+    {
+        let ready = ready.clone();
+        spawn("remotesmith-ready", move || {
+            let mut slow_at: Option<Instant> = None;
+            loop {
+                let mut r = ready.lock().unwrap_or_else(|e| e.into_inner()).clone();
+                r.permissions = readiness::permissions();
+                if slow_at.map_or(true, |t| t.elapsed() >= Duration::from_secs(30)) {
+                    slow_at = Some(Instant::now());
+                    r.service = readiness::service();
+                    r.power = readiness::power();
+                    // Windows: BitLocker needs admin, so the relayed host facts carry it and
+                    // this local value is only the fallback.
+                    if cfg!(not(windows)) || source == Source::Local {
+                        r.preboot = readiness::preboot();
+                    }
+                }
+                let changed = {
+                    let mut cur = ready.lock().unwrap_or_else(|e| e.into_inner());
+                    let changed = *cur != r;
+                    *cur = r;
+                    changed
+                };
+                if changed {
+                    sessions::poke();
+                }
+                std::thread::sleep(Duration::from_secs(5));
+            }
+        });
+    }
+
+    // Presence.
+    {
+        let table = table.clone();
+        let saved = saved.clone();
+        let rx = rx.clone();
+        spawn("remotesmith-presence", move || {
+            presence::run(
+                table,
+                || {
+                    let my_id = rx.borrow().status.my_id.clone();
+                    saved
+                        .lock()
+                        .unwrap_or_else(|e| e.into_inner())
+                        .iter()
+                        .filter(|p| Some(&p.id) != my_id.as_ref())
+                        .map(|p| p.id.clone())
+                        .collect()
+                },
+                || rx.borrow().status.server.state == RegState::Registered,
+                sessions::poke,
+            )
+        });
+    }
+
+    // Snapshot.
+    {
+        let table = table.clone();
+        spawn("remotesmith-collect", move || {
+            let mut gen = 0u64;
+            let mut peers_at: Option<Instant> = None;
+            loop {
+                if peers_at.map_or(true, |t| t.elapsed() >= Duration::from_secs(5)) {
+                    peers_at = Some(Instant::now());
+                    let list = load_saved_peers();
+                    for p in &list {
+                        presence::seed_last_seen(&table, &p.id, p.saved_at);
+                    }
+                    let mut cur = saved.lock().unwrap_or_else(|e| e.into_inner());
+                    if *cur != list {
+                        *cur = list;
+                    }
+                }
+                let facts = match source {
+                    Source::Local => Some(host::local_facts()),
+                    #[cfg(windows)]
+                    Source::Relay => relay.as_ref().and_then(|r| r.facts()),
+                };
+                let snap = {
+                    let r = ready.lock().unwrap_or_else(|e| e.into_inner());
+                    let s = saved.lock().unwrap_or_else(|e| e.into_inner());
+                    build(facts.as_ref(), &r, &s, &table)
+                };
+                tx.send_if_modified(|cur| {
+                    if *cur != snap {
+                        *cur = snap;
+                        true
+                    } else {
+                        false
+                    }
+                });
+                // Wake on any session change (opened/closed hooks, relay updates, pokes) within
+                // milliseconds, and at least once a second.
+                gen = sessions::wait_change(gen, Duration::from_secs(1));
+            }
+        });
+    }
+
+    Shared {
+        snap: rx,
+        presence: table,
+    }
+}
