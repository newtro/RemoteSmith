+            assert_eq!(d.hello().await["type"], "hello_ok", "slot freed");
+        }
+
+        #[tokio::test]
+        async fn a_client_that_stops_reading_blocks_nobody() {
+            let h = start(test_cfg()).await;
+            let mut slow = Client::new(&h.path).await;
+            slow.hello().await;
+            slow.send(r#"{"v":1,"id":2,"type":"subscribe","topics":["peers"]}"#).await;
+            // Big peer lists, many changes, never read.
+            for i in 0..200u32 {
+                h.tx.send_modify(|s| {
+                    s.peers = (0..2000)
+                        .map(|j| Peer {
+                            id: format!("{i}-{j}"),
+                            alias: Some("a".repeat(100)),
+                            platform: None,
+                            presence: Presence::Checking,
+                        })
+                        .collect()
+                });
+                tokio::time::sleep(Duration::from_millis(2)).await;
+            }
+            let mut fast = Client::new(&h.path).await;
+            let t = std::time::Instant::now();
+            assert_eq!(fast.hello().await["type"], "hello_ok");
+            fast.send(r#"{"v":1,"id":2,"type":"ping"}"#).await;
+            assert_eq!(fast.recv().await["type"], "pong");
+            assert!(t.elapsed() < Duration::from_secs(1), "{:?}", t.elapsed());
+            // The stuck one is dropped by the write timeout.
+            tokio::time::sleep(Duration::from_millis(500)).await;
+            assert!(slow.closed_within(Duration::from_secs(3)).await);
+        }
+
+        #[tokio::test]
+        async fn bind_rules() {
+            // Refuses a directory other users can enter.
+            let d = private_dir();
+            std::fs::set_permissions(&d.0, std::fs::Permissions::from_mode(0o755)).unwrap();
+            let p = d.0.join("s.sock").to_string_lossy().into_owned();
+            assert!(server::bind(&p).await.is_err());
+            // Refuses a symlinked directory.
+            let real = private_dir();
+            let link = std::path::PathBuf::from(format!("{}-link", real.0.display()));
+            std::os::unix::fs::symlink(&real.0, &link).unwrap();
+            let lp = link.join("s.sock").to_string_lossy().into_owned();
+            let r = server::bind(&lp).await;
+            std::fs::remove_file(&link).ok();
+            assert!(r.is_err());
+            // Creates a missing directory 0700, socket 0600.
+            let parent = private_dir();
+            let sub = parent.0.join("sub");
+            let sp = sub.join("s.sock").to_string_lossy().into_owned();
+            let l = server::bind(&sp).await.unwrap();
+            use std::os::unix::fs::MetadataExt;
+            assert_eq!(std::fs::metadata(&sub).unwrap().mode() & 0o777, 0o700);
+            assert_eq!(std::fs::symlink_metadata(&sp).unwrap().mode() & 0o777, 0o600);
+            // Never steals a live socket.
+            assert_eq!(server::bind(&sp).await.err().map(|e| e.kind()), Some(std::io::ErrorKind::AddrInUse));
+            // Drop unlinks our own socket only.
+            drop(l);
+            assert!(std::fs::symlink_metadata(&sp).is_err());
+            // Replaces a stale socket of ours.
+            let stale = std::os::unix::net::UnixListener::bind(&sp).unwrap();
+            drop(stale); // file stays, nobody listening
+            assert!(std::fs::symlink_metadata(&sp).is_ok());
+            let l2 = server::bind(&sp).await.unwrap();
+            drop(l2);
+        }
+    }
