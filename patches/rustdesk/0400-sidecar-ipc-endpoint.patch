+    #[test]
+    fn peer_ids_safe_for_the_command_line() {
+        assert!(server::valid_peer_id("123456789"));
+        assert!(server::valid_peer_id("my-host_1"));
+        assert!(!server::valid_peer_id(""));
+        assert!(!server::valid_peer_id("--password"));
+        assert!(!server::valid_peer_id("1 2"));
+        assert!(!server::valid_peer_id(&"9".repeat(65)));
+    }
+
+    // -------------------------------------------------------------- server over a socket
+
+    #[cfg(unix)]
+    mod socket {
+        use super::*;
+        use hbb_common::tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+        use hbb_common::tokio::net::UnixStream;
+        use hbb_common::tokio::sync::watch;
+        use std::os::unix::fs::PermissionsExt;
+
+        struct Dir(std::path::PathBuf);
+        impl Drop for Dir {
+            fn drop(&mut self) {
+                std::fs::remove_dir_all(&self.0).ok();
+            }
+        }
+
+        fn private_dir() -> Dir {
+            use std::sync::atomic::{AtomicU32, Ordering};
+            static N: AtomicU32 = AtomicU32::new(0);
+            let p = std::path::PathBuf::from(format!(
+                "/tmp/rs-ipc-test-{}-{}",
+                std::process::id(),
+                N.fetch_add(1, Ordering::SeqCst)
+            ));
+            std::fs::remove_dir_all(&p).ok();
+            std::fs::create_dir(&p).unwrap();
+            std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o700)).unwrap();
+            Dir(p)
+        }
+
+        fn snapshot() -> Snapshot {
+            Snapshot {
+                status: Status {
+                    app_version: "test".into(),
+                    platform: Platform::Macos,
+                    ..Default::default()
+                },
+                peers: vec![
+                    Peer {
+                        id: "222".into(),
+                        alias: Some("PC".into()),
+                        platform: Some(Platform::Windows),
+                        presence: Presence::Reachable { route: Route::Lan },
+                    },
+                    Peer {
+                        id: "333".into(),
+                        alias: None,
+                        platform: None,
+                        presence: Presence::Unavailable {
+                            reason: Reason::Offline,
+                            detail: None,
+                            last_seen: Some(1),
+                        },
+                    },
+                ],
+            }
+        }
+
+        struct Harness {
+            _dir: Dir,
+            path: String,
+            tx: watch::Sender<Snapshot>,
+            table: Table,
+            task: tokio::task::JoinHandle<()>,
+        }
+
+        impl Drop for Harness {
+            fn drop(&mut self) {
+                self.task.abort();
+            }
+        }
+
+        fn test_cfg() -> ServerConfig {
+            ServerConfig {
+                hello_deadline: Duration::from_millis(400),
+                write_timeout: Duration::from_millis(300),
+                connect_probe_timeout: Duration::from_millis(300),
+                launch: false,
+                ..ServerConfig::default()
+            }
+        }
+
+        async fn start(cfg: ServerConfig) -> Harness {
+            let dir = private_dir();
+            let path = dir.0.join("s.sock").to_string_lossy().into_owned();
+            let listener = server::bind(&path).await.unwrap();
+            let (tx, rx) = watch::channel(snapshot());
+            let table: Table = Default::default();
+            let shared = Shared {
+                snap: rx,
+                presence: table.clone(),
+            };
+            let task = tokio::spawn(server::serve(listener, cfg, shared));
+            Harness {
+                _dir: dir,
+                path,
+                tx,
+                table,
+                task,
+            }
+        }
+
+        struct Client {
+            r: BufReader<tokio::net::unix::OwnedReadHalf>,
+            w: tokio::net::unix::OwnedWriteHalf,
+        }
+
+        impl Client {
+            async fn new(path: &str) -> Client {
+                let (r, w) = UnixStream::connect(path).await.unwrap().into_split();
+                Client {
+                    r: BufReader::new(r),
+                    w,
+                }
+            }
+            async fn send(&mut self, line: &str) {
+                self.w.write_all(line.as_bytes()).await.unwrap();
+                self.w.write_all(b"\n").await.unwrap();
+            }
+            async fn recv(&mut self) -> serde_json::Value {
+                self.try_recv(Duration::from_secs(3)).await.expect("no line")
+            }
+            async fn try_recv(&mut self, t: Duration) -> Option<serde_json::Value> {
+                let mut s = String::new();
+                match tokio::time::timeout(t, self.r.read_line(&mut s)).await {
+                    Ok(Ok(n)) if n > 0 => Some(serde_json::from_str(&s).expect("server sent JSON")),
+                    _ => None,
+                }
+            }
+            /// Has the server closed the connection (EOF) within `t`?
+            async fn closed_within(&mut self, t: Duration) -> bool {
+                let mut s = String::new();
+                loop {
+                    match tokio::time::timeout(t, self.r.read_line(&mut s)).await {
+                        Ok(Ok(0)) | Ok(Err(_)) => return true,
+                        Ok(Ok(_)) => s.clear(),
+                        Err(_) => return false,
+                    }
+                }
+            }
+            async fn hello(&mut self) -> serde_json::Value {
+                self.send(r#"{"v":1,"id":1,"type":"hello","min_version":1,"max_version":1,"client":"t","client_version":"0"}"#).await;
+                self.recv().await
+            }
+        }
+
+        #[tokio::test]
+        async fn handshake_and_requests() {
+            let h = start(test_cfg()).await;
+            let mut c = Client::new(&h.path).await;
+            // Anything before hello is refused, connection kept.
+            c.send(r#"{"v":1,"id":7,"type":"get_status"}"#).await;
+            let r = c.recv().await;
+            assert_eq!((r["type"].as_str(), r["id"].as_u64()), (Some("error"), Some(7)));
+            assert_eq!(r["error"]["code"], "hello_required");
+            let ok = c.hello().await;
+            assert_eq!(ok["type"], "hello_ok");
+            assert_eq!((ok["version"].as_u64(), ok["id"].as_u64()), (Some(1), Some(1)));
+            assert_eq!(ok["server"], "RemoteSmith");
+            c.send(r#"{"v":1,"id":2,"type":"get_status"}"#).await;
+            let st = c.recv().await;
+            assert_eq!((st["type"].as_str(), st["status"]["app_version"].as_str()), (Some("status"), Some("test")));
+            c.send(r#"{"v":1,"id":3,"type":"list_peers"}"#).await;
+            let p = c.recv().await;
+            assert_eq!(p["peers"].as_array().unwrap().len(), 2);
+            c.send(r#"{"v":1,"id":4,"type":"ping"}"#).await;
+            assert_eq!(c.recv().await["type"], "pong");
+            c.send(r#"{"v":1,"id":5,"type":"format_disk"}"#).await;
+            assert_eq!(c.recv().await["error"]["code"], "unknown_type");
+            c.send(r#"{"v":1,"id":6,"type":"hello","min_version":1,"max_version":1,"client":"t","client_version":"0"}"#).await;
+            assert_eq!(c.recv().await["error"]["code"], "bad_request");
+            c.send(r#"{"v":2,"id":8,"type":"ping"}"#).await;
+            let r = c.recv().await;
+            assert_eq!((r["error"]["code"].as_str(), r["id"].as_u64()), (Some("bad_request"), Some(8)));
+        }
+
+        #[tokio::test]
+        async fn version_mismatch_closes() {
