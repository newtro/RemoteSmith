+
+        #[tokio::test]
+        async fn malformed_input_is_answered_and_survived() {
+            let h = start(test_cfg()).await;
+            let mut c = Client::new(&h.path).await;
+            c.hello().await;
+            c.send("this is not json").await;
+            let r = c.recv().await;
+            assert_eq!(r["error"]["code"], "bad_request");
+            assert!(r.get("id").is_none());
+            c.send(r#"{"v":1,"id":9,"type":"connect","peer_id":5}"#).await;
+            let r = c.recv().await;
+            assert_eq!((r["error"]["code"].as_str(), r["id"].as_u64()), (Some("bad_request"), Some(9)));
+            c.w.write_all(&[0xff, 0xfe, b'\n']).await.unwrap();
+            assert_eq!(c.recv().await["error"]["code"], "bad_request");
+            // A line over 1 MiB is discarded, not buffered, and answered.
+            let big = vec![b'x'; MAX_LINE + 100];
+            c.w.write_all(&big).await.unwrap();
+            c.w.write_all(b"\n").await.unwrap();
+            assert_eq!(c.recv().await["error"]["code"], "line_too_long");
+            // Still usable.
+            c.send(r#"{"v":1,"id":10,"type":"ping"}"#).await;
+            assert_eq!(c.recv().await["id"], 10);
+            // 20 malformed lines close this connection only.
+            let mut other = Client::new(&h.path).await;
+            other.hello().await;
+            for _ in 0..20 {
+                c.send("{").await;
+            }
+            assert!(c.closed_within(Duration::from_secs(2)).await);
+            other.send(r#"{"v":1,"id":2,"type":"ping"}"#).await;
+            assert_eq!(other.recv().await["type"], "pong");
+        }
+
+        #[tokio::test]
+        async fn eof_mid_line_closes_only_that_client() {
+            let h = start(test_cfg()).await;
+            let mut c = Client::new(&h.path).await;
+            c.hello().await;
+            c.w.write_all(br#"{"v":1,"id":2,"ty"#).await.unwrap();
+            drop(c);
+            let mut d = Client::new(&h.path).await;
+            assert_eq!(d.hello().await["type"], "hello_ok");
+        }
+
+        #[tokio::test]
+        async fn subscribe_pushes_snapshot_then_changed_topic_only() {
+            let h = start(test_cfg()).await;
+            let mut c = Client::new(&h.path).await;
+            c.hello().await;
+            c.send(r#"{"v":1,"id":2,"type":"subscribe","topics":["status","peers","desk_mode"]}"#).await;
+            let s = c.recv().await;
+            assert_eq!(s["type"], "subscribed");
+            assert_eq!(s["topics"], serde_json::json!(["status", "peers"]));
+            let a = c.recv().await;
+            let b = c.recv().await;
+            assert_eq!((a["type"].as_str(), b["type"].as_str()), (Some("status"), Some("peers")));
+            assert!(a.get("id").is_none() && b.get("id").is_none());
+            // An inbound session starts: only a status event, within 500 ms.
+            let t = std::time::Instant::now();
+            h.tx.send_modify(|s| {
+                s.status.inbound_sessions.push(InboundSession {
+                    conn_id: 1,
+                    peer_id: "222".into(),
+                    alias: Some("PC".into()),
+                    kind: SessionKind::Human,
+                    since: Some(1),
+                })
+            });
+            let e = c.recv().await;
+            assert!(t.elapsed() < Duration::from_millis(500));
+            assert_eq!(e["type"], "status");
+            assert_eq!(e["status"]["inbound_sessions"][0]["peer_id"], "222");
+            assert!(c.try_recv(Duration::from_millis(200)).await.is_none(), "no peers event");
+            // It ends: pushed again, badge clears.
+            h.tx.send_modify(|s| s.status.inbound_sessions.clear());
+            let e = c.recv().await;
+            assert_eq!(e["status"]["inbound_sessions"], serde_json::json!([]));
+            // A presence change: peers event only.
+            h.tx.send_modify(|s| s.peers[0].presence = Presence::Checking);
+            let e = c.recv().await;
+            assert_eq!(e["type"], "peers");
+            assert_eq!(e["peers"][0]["presence"]["state"], "checking");
+        }
+
+        #[tokio::test]
+        async fn connect_rules() {
+            let h = start(test_cfg()).await;
+            let mut c = Client::new(&h.path).await;
+            c.hello().await;
+            c.send(r#"{"v":1,"id":2,"type":"connect","peer_id":"999"}"#).await;
+            let r = c.recv().await;
+            assert_eq!((r["error"]["code"].as_str(), r["id"].as_u64()), (Some("peer_unknown"), Some(2)));
+            // Known and reachable; an extra credential field is ignored, never echoed.
