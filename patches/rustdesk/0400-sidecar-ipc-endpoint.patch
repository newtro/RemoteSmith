+        }],
+    };
+    let line = encode(1, None, ServerMessage::Status { status: Box::new(status.clone()) });
+    let v: serde_json::Value = serde_json::from_str(&line).unwrap();
+    // v1 output carries every Status field (docs/IPC.md §7).
+    for k in [
+        "app_version",
