+/// Outcome of the version negotiation rule in docs/IPC.md §4.
+pub fn negotiate(
+    client_min: u32,
+    client_max: u32,
+    server_min: u32,
+    server_max: u32,
+) -> Option<u32> {
+    let chosen = client_max.min(server_max);
+    if chosen < client_min.max(server_min) {
+        None
+    } else {
+        Some(chosen)
+    }
+}
