+#[test]
+fn session_registry_open_close_and_wake() {
+    use std::time::{Duration, Instant};
+    let (_, g0) = sessions::snapshot();
+    let waiter = std::thread::spawn(move || {
+        let t = Instant::now();
+        let g = sessions::wait_change(g0, Duration::from_secs(5));
+        (g, t.elapsed())
+    });
+    std::thread::sleep(Duration::from_millis(50));
+    sessions::opened(-4242, false, "555", "bob");
+    let (g1, waited) = waiter.join().unwrap();
+    assert_ne!(g1, g0);
+    assert!(waited < Duration::from_secs(1), "woke after {waited:?}");
+    let (list, _) = sessions::snapshot();
+    let s = list.iter().find(|s| s.conn_id == -4242).expect("registered");
+    assert_eq!((s.peer_id.as_str(), s.name.as_str(), s.remote), ("555", "bob", false));
+    sessions::closed(-4242);
+    assert!(!sessions::snapshot().0.iter().any(|s| s.conn_id == -4242));
+    // Closing an unknown id is a no-op.
+    let (_, g2) = sessions::snapshot();
+    sessions::closed(-4242);
+    assert_eq!(sessions::snapshot().1, g2);
+}
