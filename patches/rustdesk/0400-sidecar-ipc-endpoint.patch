+/// Serialize one message as a single line with trailing newline. The fork's server enforces
+/// [`MAX_LINE`] on top of this (`server::encode_bounded`).
+pub fn encode<T: Serialize>(v: u32, id: Option<u64>, body: T) -> String {
+    // Serialization of these plain types cannot fail; fall back to an empty object defensively.
+    let mut s = serde_json::to_string(&Envelope::new(v, id, body)).unwrap_or_else(|_| "{}".into());
+    s.push('\n');
+    s
+}
+
+/// Why a received line could not be used.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DecodeError {
+    TooLong,
+    NotUtf8,
+    /// serde_json's error category only (`syntax`, `data`, `eof`, `io`). The full serde message
+    /// can quote received values, so it is never kept or logged.
+    BadJson(&'static str),
+}
+
+impl DecodeError {
+    /// Log-safe description of a rejected line: its size and why, never its content.
+    pub fn describe(&self, len: usize) -> String {
+        match self {
+            DecodeError::TooLong => format!("{len}-byte line over the 1 MiB limit"),
+            DecodeError::NotUtf8 => format!("{len}-byte line, not UTF-8"),
+            DecodeError::BadJson(c) => format!("{len}-byte line, unparseable JSON ({c} error)"),
+        }
+    }
+}
+
+/// Parse one line (without its newline). Best-effort extracts `id` for error replies.
+pub fn decode<T: for<'de> Deserialize<'de>>(
+    line: &[u8],
+) -> Result<Envelope<T>, (DecodeError, Option<u64>)> {
+    if line.len() >= MAX_LINE {
+        return Err((DecodeError::TooLong, None));
+    }
+    let text = std::str::from_utf8(line).map_err(|_| (DecodeError::NotUtf8, None))?;
+    let text = text.strip_suffix('\r').unwrap_or(text);
+    match serde_json::from_str::<Envelope<T>>(text) {
+        Ok(env) => Ok(env),
+        Err(e) => {
+            let id = serde_json::from_str::<serde_json::Value>(text)
+                .ok()
+                .and_then(|v| v.get("id").and_then(|i| i.as_u64()));
+            let category = match e.classify() {
+                serde_json::error::Category::Syntax => "syntax",
+                serde_json::error::Category::Data => "data",
+                serde_json::error::Category::Eof => "eof",
+                serde_json::error::Category::Io => "io",
+            };
+            Err((DecodeError::BadJson(category), id))
+        }
+    }
+}
+
+/// Result of reading one bounded line.
+#[derive(Debug, PartialEq, Eq)]
+pub enum LineRead {
+    Line(Vec<u8>),
+    /// A line exceeded [`MAX_LINE`]; it was discarded up to and including its newline.
+    TooLong,
+    Eof,
+}
+
+/// Read one `\n`-terminated line without ever buffering more than `max` bytes.
+/// An unterminated tail at EOF is reported as `Eof` (a half-written line is never acted upon).
+pub async fn read_line_bounded<R>(reader: &mut R, max: usize) -> std::io::Result<LineRead>
+where
+    R: tokio::io::AsyncBufRead + Unpin,
+{
+    use tokio::io::AsyncBufReadExt;
+    let mut buf: Vec<u8> = Vec::new();
+    let mut overflow = false;
+    loop {
+        let chunk = reader.fill_buf().await?;
+        if chunk.is_empty() {
+            return Ok(LineRead::Eof);
+        }
+        if let Some(pos) = chunk.iter().position(|&b| b == b'\n') {
+            if !overflow && buf.len() + pos < max {
+                buf.extend_from_slice(&chunk[..pos]);
+            } else {
+                overflow = true;
+            }
+            reader.consume(pos + 1);
+            return Ok(if overflow {
+                LineRead::TooLong
+            } else {
+                LineRead::Line(buf)
+            });
+        }
+        let n = chunk.len();
+        if !overflow {
+            if buf.len() + n >= max {
+                overflow = true;
+                buf = Vec::new();
+            } else {
+                buf.extend_from_slice(chunk);
+            }
+        }
+        reader.consume(n);
+    }
+}
