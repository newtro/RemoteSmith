+            let r = c.recv().await;
+            assert_eq!((r["type"].as_str(), r["peer_id"].as_str()), (Some("connect_started"), Some("222")));
+            assert!(!r.to_string().contains("hunter2"));
+            // Known, last seen offline: a fresh probe runs first (no server here, so it stays
+            // unavailable and the reply says why).
+            c.send(r#"{"v":1,"id":4,"type":"connect","peer_id":"333"}"#).await;
+            let r = c.recv().await;
