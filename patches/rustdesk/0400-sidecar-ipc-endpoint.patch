new file mode 100644
index 000000000000..0d02cad1c6ec
--- /dev/null
+++ b/src/remotesmith/relay.rs
@@ -0,0 +1,122 @@
+//! Windows `--tray`: fetch the host facts from the SYSTEM `--server` over RustDesk's main IPC
+//! (`Data::RemoteSmithHost`), the same way upstream's tray polls `ControlledSessionCount`.
+//! Polled every 250 ms so an inbound session starting or ending reaches the sidecar well inside
+//! the 500 ms of docs/IPC.md §6.2.
+
+use super::host::HostFacts;
+use super::sessions;
+use crate::ipc::Data;
+use hbb_common::config::{Config, Config2};
+use hbb_common::{log, tokio};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+const POLL: Duration = Duration::from_millis(250);
+/// Facts older than this count as "service not answering".
+const STALE: Duration = Duration::from_secs(3);
+/// Re-sync the user-side config copy (ID, rendezvous server, used by the presence query) as
+/// upstream's UI does at start (`start_server(false, ..)`).
+const CONFIG_SYNC: Duration = Duration::from_secs(300);
+
+#[derive(Clone)]
+pub struct Relay {
+    latest: Arc<Mutex<Option<(Instant, HostFacts)>>>,
+}
+
+impl Relay {
+    pub fn facts(&self) -> Option<HostFacts> {
+        let l = self.latest.lock().unwrap_or_else(|e| e.into_inner());
+        l.as_ref()
+            .filter(|(at, _)| at.elapsed() < STALE)
+            .map(|(_, f)| f.clone())
+    }
+}
+
+pub fn start() -> Relay {
+    let relay = Relay {
+        latest: Default::default(),
+    };
+    let latest = relay.latest.clone();
+    let spawned = std::thread::Builder::new()
+        .name("remotesmith-relay".into())
+        .spawn(move || {
+            let rt = match tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+            {
+                Ok(rt) => rt,
+                Err(e) => {
+                    log::error!("remotesmith relay: no runtime: {e}");
+                    return;
+                }
+            };
+            rt.block_on(run(latest));
+        });
+    if let Err(e) = spawned {
+        log::error!("remotesmith relay: cannot start: {e}");
+    }
+    relay
+}
+
+fn set(latest: &Mutex<Option<(Instant, HostFacts)>>, facts: Option<HostFacts>) {
+    let mut l = latest.lock().unwrap_or_else(|e| e.into_inner());
+    let changed = l.as_ref().map(|(_, f)| f) != facts.as_ref();
+    *l = facts.map(|f| (Instant::now(), f));
+    drop(l);
+    if changed {
+        sessions::poke();
+    }
+}
+
+async fn run(latest: Arc<Mutex<Option<(Instant, HostFacts)>>>) {
+    loop {
+        match crate::ipc::connect(1000, "").await {
+            Ok(mut c) => {
+                let mut synced_at: Option<Instant> = None;
+                'conn: loop {
+                    if synced_at.map_or(true, |t| t.elapsed() >= CONFIG_SYNC) {
+                        synced_at = Some(Instant::now());
+                        if c.send(&Data::SyncConfig(None)).await.is_err() {
+                            break 'conn;
+                        }
+                    }
+                    if c.send(&Data::RemoteSmithHost(None)).await.is_err() {
+                        break 'conn;
+                    }
+                    let deadline = Instant::now() + Duration::from_secs(1);
+                    loop {
+                        let left = deadline.saturating_duration_since(Instant::now());
+                        if left.is_zero() {
+                            // An older server without the handler answers nothing.
+                            set(&latest, None);
+                            break;
+                        }
+                        match c.next_timeout2(left.as_millis().max(1) as u64).await {
+                            Some(Ok(Some(Data::RemoteSmithHost(Some(json))))) => {
+                                match HostFacts::from_json(&json) {
+                                    Some(f) => set(&latest, Some(f)),
+                                    None => log::warn!("remotesmith relay: unreadable host facts"),
+                                }
+                                break;
+                            }
+                            Some(Ok(Some(Data::SyncConfig(Some(configs))))) => {
+                                let (config, config2) = *configs;
+                                Config::set(config);
+                                Config2::set(config2);
+                            }
+                            // Other traffic, or a message this build cannot parse.
+                            Some(Ok(_)) => {}
+                            // Timed out: the deadline check above handles it.
+                            None => {}
+                            Some(Err(_)) => break 'conn,
+                        }
+                    }
+                    tokio::time::sleep(POLL).await;
+                }
+            }
+            Err(e) => log::debug!("remotesmith relay: service IPC not reachable: {e}"),
+        }
+        set(&latest, None);
+        tokio::time::sleep(Duration::from_secs(1)).await;
+    }
+}
diff --git a/src/remotesmith/server.rs b/src/remotesmith/server.rs
new file mode 100644
index 000000000000..5465afe89c9e
--- /dev/null
+++ b/src/remotesmith/server.rs
@@ -0,0 +1,552 @@
+//! The endpoint itself (docs/IPC.md §2-§10), ported from the sidecar's reference server
+//! (`sidecar/src/fake_fork.rs`): hello first, version negotiation, per-connection isolation,
+//! bounded reads and writes, malformed-input handling, client cap, peer-uid check on macOS and a
+//! user-only DACL on Windows.
+
+use super::collect::{Shared, Snapshot};
+use super::presence;
+use super::protocol::{
+    decode, encode, negotiate, read_line_bounded, DecodeError, ErrorBody, ErrorCode, LineRead,
+    Peer, Presence, Request, ServerMessage, Status, Topic, MAX_LINE,
+};
+use hbb_common::log;
+use hbb_common::tokio::{
+    self,
+    io::{AsyncRead, AsyncWrite, AsyncWriteExt, BufReader},
+    sync::{mpsc, Semaphore},
+};
+use std::io;
+use std::sync::Arc;
+use std::time::Duration;
+
+/// Versions this fork speaks.
+pub const MIN_VERSION: u32 = 1;
+pub const MAX_VERSION: u32 = 1;
+
+#[derive(Debug, Clone)]
+pub struct ServerConfig {
+    pub hello_deadline: Duration,
+    pub idle_timeout: Duration,
+    pub write_timeout: Duration,
+    pub max_clients: usize,
+    pub max_malformed: u32,
+    /// Fresh presence probe on `connect` to a peer last seen unavailable.
+    pub connect_probe_timeout: Duration,
+    /// Actually start session windows (tests turn this off).
+    pub launch: bool,
+}
+
+impl Default for ServerConfig {
+    fn default() -> Self {
+        Self {
+            hello_deadline: Duration::from_secs(5),
+            idle_timeout: Duration::from_secs(60),
+            write_timeout: Duration::from_secs(5),
+            max_clients: 8,
+            max_malformed: 20,
+            connect_probe_timeout: Duration::from_millis(2500),
+            launch: true,
+        }
+    }
+}
+
+// ---------------------------------------------------------------- listener (per OS)
+
+#[cfg(unix)]
+pub struct Listener {
+    inner: tokio::net::UnixListener,
+    path: std::path::PathBuf,
+    /// (dev, ino) of the socket we bound, so Drop never unlinks a successor's socket.
+    ident: (u64, u64),
+}
+
+#[cfg(unix)]
+impl Drop for Listener {
+    fn drop(&mut self) {
+        use std::os::unix::fs::MetadataExt;
+        if let Ok(m) = std::fs::symlink_metadata(&self.path) {
+            if (m.dev(), m.ino()) == self.ident {
+                let _ = std::fs::remove_file(&self.path);
+            }
+        }
+    }
+}
+
+#[cfg(unix)]
+pub fn euid() -> u32 {
+    // SAFETY: geteuid has no preconditions and cannot fail.
+    unsafe { hbb_common::libc::geteuid() }
+}
+
+/// `dir` must be a real directory (not a symlink) owned by us with no group/other access.
+#[cfg(unix)]
+pub fn check_private_dir(dir: &std::path::Path) -> io::Result<()> {
+    use std::os::unix::fs::MetadataExt;
+    let meta = std::fs::symlink_metadata(dir)?;
+    if !meta.file_type().is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("{} is not a directory", dir.display()),
+        ));
+    }
+    if meta.uid() != euid() || meta.mode() & 0o077 != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            format!(
+                "{} must be owned by uid {} with mode 0700 (is uid {}, mode {:o}); refusing",
+                dir.display(),
+                euid(),
+                meta.uid(),
+                meta.mode() & 0o7777
+            ),
+        ));
+    }
+    Ok(())
+}
+
+/// Bind the endpoint: the parent directory must be private to this user (created 0700 if
+/// missing), a stale socket of ours is replaced, a live one is never stolen.
+#[cfg(unix)]
+pub async fn bind(endpoint: &str) -> io::Result<Listener> {
+    use std::os::unix::fs::{DirBuilderExt, MetadataExt, PermissionsExt};
+    let path = std::path::PathBuf::from(endpoint);
+    let dir = path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "endpoint has no parent"))?;
+    match std::fs::DirBuilder::new().mode(0o700).create(dir) {
+        Ok(()) => {}
+        Err(e) if e.kind() == io::ErrorKind::AlreadyExists => {}
+        Err(e) => return Err(e),
+    }
+    check_private_dir(dir)?;
+    if let Ok(meta) = std::fs::symlink_metadata(&path) {
+        if meta.uid() != euid() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "endpoint owned by another user",
+            ));
+        }
+        if tokio::net::UnixStream::connect(&path).await.is_ok() {
+            return Err(io::Error::new(
+                io::ErrorKind::AddrInUse,
+                "another server is listening",
+            ));
+        }
+        std::fs::remove_file(&path)?;
+    }
+    let inner = tokio::net::UnixListener::bind(&path)?;
+    // The 0700 directory already keeps other users out; 0600 is belt and braces.
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+    let m = std::fs::symlink_metadata(&path)?;
+    Ok(Listener {
+        inner,
+        path,
+        ident: (m.dev(), m.ino()),
+    })
+}
+
+#[cfg(unix)]
+impl Listener {
+    async fn accept(&mut self) -> io::Result<tokio::net::UnixStream> {
+        loop {
+            let (s, _) = self.inner.accept().await?;
+            // Peer-credential check: only our own user may talk to us.
+            match s.peer_cred() {
+                Ok(c) if c.uid() == euid() => return Ok(s),
+                Ok(c) => log::warn!("remotesmith ipc: rejected client with uid {}", c.uid()),
+                Err(e) => log::warn!("remotesmith ipc: rejected client without peer credentials ({e})"),
+            }
+        }
+    }
+}
+
+#[cfg(windows)]
+pub struct Listener {
+    name: String,
+    next: tokio::net::windows::named_pipe::NamedPipeServer,
+}
+
+#[cfg(windows)]
+fn create_pipe(
+    name: &str,
+    first: bool,
+) -> io::Result<tokio::net::windows::named_pipe::NamedPipeServer> {
+    use tokio::net::windows::named_pipe::ServerOptions;
+    static SA: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let sa = match SA.get() {
+        Some(p) => *p,
+        None => {
+            let p = super::winsec::user_only_security_attributes()? as usize;
+            *SA.get_or_init(|| p)
+        }
+    };
+    let mut opts = ServerOptions::new();
+    opts.first_pipe_instance(first).reject_remote_clients(true);
+    // SAFETY: `sa` points to a leaked, valid SECURITY_ATTRIBUTES.
+    unsafe { opts.create_with_security_attributes_raw(name, sa as *mut std::ffi::c_void) }
+}
+
+/// Create the pipe. `FILE_FLAG_FIRST_PIPE_INSTANCE`: if someone squatted the name, this fails.
+#[cfg(windows)]
+pub async fn bind(endpoint: &str) -> io::Result<Listener> {
+    Ok(Listener {
+        name: endpoint.to_string(),
+        next: create_pipe(endpoint, true)?,
+    })
+}
+
+#[cfg(windows)]
+impl Listener {
+    async fn accept(&mut self) -> io::Result<tokio::net::windows::named_pipe::NamedPipeServer> {
+        if let Err(e) = self.next.connect().await {
+            // e.g. ERROR_NO_DATA: the client left before we connected. Start a fresh instance.
+            self.next = create_pipe(&self.name, false)?;
+            return Err(e);
+        }
+        let fresh = create_pipe(&self.name, false)?;
+        Ok(std::mem::replace(&mut self.next, fresh))
+    }
+}
+
+// ---------------------------------------------------------------- serving
+
+/// Serve forever. Each connection runs in its own task; one misbehaving client can never affect
+/// another, nor anything outside this thread (DEC-5, AC-25).
+pub async fn serve(mut listener: Listener, cfg: ServerConfig, shared: Shared) {
+    let slots = Arc::new(Semaphore::new(cfg.max_clients));
+    let mut conns = tokio::task::JoinSet::new();
+    loop {
+        let stream = tokio::select! {
+            s = listener.accept() => match s {
+                Ok(s) => s,
+                Err(e) => {
+                    // Transient (EMFILE, ECONNABORTED, a client that vanished): never let one
+                    // failed accept take the endpoint down for good.
+                    log::warn!("remotesmith ipc: accept failed: {e}");
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                    continue;
+                }
+            },
+            Some(_) = conns.join_next(), if !conns.is_empty() => continue,
+        };
+        let Ok(permit) = slots.clone().try_acquire_owned() else {
+            drop(stream); // over the client cap: close immediately
+            continue;
+        };
+        let (cfg, shared) = (cfg.clone(), shared.clone());
+        conns.spawn(async move {
+            if let Err(e) = handle_conn(stream, cfg, shared).await {
+                log::debug!("remotesmith ipc: client ended: {e}");
+            }
+            drop(permit);
+        });
+    }
+}
+
+async fn write_line<W: AsyncWrite + Unpin>(w: &mut W, line: &str, t: Duration) -> io::Result<()> {
+    debug_assert!(line.len() <= MAX_LINE);
+    match tokio::time::timeout(t, w.write_all(line.as_bytes())).await {
+        Ok(r) => r,
+        Err(_) => Err(io::Error::new(io::ErrorKind::TimedOut, "client not reading")),
+    }
+}
+
+fn err(code: ErrorCode, msg: impl Into<String>) -> ServerMessage {
+    ServerMessage::Error {
+        error: ErrorBody::new(code, msg),
+    }
+}
+
+/// Encode a message within [`MAX_LINE`] (docs/IPC.md §3): an over-long peer list is truncated
+/// to the longest prefix that fits, an over-long session list likewise (keeping the oldest
+/// sessions, so the badge never disappears); anything else that cannot fit becomes `internal`.
+pub fn encode_bounded(v: u32, id: Option<u64>, msg: ServerMessage) -> String {
+    let line = encode(v, id, &msg);
+    if line.len() <= MAX_LINE {
+        return line;
+    }
+    let fits = |m: &ServerMessage| encode(v, id, m).len() <= MAX_LINE;
+    // Largest n in [0, len] with fits(make(n)), by binary search (fits is monotone in n).
+    fn largest<F: Fn(usize) -> bool>(len: usize, ok: F) -> usize {
+        let (mut lo, mut hi) = (0usize, len);
+        while lo < hi {
+            let mid = (lo + hi + 1) / 2;
+            if ok(mid) {
+                lo = mid;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        lo
+    }
+    match msg {
+        ServerMessage::Peers { peers } => {
+            let make = |n: usize| ServerMessage::Peers {
+                peers: peers[..n].to_vec(),
+            };
+            let n = largest(peers.len(), |n| fits(&make(n)));
+            log::warn!("remotesmith ipc: peer list truncated to {n} of {}", peers.len());
+            encode(v, id, make(n))
+        }
+        ServerMessage::Status { status } => {
+            let make = |n: usize| {
+                let mut s: Status = (*status).clone();
+                s.inbound_sessions.truncate(n);
+                ServerMessage::Status {
+                    status: Box::new(s),
+                }
+            };
+            let n = largest(status.inbound_sessions.len(), |n| fits(&make(n)));
+            let m = make(n);
+            if fits(&m) {
+                encode(v, id, m)
+            } else {
+                encode(v, id, err(ErrorCode::Internal, "status too large"))
+            }
+        }
+        _ => encode(v, id, err(ErrorCode::Internal, "reply too large")),
+    }
+}
+
+/// Last values pushed to one client, so events go out only for the topic that changed.
+#[derive(Default)]
+struct Pushed {
+    status: Option<Status>,
+    peers: Option<Vec<Peer>>,
+}
+
+async fn push<W: AsyncWrite + Unpin>(
+    w: &mut W,
+    v: u32,
+    topics: &[Topic],
+    s: &Snapshot,
+    pushed: &mut Pushed,
+    force: bool,
+    t: Duration,
+) -> io::Result<()> {
+    if topics.contains(&Topic::Status) && (force || pushed.status.as_ref() != Some(&s.status)) {
+        let m = ServerMessage::Status {
+            status: Box::new(s.status.clone()),
+        };
+        write_line(w, &encode_bounded(v, None, m), t).await?;
+        pushed.status = Some(s.status.clone());
+    }
+    if topics.contains(&Topic::Peers) && (force || pushed.peers.as_ref() != Some(&s.peers)) {
+        let m = ServerMessage::Peers {
+            peers: s.peers.clone(),
+        };
+        write_line(w, &encode_bounded(v, None, m), t).await?;
+        pushed.peers = Some(s.peers.clone());
+    }
+    Ok(())
+}
+
+/// A peer id that is safe to put on a command line (it must also be one of our saved peers).
+pub fn valid_peer_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= 64
+        && !id.starts_with('-')
+        && id
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.' | '@' | ':'))
+}
+
+/// Open a normal outgoing session window, exactly as `RustDesk --connect <id>` does: it hands
+/// the request to the running main window (or starts it). No credential is passed: the session
+/// uses the saved one (docs/IPC.md §1.2).
+fn launch_session(peer_id: &str) -> io::Result<()> {
+    let mut child = crate::run_me(vec!["--connect", peer_id])?;
+    // Reap it (it exits at once when a main window takes the request).
+    std::thread::Builder::new()
+        .name("remotesmith-connect".into())
+        .spawn(move || {
+            child.wait().ok();
+        })?;
+    Ok(())
+}
+
+async fn handle_connect(peer_id: String, cfg: &ServerConfig, shared: &Shared) -> ServerMessage {
+    let peer = shared.snap.borrow().peers.iter().find(|p| p.id == peer_id).cloned();
+    let Some(peer) = peer else {
+        return err(ErrorCode::PeerUnknown, format!("no peer {}", clamp_id(&peer_id)));
+    };
+    if !valid_peer_id(&peer.id) {
+        return err(ErrorCode::PeerUnavailable, "peer id is not usable");
+    }
+    if let Presence::Unavailable { .. } = peer.presence {
+        // The table can be up to one probe interval old: ask again before refusing.
+        let registered = shared.registered();
+        let fresh = tokio::time::timeout(
+            cfg.connect_probe_timeout,
+            presence::probe_now(&shared.presence, &peer.id, registered),
+        )
+        .await;
+        super::sessions::poke();
+        if let Ok(e) = fresh {
+            if let Presence::Unavailable { reason, detail, .. } =
+                presence::presence_of(&e, registered)
+            {
+                let mut msg = reason.label();
+                if let Some(d) = detail {
+                    msg = format!("{msg}: {d}");
+                }
+                return err(ErrorCode::PeerUnavailable, msg);
+            }
+        }
+        // Probe timed out: let the session window try and report.
+    }
+    if cfg.launch {
+        let id = peer.id.clone();
+        match tokio::task::spawn_blocking(move || launch_session(&id)).await {
+            Ok(Ok(())) => {}
+            Ok(Err(e)) => {
+                log::error!("remotesmith ipc: cannot start a session window: {e}");
+                return err(ErrorCode::Internal, "could not start a session window");
+            }
+            Err(_) => return err(ErrorCode::Internal, "could not start a session window"),
+        }
+    }
+    log::info!("remotesmith ipc: connect {} started", peer.id);
+    ServerMessage::ConnectStarted { peer_id: peer.id }
+}
+
+fn clamp_id(s: &str) -> String {
+    s.chars().take(64).collect()
+}
+
+async fn handle_conn<S>(stream: S, cfg: ServerConfig, shared: Shared) -> io::Result<()>
+where
+    S: AsyncRead + AsyncWrite + Unpin + Send + 'static,
+{
+    let (rd, mut wr) = tokio::io::split(stream);
+    let (tx, mut lines) = mpsc::channel::<LineRead>(16);
+    let reader = tokio::spawn(async move {
+        let mut rd = BufReader::new(rd);
+        loop {
+            let r = read_line_bounded(&mut rd, MAX_LINE)
+                .await
+                .unwrap_or(LineRead::Eof);
+            let eof = r == LineRead::Eof;
+            if tx.send(r).await.is_err() || eof {
+                return;
+            }
+        }
+    });
+    struct Abort(tokio::task::JoinHandle<()>);
+    impl Drop for Abort {
+        fn drop(&mut self) {
+            self.0.abort();
+        }
+    }
+    let _abort = Abort(reader);
+
+    let wt = cfg.write_timeout;
+    let mut snap = shared.snap.clone();
+    let mut version: Option<u32> = None;
+    let mut topics: Vec<Topic> = Vec::new();
+    let mut pushed = Pushed::default();
+    let mut malformed = 0u32;
+    let hello_deadline = tokio::time::Instant::now() + cfg.hello_deadline;
+    let mut idle_deadline = tokio::time::Instant::now() + cfg.idle_timeout;
+
+    loop {
+        tokio::select! {
+            line = lines.recv() => {
+                idle_deadline = tokio::time::Instant::now() + cfg.idle_timeout;
+                let v = version.unwrap_or(1);
+                let bytes = match line {
+                    None | Some(LineRead::Eof) => return Ok(()),
+                    Some(LineRead::TooLong) => {
+                        malformed += 1;
+                        write_line(&mut wr, &encode(v, None, err(ErrorCode::LineTooLong, "line exceeds 1 MiB")), wt).await?;
+                        if malformed >= cfg.max_malformed { return Ok(()); }
+                        continue;
+                    }
+                    Some(LineRead::Line(b)) => b,
+                };
+                let env = match decode::<Request>(&bytes) {
+                    Ok(e) => e,
+                    Err((e, id)) => {
+                        malformed += 1;
+                        let code = if e == DecodeError::TooLong { ErrorCode::LineTooLong } else { ErrorCode::BadRequest };
+                        write_line(&mut wr, &encode(v, id, err(code, "malformed request")), wt).await?;
+                        if malformed >= cfg.max_malformed { return Ok(()); }
+                        continue;
+                    }
+                };
+                if let Some(v) = version {
+                    if env.v != v {
+                        malformed += 1;
+                        write_line(&mut wr, &encode(v, env.id, err(ErrorCode::BadRequest, format!("negotiated v{v}, got v{}", env.v))), wt).await?;
+                        if malformed >= cfg.max_malformed { return Ok(()); }
+                        continue;
+                    }
+                }
+                let id = env.id;
+                match (version, env.body) {
+                    (Some(v), Request::Hello { .. }) => {
+                        write_line(&mut wr, &encode(v, id, err(ErrorCode::BadRequest, "already negotiated")), wt).await?;
+                    }
+                    (None, Request::Hello { min_version, max_version, .. }) => {
+                        match negotiate(min_version, max_version, MIN_VERSION, MAX_VERSION) {
+                            Some(chosen) => {
+                                version = Some(chosen);
+                                write_line(&mut wr, &encode(chosen, id, ServerMessage::HelloOk {
+                                    version: chosen,
+                                    min_version: MIN_VERSION,
+                                    max_version: MAX_VERSION,
+                                    server: "RemoteSmith".into(),
+                                    server_version: crate::VERSION.to_owned(),
+                                }), wt).await?;
+                            }
+                            None => {
+                                let mut e = ErrorBody::new(ErrorCode::VersionMismatch, format!(
+                                    "server speaks {MIN_VERSION}-{MAX_VERSION}, client {min_version}-{max_version}"));
+                                e.min_version = Some(MIN_VERSION);
+                                e.max_version = Some(MAX_VERSION);
+                                write_line(&mut wr, &encode(1, id, ServerMessage::Error { error: e }), wt).await?;
+                                return Ok(());
+                            }
+                        }
+                    }
+                    (None, _) => {
+                        write_line(&mut wr, &encode(1, id, err(ErrorCode::HelloRequired, "send hello first")), wt).await?;
+                    }
+                    (Some(v), Request::GetStatus) => {
+                        let status = snap.borrow().status.clone();
+                        write_line(&mut wr, &encode_bounded(v, id, ServerMessage::Status { status: Box::new(status) }), wt).await?;
+                    }
+                    (Some(v), Request::ListPeers) => {
+                        let peers = snap.borrow().peers.clone();
+                        write_line(&mut wr, &encode_bounded(v, id, ServerMessage::Peers { peers }), wt).await?;
+                    }
+                    (Some(v), Request::Ping) => write_line(&mut wr, &encode(v, id, ServerMessage::Pong), wt).await?,
+                    (Some(v), Request::Subscribe { topics: t }) => {
+                        let mut t: Vec<Topic> = t.into_iter().filter(|t| *t != Topic::Unknown).collect();
+                        t.dedup();
+                        topics = t;
+                        write_line(&mut wr, &encode(v, id, ServerMessage::Subscribed { topics: topics.clone() }), wt).await?;
+                        let s = snap.borrow_and_update().clone();
+                        push(&mut wr, v, &topics, &s, &mut pushed, true, wt).await?;
+                    }
+                    (Some(v), Request::Connect { peer_id }) => {
+                        // Extra fields (e.g. a password) were dropped by the decoder: the fork
+                        // never reads credentials from IPC.
+                        let reply = handle_connect(peer_id, &cfg, &shared).await;
+                        write_line(&mut wr, &encode(v, id, reply), wt).await?;
+                    }
+                    (Some(v), Request::Unknown) => {
+                        write_line(&mut wr, &encode(v, id, err(ErrorCode::UnknownType, "unknown request type")), wt).await?;
+                    }
+                }
+            }
+            changed = snap.changed(), if version.is_some() && !topics.is_empty() => {
+                if changed.is_err() { return Ok(()); }
+                let s = snap.borrow_and_update().clone();
+                push(&mut wr, version.unwrap_or(1), &topics, &s, &mut pushed, false, wt).await?;
+            }
+            _ = tokio::time::sleep_until(hello_deadline), if version.is_none() => return Ok(()),
+            _ = tokio::time::sleep_until(idle_deadline) => return Ok(()),
+        }
+    }
+}
