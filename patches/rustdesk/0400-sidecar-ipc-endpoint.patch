+
+    #[test]
+    fn output_lines_never_exceed_max_line() {
+        let peers: Vec<Peer> = (0..20_000)
+            .map(|i| Peer {
+                id: format!("{i:09}"),
+                alias: Some("x".repeat(60)),
+                platform: Some(Platform::Windows),
+                presence: Presence::Unavailable {
+                    reason: Reason::Offline,
+                    detail: Some("y".repeat(20)),
+                    last_seen: Some(1),
+                },
+            })
+            .collect();
+        let line = encode_bounded(1, Some(3), ServerMessage::Peers { peers: peers.clone() });
+        assert!(line.len() <= MAX_LINE, "{}", line.len());
+        let env: Envelope<ServerMessage> = decode(line.trim_end().as_bytes()).unwrap();
+        let ServerMessage::Peers { peers: got } = env.body else { panic!() };
+        assert!(got.len() > 1000 && got.len() < peers.len());
+        assert_eq!(got[..], peers[..got.len()]);
+        // Small messages are untouched.
+        let small = encode_bounded(1, None, ServerMessage::Pong);
+        assert_eq!(small, encode(1, None, ServerMessage::Pong));
+    }
