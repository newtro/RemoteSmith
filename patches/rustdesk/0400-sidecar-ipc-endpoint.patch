+//! Tests for the RemoteSmith endpoint: the shared protocol fixture, the server against a raw
+//! client (handshake, malformed input, limits, pushes, connect), the listener's permission
+//! rules, and the pure readiness/presence/ledger logic.
+
+use super::protocol::*;
+use super::sessions::{self, ledger};
+use hbb_common::tokio;
+
+/// docs/ipc-fixtures/v1.jsonl in the RemoteSmith superproject, also decoded by the sidecar.
+const FIXTURE: &str = include_str!(concat!(
+    env!("CARGO_MANIFEST_DIR"),
+    "/../../docs/ipc-fixtures/v1.jsonl"
+));
+
+#[derive(serde_derive::Deserialize)]
+struct Sample {
+    to: String,
+    valid: bool,
+    #[serde(rename = "type")]
+    ty: Option<String>,
+    note: String,
+    line: String,
+}
+
+fn samples() -> Vec<Sample> {
+    FIXTURE
+        .lines()
+        .filter(|l| !l.trim().is_empty())
+        .map(|l| serde_json::from_str(l).expect("fixture line"))
+        .collect()
+}
+
+fn wire_type<T: serde::Serialize>(body: &T) -> String {
+    let v = serde_json::to_value(body).unwrap();
+    v["type"].as_str().unwrap_or("").to_owned()
+}
+
+#[test]
+fn shared_fixture_decodes_like_the_sidecar() {
+    let all = samples();
+    assert!(all.len() >= 30, "fixture too small: {}", all.len());
+    for s in &all {
+        match s.to.as_str() {
+            "server" => match decode::<Request>(s.line.as_bytes()) {
+                Ok(env) => {
+                    assert!(s.valid, "{}: decoded but should fail", s.note);
+                    assert_eq!(Some(wire_type(&env.body)), s.ty, "{}", s.note);
+                    // Re-encoding drops unknown fields (credentials never round-trip).
+                    let re = encode(env.v, env.id, &env.body);
+                    assert!(!re.contains("hunter2"), "{}", s.note);
+                    let back: Envelope<Request> = decode(re.trim_end().as_bytes()).unwrap();
+                    assert_eq!(back.body, env.body, "{}", s.note);
+                }
+                Err(_) => assert!(!s.valid, "{}: rejected but should decode", s.note),
+            },
+            "client" => match decode::<ServerMessage>(s.line.as_bytes()) {
+                Ok(env) => {
+                    assert!(s.valid, "{}: decoded but should fail", s.note);
+                    assert_eq!(Some(wire_type(&env.body)), s.ty, "{}", s.note);
+                    let re = encode(env.v, env.id, &env.body);
+                    let back: Envelope<ServerMessage> = decode(re.trim_end().as_bytes()).unwrap();
+                    assert_eq!(back.body, env.body, "{}", s.note);
+                }
+                Err(_) => assert!(!s.valid, "{}: rejected but should decode", s.note),
+            },
+            other => panic!("bad fixture direction {other}"),
+        }
+    }
+}
