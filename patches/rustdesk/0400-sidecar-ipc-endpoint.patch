+//! The pipe's security descriptor (docs/IPC.md §2): GENERIC_ALL for the token user of this
+//! process only, i.e. the logged-in user whose `--tray` creates it.
+
+use std::io;
+use windows::core::PCWSTR;
+use windows::Win32::Security::Authorization::ConvertStringSecurityDescriptorToSecurityDescriptorW;
+use windows::Win32::Security::{PSECURITY_DESCRIPTOR, SECURITY_ATTRIBUTES};
+
+const SDDL_REVISION_1: u32 = 1;
+
+/// SDDL `D:P(A;;GA;;;<user SID>)`: protected DACL, one ACE for the current user.
+pub fn user_only_sddl() -> io::Result<String> {
+    let sid = crate::platform::windows::current_process_user_sid_string()
+        .map_err(|e| io::Error::new(io::ErrorKind::Other, format!("no user SID: {e}")))?;
+    if !(sid.starts_with("S-1-") && sid.bytes().all(|b| b.is_ascii_digit() || b == b'-')) {
+        return Err(io::Error::new(io::ErrorKind::Other, "malformed user SID"));
+    }
+    Ok(format!("D:P(A;;GA;;;{sid})"))
+}
+
+/// SECURITY_ATTRIBUTES from [`user_only_sddl`]. Leaked on purpose: it must outlive every pipe
+/// instance created from it.
+pub fn user_only_security_attributes() -> io::Result<*mut SECURITY_ATTRIBUTES> {
+    let sddl = user_only_sddl()?;
+    let wide: Vec<u16> = sddl.encode_utf16().chain(std::iter::once(0)).collect();
+    let mut sd = PSECURITY_DESCRIPTOR::default();
+    // SAFETY: `wide` is NUL-terminated and outlives the call; on success `sd` is a LocalAlloc'd
+    // descriptor that we keep for the life of the process.
+    unsafe {
+        ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            PCWSTR(wide.as_ptr()),
+            SDDL_REVISION_1,
+            &mut sd,
+            None,
+        )
+    }
+    .map_err(|e| io::Error::new(io::ErrorKind::Other, format!("SDDL {sddl}: {e}")))?;
+    let sa = Box::new(SECURITY_ATTRIBUTES {
+        nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+        lpSecurityDescriptor: sd.0,
+        bInheritHandle: false.into(),
+    });
+    Ok(Box::leak(sa) as *mut SECURITY_ATTRIBUTES)
+}
