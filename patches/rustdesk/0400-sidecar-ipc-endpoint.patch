+//! Inbound-session registry (§6.2a, AC-60) and the cold-boot ledger (§6.3, AC-55).
+//!
+//! `server::connection` calls [`opened`] when a connection is authorized and [`closed`] when it
+//! goes away (the `AuthedConnID` RAII guard). Both take one short mutex and wake whoever waits
+//! in [`wait_change`]; they never block on I/O. Anything slow (deciding whether the connection
+//! is a cold-boot login-screen connection and persisting it) runs on a recorder thread.
+
+use hbb_common::log;
+use serde_derive::{Deserialize, Serialize};
+use std::sync::{Condvar, Mutex};
+use std::time::Duration;
+
+/// An authorized inbound connection.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Inbound {
+    pub conn_id: i32,
+    /// The controlling peer's RustDesk ID, as it logged in.
+    pub peer_id: String,
+    /// The name it logged in with (its user/host name).
+    pub name: String,
+    /// Unix seconds.
+    pub since: u64,
+    /// Full remote control (as opposed to file transfer, terminal, camera, port forward).
+    pub remote: bool,
+}
+
+struct Registry {
+    sessions: Vec<Inbound>,
+    generation: u64,
+}
+
+static REGISTRY: Mutex<Registry> = Mutex::new(Registry {
+    sessions: Vec::new(),
+    generation: 0,
+});
+static CHANGED: Condvar = Condvar::new();
+
+pub fn now_secs() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+fn lock() -> std::sync::MutexGuard<'static, Registry> {
+    // A poisoned registry still holds valid data (pushes and retains cannot half-apply).
+    REGISTRY.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// An inbound connection was authorized. Every kind counts as an inbound session for the badge
+/// (over-reporting is the safe side of a security indicator); only `remote` ones count for the
+/// cold-boot ledger.
+pub fn opened(conn_id: i32, remote: bool, peer_id: &str, name: &str) {
+    let entry = Inbound {
+        conn_id,
+        peer_id: peer_id.to_owned(),
+        name: name.to_owned(),
+        since: now_secs(),
+        remote,
+    };
+    {
+        let mut r = lock();
+        r.sessions.retain(|s| s.conn_id != conn_id);
+        r.sessions.push(entry.clone());
+        r.generation = r.generation.wrapping_add(1);
+    }
+    CHANGED.notify_all();
+    if remote {
+        ledger::on_remote_session(entry);
+    }
+}
+
+/// The connection's authorization guard dropped.
+pub fn closed(conn_id: i32) {
+    {
+        let mut r = lock();
+        let before = r.sessions.len();
+        r.sessions.retain(|s| s.conn_id != conn_id);
+        if r.sessions.len() == before {
+            return;
+        }
+        r.generation = r.generation.wrapping_add(1);
+    }
+    CHANGED.notify_all();
+}
+
+/// Current sessions, oldest first, and the registry generation.
+pub fn snapshot() -> (Vec<Inbound>, u64) {
+    let r = lock();
+    (r.sessions.clone(), r.generation)
+}
+
+/// Wait until the registry generation differs from `seen`, or `timeout` passes. Returns the
+/// current generation.
+pub fn wait_change(seen: u64, timeout: Duration) -> u64 {
+    let r = lock();
+    if r.generation != seen {
+        return r.generation;
+    }
+    let (r, _) = CHANGED
+        .wait_timeout_while(r, timeout, |r| r.generation == seen)
+        .unwrap_or_else(|e| e.into_inner());
+    r.generation
+}
+
+/// Bump the generation without a session change, so a waiter in [`wait_change`] re-collects now
+/// (readiness or presence changed).
+pub fn poke() {
+    {
+        let mut r = lock();
+        r.generation = r.generation.wrapping_add(1);
+    }
+    CHANGED.notify_all();
+}
+
+/// The cold-boot ledger: "the host received an authenticated inbound remote session within
+/// [`COLD_BOOT_WINDOW`] after boot, while the machine was at the login screen". Persisted, so
+/// the tray can show "Unattended ready" after any later restart of the app (AC-55).
+pub mod ledger {
+    use super::*;
+
+    /// How long after boot a login-screen connection still proves the unattended path.
+    pub const COLD_BOOT_WINDOW: Duration = Duration::from_secs(15 * 60);
+    pub const FILE_NAME: &str = "remotesmith-unattended.json";
+
+    #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, Default)]
+    pub struct Record {
+        /// Unix seconds when the connection was authorized.
+        pub verified_at: u64,
+        /// Unix seconds of the boot it followed.
+        pub boot_time: u64,
+        /// Seconds from boot to the connection.
+        pub after_boot_secs: u64,
+        pub peer_id: String,
+    }
+
+    /// Pure decision, separated for tests: is a connection at `now` a cold-boot login-screen one?
+    pub fn qualifies(boot_time: Option<u64>, now: u64, at_login_screen: bool) -> Option<u64> {
+        let boot = boot_time?;
+        if !at_login_screen || now < boot {
+            return None;
+        }
+        let after = now - boot;
+        (after <= COLD_BOOT_WINDOW.as_secs()).then_some(after)
+    }
+
+    pub(super) fn on_remote_session(entry: Inbound) {
+        use std::sync::mpsc;
+        use std::sync::OnceLock;
+        static TX: OnceLock<Option<Mutex<mpsc::Sender<Inbound>>>> = OnceLock::new();
+        let tx = TX.get_or_init(|| {
+            let (tx, rx) = mpsc::channel::<Inbound>();
+            let spawned = std::thread::Builder::new()
+                .name("remotesmith-ledger".into())
+                .spawn(move || {
+                    while let Ok(e) = rx.recv() {
+                        record_if_cold_boot(&e);
+                    }
+                });
+            match spawned {
+                Ok(_) => Some(Mutex::new(tx)),
+                Err(err) => {
+                    log::error!("remotesmith: cannot start the cold-boot recorder: {err}");
+                    None
+                }
+            }
+        });
+        if let Some(tx) = tx {
+            if let Ok(tx) = tx.lock() {
+                tx.send(entry).ok();
+            }
+        }
+    }
+
+    fn record_if_cold_boot(e: &Inbound) {
+        // Only a quick check first: most sessions happen long after boot.
+        let boot = boot_time();
+        let now = now_secs();
+        if qualifies(boot, now, true).is_none() {
+            return;
+        }
+        let at_login = at_login_screen();
+        let Some(after) = qualifies(boot, now, at_login) else {
+            log::info!("remotesmith: session {} soon after boot, but not at the login screen", e.conn_id);
+            return;
+        };
+        let rec = Record {
+            verified_at: now,
+            boot_time: boot.unwrap_or_default(),
+            after_boot_secs: after,
+            peer_id: e.peer_id.clone(),
+        };
+        match write(&rec) {
+            Ok(path) => log::info!(
+                "remotesmith: recorded cold-boot login-screen connection ({after}s after boot) in {}",
+                path.display()
+            ),
+            Err(err) => log::error!("remotesmith: cannot record the cold-boot connection: {err}"),
+        }
+    }
+
+    /// Directory of the ledger: system-wide, writable only by the privileged process that sees
+    /// the login screen (root on macOS, SYSTEM on Windows), readable by the user's process.
+    pub fn dir() -> Option<std::path::PathBuf> {
+        #[cfg(target_os = "macos")]
+        {
+            return Some(
+                std::path::Path::new("/Library/Application Support").join(crate::get_app_name()),
+            );
+        }
+        #[cfg(windows)]
+        {
+            let base = std::env::var_os("ProgramData")?;
+            return Some(std::path::Path::new(&base).join(crate::get_app_name()));
+        }
+        #[allow(unreachable_code)]
+        None
+    }
+
+    pub fn path() -> Option<std::path::PathBuf> {
+        dir().map(|d| d.join(FILE_NAME))
+    }
+
+    fn write(rec: &Record) -> std::io::Result<std::path::PathBuf> {
+        let dir = dir().ok_or_else(|| {
+            std::io::Error::new(std::io::ErrorKind::Unsupported, "no ledger location")
+        })?;
+        std::fs::create_dir_all(&dir)?;
+        let path = dir.join(FILE_NAME);
+        let tmp = dir.join(format!("{FILE_NAME}.tmp"));
+        let json = serde_json::to_vec(rec).map_err(std::io::Error::other)?;
+        std::fs::write(&tmp, json)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&tmp, std::fs::Permissions::from_mode(0o644))?;
+        }
+        std::fs::rename(&tmp, &path)?;
+        Ok(path)
+    }
+
+    /// The persisted record, if any. On macOS it must be a regular file owned by root (the only
+    /// writer), so a user process cannot fake "Unattended ready".
+    pub fn read() -> Option<Record> {
+        let path = path()?;
+        let meta = std::fs::symlink_metadata(&path).ok()?;
+        if !meta.file_type().is_file() || meta.len() > 64 * 1024 {
+            return None;
+        }
+        #[cfg(target_os = "macos")]
+        {
+            use std::os::unix::fs::MetadataExt;
+            if meta.uid() != 0 {
+                log::warn!("remotesmith: ignoring {} (not owned by root)", path.display());
+                return None;
+            }
+        }
+        serde_json::from_slice(&std::fs::read(&path).ok()?).ok()
+    }
+
+    /// Unix seconds of the current boot.
+    pub fn boot_time() -> Option<u64> {
+        #[cfg(target_os = "macos")]
+        {
+            use hbb_common::libc;
+            let mut tv = libc::timeval {
+                tv_sec: 0,
+                tv_usec: 0,
+            };
+            let mut len = std::mem::size_of::<libc::timeval>();
+            let mut mib = [libc::CTL_KERN, libc::KERN_BOOTTIME];
+            // SAFETY: sysctl writes at most `len` bytes into `tv`, which is that size.
+            let rc = unsafe {
+                libc::sysctl(
+                    mib.as_mut_ptr(),
+                    2,
+                    &mut tv as *mut _ as *mut libc::c_void,
+                    &mut len,
+                    std::ptr::null_mut(),
+                    0,
+                )
+            };
+            return (rc == 0 && tv.tv_sec > 0).then_some(tv.tv_sec as u64);
+        }
+        #[cfg(windows)]
+        {
+            // SAFETY: no preconditions.
+            let up_ms = unsafe { windows::Win32::System::SystemInformation::GetTickCount64() };
+            return now_secs().checked_sub(up_ms / 1000);
+        }
+        #[cfg(target_os = "linux")]
+        {
+            let s = std::fs::read_to_string("/proc/uptime").ok()?;
+            let up: f64 = s.split_whitespace().next()?.parse().ok()?;
+            return now_secs().checked_sub(up as u64);
+        }
+        #[allow(unreachable_code)]
+        None
+    }
+
+    /// Is the console at the login screen (no user logged in)? Uses upstream's own check.
+    fn at_login_screen() -> bool {
+        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        {
+            return crate::platform::is_prelogin();
+        }
+        #[allow(unreachable_code)]
+        false
+    }
+}
