+//! RemoteSmith-specific policy that does not belong to any one upstream module.
+//!
+//! Kept in its own file so the patches against upstream files stay small (thin fork, §4).
+
+/// RemoteSmith has no update service: upstream's checker asks api.rustdesk.com about stock
+/// RustDesk builds and would offer them as updates (DEF-2, AC-6). Releases are published at
+/// <https://github.com/newtro/RemoteSmith/releases>.
+pub const UPDATE_CHECK_DISABLED: bool = true;
+
+/// Public source repository (AGPL-3.0 corresponding source).
+pub const SOURCE_URL: &str = "https://github.com/newtro/RemoteSmith";
