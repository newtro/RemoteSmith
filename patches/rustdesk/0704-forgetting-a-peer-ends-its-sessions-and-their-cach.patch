+/// RemoteSmith C1 (finding 9, AC-39, AC-43): a session that outlives "Forget peer".
+#[cfg(test)]
+mod remotesmith_forget_tests {
+    use super::*;
+    use crate::remotesmith_trust::{
+        forget,
+        identity::{evaluate, HostIdentity, Verdict, OPTION_FINGERPRINT, OPTION_HOST_ID},
+    };
+
+    /// Removes the (never expected) peer file even when an assertion fails.
+    struct Cleanup(String);
+    impl Drop for Cleanup {
+        fn drop(&mut self) {
+            PeerConfig::remove(&self.0);
+        }
+    }
+
+    #[test]
+    fn a_session_retrying_after_forget_writes_nothing_back_and_enrolls_afresh() {
+        // An ID no real peer has; the stale session must not create its file.
+        let id = format!("remotesmith-forget-test-{}", std::process::id());
+        let _cleanup = Cleanup(id.clone());
+        PeerConfig::remove(&id);
+        let mut lc = LoginConfigHandler::default();
+        lc.id = id.clone();
+        lc.remotesmith_forget_gen = forget::generation(&id);
+        lc.config.options.insert(OPTION_FINGERPRINT.into(), "aaaa bbbb".into());
+        lc.config.options.insert(OPTION_HOST_ID.into(), "123".into());
+        lc.config.password = vec![1, 2, 3];
+        lc.password = b"remembered".to_vec();
+        lc.remember = true;
+        assert!(!lc.remotesmith_forgotten());
+
+        forget::forget(&id);
+        assert!(lc.remotesmith_forgotten());
+        // What handle_peer_info does after the retry logs in: re-save the remembered password.
+        let mut c = lc.load_config();
+        c.password = lc.password.clone();
+        lc.save_config(c);
+        lc.set_option("view-style".into(), "adaptive".into());
+        assert!(!PeerConfig::exists(&id), "a forgotten peer's config was written back");
+        assert_eq!(lc.get_option(OPTION_FINGERPRINT), "aaaa bbbb", "in memory until the gate");
+
+        // The identity gate's first step on the next round: everything remembered is dropped.
+        assert!(lc.remotesmith_reset_if_forgotten());
+        assert!(lc.get_option(OPTION_FINGERPRINT).is_empty());
+        assert!(lc.get_option(OPTION_HOST_ID).is_empty());
+        assert!(lc.password.is_empty() && lc.config.password.is_empty() && !lc.remember);
+        assert!(!lc.remotesmith_forgotten());
+        assert!(!lc.remotesmith_reset_if_forgotten(), "only once");
+        // So whatever answers next is a first use: shown to the user, nothing sent unconfirmed.
+        let offered = HostIdentity {
+            id: "123".into(),
+            fingerprint: "aaaa bbbb".into(),
+        };
+        assert!(matches!(
+            evaluate(
+                &lc.get_option(OPTION_FINGERPRINT),
+                &lc.get_option(OPTION_HOST_ID),
+                Some(&offered)
+            ),
+            Verdict::FirstUse(_)
+        ));
+    }
+}
