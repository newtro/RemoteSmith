index 000000000000..9ce9b4aca83a
--- /dev/null
+++ b/src/remotesmith_trust/forget.rs
@@ -0,0 +1,90 @@
+//! "Forget peer" invalidates what live sessions hold, not just the file (RemoteSmith AC-39,
+//! AC-43).
+//!
+//! Upstream's remove only deletes the peer file. A session to that peer keeps its in-memory
+//! copy (the pinned fingerprint and host ID, the remembered password) and writes it back on the
+//! next save: a session retrying after the forget reconnects on the stale pin, logs in with
+//! the stale password and `handle_peer_info` recreates the file with it, so the peer is never
+//! re-enrolled.
+//!
+//! Each peer ID has a forget generation. A session takes the generation when it starts
+//! (`LoginConfigHandler::initialize`) and may write the peer's config only while it is still
+//! current ([`store_if_current`], which checks and writes under one lock, so a write either
+//! lands before the forget, and is deleted with the file, or not at all). Forgetting bumps the
+//! generation, then closes the peer's live sessions (no retry), then deletes the file. A
+//! session that runs into the identity gate with a stale generation reloads the (now empty)
+//! config and drops its remembered password first ([`LoginConfigHandler::remotesmith_reset_if_forgotten`]),
+//! so whatever connects next enrolls afresh.
+//!
+//! [`LoginConfigHandler::remotesmith_reset_if_forgotten`]: crate::client::LoginConfigHandler::remotesmith_reset_if_forgotten
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+static GENERATIONS: Mutex<Option<HashMap<String, u64>>> = Mutex::new(None);
+
+fn lock() -> std::sync::MutexGuard<'static, Option<HashMap<String, u64>>> {
+    GENERATIONS.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The peer's current forget generation (0 until it is first forgotten).
+pub fn generation(id: &str) -> u64 {
+    lock()
+        .as_ref()
+        .and_then(|m| m.get(id).copied())
+        .unwrap_or(0)
+}
+
+/// Start forgetting `id`: every generation taken before this call is stale from now on.
+/// Returns the new generation.
+pub fn forget(id: &str) -> u64 {
+    let mut g = lock();
+    let e = g.get_or_insert_with(HashMap::new).entry(id.to_owned()).or_insert(0);
+    *e += 1;
+    hbb_common::log::info!("peer {}: forgotten (generation {}); its sessions end", id, *e);
+    *e
+}
+
+/// Whether `generation` (taken by a session) is still current for `id`.
+pub fn is_current(id: &str, generation: u64) -> bool {
+    self::generation(id) == generation
+}
+
+/// Run `store` (a write of `id`'s peer config) only if `generation` is still current, under the
+/// lock [`forget`] takes, so the check and the write cannot straddle a forget. Returns whether it
+/// ran.
+pub fn store_if_current(id: &str, generation: u64, store: impl FnOnce()) -> bool {
+    let g = lock();
+    let current = g.as_ref().and_then(|m| m.get(id).copied()).unwrap_or(0);
+    if current != generation {
+        hbb_common::log::info!(
+            "peer {}: not saving its config: it was forgotten while this session ran",
+            id
+        );
+        return false;
+    }
+    store();
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_forget_makes_older_generations_stale_and_blocks_their_writes() {
+        let id = "forget-test-peer-1";
+        let g0 = generation(id);
+        assert!(is_current(id, g0));
+        let mut wrote = 0;
+        assert!(store_if_current(id, g0, || wrote += 1));
+        let g1 = forget(id);
+        assert_eq!(g1, g0 + 1);
+        assert!(!is_current(id, g0));
+        assert!(!store_if_current(id, g0, || wrote += 1), "stale session cannot write");
+        assert!(store_if_current(id, g1, || wrote += 1), "a session started after may");
+        assert_eq!(wrote, 2);
+        // Other peers are unaffected.
+        assert!(is_current("forget-test-peer-2", generation("forget-test-peer-2")));
+    }
+}
