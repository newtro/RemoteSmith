 pub fn main_remove_peer(id: String) {
+    // RemoteSmith (AC-39, AC-43): "Forget peer" also ends what live sessions hold. The
+    // generation moves first, so no session can write the pin or the password back from here
+    // on; then the peer's sessions are closed for good (a retry in flight is dropped, no new
+    // one starts) and their in-memory copy is dropped; only then is the file deleted.
+    crate::remotesmith_trust::forget::forget(&id);
+    for s in sessions::get_sessions() {
+        if s.lc.read().unwrap().get_id() != id {
+            continue;
+        }
+        s.lc.write().unwrap().remotesmith_reset_if_forgotten();
+        s.close();
+        crate::client::Interface::msgbox(
+            &*s,
+            "error",
+            "Peer forgotten",
+            "remotesmith-peer-forgotten-session-tip",
+            "",
+        );
+    }
     PeerConfig::remove(&id);
 }
 
