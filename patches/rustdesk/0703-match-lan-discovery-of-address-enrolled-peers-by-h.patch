+
+impl SavedPeer {
+    /// Saved by address (IP or host:port): only the direct route reaches it.
+    pub fn is_direct(&self) -> bool {
+        hbb_common::is_ip_str(&self.id) || hbb_common::is_domain_port_str(&self.id)
+    }
+
+    /// The host identity presence matches discovery answers with: the pinned host ID, else the
+    /// connection target.
+    pub fn identity(&self) -> &str {
+        self.host_id.as_deref().unwrap_or(&self.id)
+    }
+
+    /// What the presence prober needs for this peer.
+    pub fn probe(&self) -> presence::Probe {
+        presence::Probe {
+            target: self.id.clone(),
+            host: self.identity().to_owned(),
+            direct: self.is_direct(),
+        }
+    }
+
+    /// Whether this saved peer is the machine itself (by target or by pinned identity).
+    pub fn is_me(&self, my_id: Option<&String>) -> bool {
+        my_id.map_or(false, |me| &self.id == me || self.host_id.as_ref() == Some(me))
+    }
 }
 
