+    /// C1 (finding 7, AC-20): a peer enrolled by address is dialled by its address but answers
+    /// LAN discovery with its host ID; presence maps one to the other through the pin.
+    #[test]
+    fn ip_enrolled_peer_matches_discovery_through_its_pinned_host_id() {
+        let f = "[options]\nremotesmith-host-id = '418222333'\nremotesmith-host-fingerprint = 'aaaa bbbb'\n[info]\nhostname = 'SCOTT-PC'\nplatform = 'Windows'\n";
+        let ip = collect::parse_peer_file("192.168.1.20".into(), Some(5), f).unwrap();
+        assert_eq!(ip.host_id.as_deref(), Some("418222333"));
+        assert!(ip.is_direct());
+        assert_eq!(
+            ip.probe(),
+            presence::Probe { target: "192.168.1.20".into(), host: "418222333".into(), direct: true }
+        );
+        let by_id = collect::parse_peer_file(
+            "555".into(),
+            None,
+            "[options]\nremotesmith-host-id = '555'\n[info]\nplatform = 'Mac OS'\n",
+        )
+        .unwrap();
+        assert!(!by_id.is_direct());
+        assert_eq!(by_id.probe().host, "555");
+        let unpinned = collect::parse_peer_file("10.0.0.9:21118".into(), None, "[info]\nplatform = 'Mac OS'\n").unwrap();
+        assert!(unpinned.is_direct());
+        assert_eq!(unpinned.probe().host, "10.0.0.9:21118");
+
+        let table: Table = Default::default();
+        let peers = vec![ip.probe(), by_id.probe(), unpinned.probe()];
+        // Discovery answered by the IP peer's host ID; the ID server is down (cannot be asked).
+        let lan: HashSet<String> = ["418222333".to_string()].into();
+        presence::apply(&table, &peers, &lan, None);
+        let saved = vec![ip.clone(), by_id.clone(), unpinned.clone()];
+        let facts = super::super::host::HostFacts {
+            online_state: -1,
+            rendezvous_servers: vec!["rs.example.com".into()],
+            my_id: "111".into(),
+            ..Default::default()
+        };
+        let snap = collect::build(Some(&facts), &Readiness::default(), &saved, &table);
+        let presence_of = |id: &str| snap.peers.iter().find(|p| p.id == id).unwrap().presence.clone();
+        assert_eq!(presence_of("192.168.1.20"), Presence::Reachable { route: Route::Lan });
+        assert!(matches!(
+            presence_of("555"),
+            Presence::Unavailable { reason: Reason::ServerUnreachable, .. }
+        ));
+        // Saved by address and silent on the LAN: offline, not "server unreachable" (the ID
+        // server has nothing to do with an address route).
+        assert!(matches!(
+            presence_of("10.0.0.9:21118"),
+            Presence::Unavailable { reason: Reason::Offline, last_seen: None, .. }
+        ));
+
+        // The ID server is asked only about ID-route peers, and an "online" answer never makes
+        // an address-only peer reachable.
+        let online: HashSet<String> = ["555".to_string(), "10.0.0.9:21118".to_string()].into();
+        presence::apply(&table, &peers, &HashSet::new(), Some(&online));
+        let t = table.lock().unwrap().clone();
+        assert_eq!(t["555"].id_online, Some(true));
+        assert_eq!(t["10.0.0.9:21118"].id_online, None);
+        assert!(!t["192.168.1.20"].lan && t["192.168.1.20"].last_seen.is_some(), "last seen kept");
+    }
+
+    #[test]
+    fn a_saved_peer_pinned_to_this_machine_is_not_listed() {
+        let table: Table = Default::default();
+        let saved = vec![collect::SavedPeer {
+            id: "192.168.1.5".into(),
+            host_id: Some("111".into()),
+            ..Default::default()
+        }];
+        let facts = super::super::host::HostFacts { my_id: "111".into(), ..Default::default() };
+        let snap = collect::build(Some(&facts), &Readiness::default(), &saved, &table);
+        assert!(snap.peers.is_empty());
     }
 
     #[test]
