+// ---- First-run provisioning (FLOW-2, AC-40) ---------------------------------------------------
+//
+// A fresh build has no rendezvous server (DEF-2). On first launch the desktop UI asks for the
+// ID server host and its public key, or "Direct LAN only", plus a permanent password, and stores
+// them through upstream's normal option and password paths (the password is hashed and
+// encrypted by upstream's config). Headless setup uses the same keys through the CLI:
+//
+//   RemoteSmith --option custom-rendezvous-server <host[:port]>
+//   RemoteSmith --option key <44-char public key>
+//   RemoteSmith --option remotesmith-lan-only Y        # instead of the two above
+//   RemoteSmith --password <at least 12 characters>
+//
+// Nothing here ever has a default value: the repo is public and must not carry personal
+// infrastructure (DEC-15, AC-33).
+
+/// Option set to "Y" when the user chose direct LAN connections only (no rendezvous server).
+pub const OPTION_LAN_ONLY: &str = "remotesmith-lan-only";
+/// Upstream's option keys for the ID server and its public key.
+pub const OPTION_ID_SERVER: &str = "custom-rendezvous-server";
+pub const OPTION_KEY: &str = "key";
+/// Minimum permanent password length (DEC-10: long random password).
+pub const MIN_PASSWORD_LEN: usize = 12;
+/// Length of passwords made by [`generate_password`].
+pub const GENERATED_PASSWORD_LEN: usize = 20;
+
+/// Checks an ID server address: a host name or IPv4 address with an optional port, or an
+/// IPv6 address as `[address]:port` (the only IPv6 form the client's port handling accepts).
+pub fn validate_server_host(host: &str) -> Result<(), String> {
+    let host = host.trim();
+    if host.is_empty() {
+        return Err("Enter the ID server host.".to_owned());
+    }
+    if host.contains("://") || host.contains('/') {
+        return Err("Enter just the host (and optional :port), without http:// or a path.".to_owned());
+    }
+    if host.chars().any(|c| c.is_whitespace() || c.is_control()) {
+        return Err("The host must not contain spaces.".to_owned());
+    }
+    let (name, port) = if let Some(rest) = host.strip_prefix('[') {
+        // [IPv6] or [IPv6]:port
+        let Some((addr, tail)) = rest.split_once(']') else {
+            return Err("Missing ']' in the IPv6 address.".to_owned());
+        };
+        if addr.parse::<std::net::Ipv6Addr>().is_err() {
+            return Err("Invalid IPv6 address.".to_owned());
+        }
+        match tail.strip_prefix(':') {
+            Some(p) if !p.is_empty() => (addr, Some(p)),
+            _ => return Err("Write an IPv6 server as [address]:port, e.g. [2001:db8::1]:21116.".to_owned()),
+        }
+    } else if host.matches(':').count() > 1 {
+        return Err("Write an IPv6 server as [address]:port, e.g. [2001:db8::1]:21116.".to_owned());
+    } else {
+        match host.split_once(':') {
+            Some((n, p)) => (n, Some(p)),
+            None => (host, None),
+        }
+    };
+    if name.is_empty() {
+        return Err("Enter the ID server host.".to_owned());
+    }
+    if !name.contains(':') {
+        let label_ok = |l: &str| {
+            !l.is_empty()
+                && l.len() <= 63
+                && l.chars().all(|c| c.is_ascii_alphanumeric() || c == '-')
+                && !l.starts_with('-')
+                && !l.ends_with('-')
+        };
+        if name.len() > 253 || !name.trim_end_matches('.').split('.').all(label_ok) {
+            return Err("Invalid host name.".to_owned());
+        }
+    }
+    if let Some(p) = port {
+        match p.parse::<u16>() {
+            Ok(v) if v > 0 => {}
+            _ => return Err("The port must be a number from 1 to 65535.".to_owned()),
+        }
+    }
+    Ok(())
+}
+
+/// Checks a server public key: the 44-character standard base64 encoding of a 32-byte
+/// Ed25519 key, as found in the server's `id_ed25519.pub`.
+pub fn validate_server_key(key: &str) -> Result<(), String> {
+    let key = key.trim();
+    if key.is_empty() {
+        return Err("Enter the server's public key (the contents of id_ed25519.pub).".to_owned());
+    }
+    if key.len() != 44 {
+        return Err(format!(
+            "The key must be 44 characters (it is {}). Copy all of id_ed25519.pub.",
+            key.chars().count()
+        ));
+    }
+    match crate::decode64(key) {
+        Ok(bytes) if bytes.len() == 32 => Ok(()),
+        _ => Err("The key is not a valid base64 Ed25519 public key.".to_owned()),
+    }
+}
+
+/// Checks a new permanent password (DEC-10). Leading and trailing spaces are not counted,
+/// because the desktop UI trims them before saving.
+pub fn validate_permanent_password(password: &str) -> Result<(), String> {
+    let n = password.trim().chars().count();
+    if n < MIN_PASSWORD_LEN {
+        return Err(format!(
+            "The password must be at least {MIN_PASSWORD_LEN} characters (it is {n})."
+        ));
+    }
+    Ok(())
+}
+
+/// Characters for generated passwords: letters and digits without look-alikes (0/O, 1/l/I),
+/// so a password read off a screen can be typed on the other machine.
+const PASSWORD_CHARS: &[u8] = b"23456789abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ";
+
+/// A random permanent password from the OS CSPRNG (~115 bits for 20 characters). It always
+/// has a digit, a lower-case and an upper-case letter, so it also passes the Settings
+/// "Set Password" dialog's rules.
+pub fn generate_password() -> String {
+    use hbb_common::rand::{rngs::OsRng, Rng};
+    let mut rng = OsRng;
+    loop {
+        let p: String = (0..GENERATED_PASSWORD_LEN)
+            .map(|_| PASSWORD_CHARS[rng.gen_range(0..PASSWORD_CHARS.len())] as char)
+            .collect();
+        if p.chars().any(|c| c.is_ascii_digit())
+            && p.chars().any(|c| c.is_ascii_lowercase())
+            && p.chars().any(|c| c.is_ascii_uppercase())
+        {
+            return p;
+        }
+    }
+}
+
+/// The route the machine uses, as stored in its options.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct ProvisioningState {
+    /// `custom-rendezvous-server` (or the server baked into the exe name).
+    pub id_server: String,
+    /// `key` (or the key baked into the exe name).
+    pub key: String,
+    /// `remotesmith-lan-only=Y`.
+    pub lan_only: bool,
+    /// `stop-service=Y`: this machine accepts no incoming connections ("Controller only").
+    pub controller_only: bool,
+    /// A usable permanent password is stored.
+    pub has_permanent_password: bool,
+}
+
+/// Whether first-run setup is still needed (FLOW-2, AC-40). Complete means:
+/// - a route: "Direct LAN only", or a valid ID server host together with a valid key
+///   (a host with a missing or malformed key does not count); and
+/// - either "Controller only" (no incoming connections, so no password is needed) or a
+///   permanent password, the only password RemoteSmith accepts.
+pub fn needs_provisioning(s: &ProvisioningState) -> bool {
+    let route_ok = s.lan_only
+        || (validate_server_host(&s.id_server).is_ok() && validate_server_key(&s.key).is_ok());
+    let incoming_ok = s.controller_only || s.has_permanent_password;
+    !route_ok || !incoming_ok
+}
+
+/// Checks a value given to `--option` for one of the provisioning keys. Other keys pass.
+pub fn validate_option(key: &str, value: &str) -> Result<(), String> {
+    match key {
+        OPTION_ID_SERVER if !value.is_empty() => validate_server_host(value),
+        OPTION_KEY if !value.is_empty() => validate_server_key(value),
+        OPTION_LAN_ONLY if !(value.is_empty() || value == "Y") => {
+            Err(format!("{OPTION_LAN_ONLY} must be Y or empty."))
+        }
+        _ => Ok(()),
+    }
+}
+
+/// The option writes a CLI `--option <key> <value>` turns into, after validation. Choosing
+/// "Direct LAN only" also clears every explicit server, and setting an ID server turns
+/// "Direct LAN only" off, so the stored options never contradict each other.
+pub fn cli_option_writes(key: &str, value: &str) -> Result<Vec<(String, String)>, String> {
+    validate_option(key, value)?;
+    let mut writes = vec![(key.to_owned(), value.to_owned())];
+    if key == OPTION_LAN_ONLY && value == "Y" {
+        for k in [OPTION_ID_SERVER, OPTION_KEY, "relay-server", "api-server"] {
+            writes.push((k.to_owned(), String::new()));
+        }
+    } else if key == OPTION_ID_SERVER && !value.is_empty() {
+        writes.push((OPTION_LAN_ONLY.to_owned(), String::new()));
+    }
+    Ok(writes)
+}
+
+/// Checks a server configuration about to be imported (`--config <exe-name string>`, or the
+/// options of an `--import-config` file): an ID server needs a valid host and a valid key.
+pub fn validate_server_import(host: &str, key: &str) -> Result<(), String> {
+    if host.trim().is_empty() {
+        if key.trim().is_empty() {
+            return Ok(());
+        }
+        return Err("The imported config has a key but no ID server host.".to_owned());
+    }
+    validate_server_host(host)?;
+    if key.trim().is_empty() {
+        return Err("The imported config has an ID server but no key.".to_owned());
+    }
+    validate_server_key(key)
+}
+
+/// Checks the options of a config file given to `--import-config`.
+pub fn validate_imported_options(
+    options: &std::collections::HashMap<String, String>,
+) -> Result<(), String> {
+    let get = |k: &str| options.get(k).map(String::as_str).unwrap_or_default();
+    validate_server_import(get(OPTION_ID_SERVER), get(OPTION_KEY))?;
+    validate_option(OPTION_LAN_ONLY, get(OPTION_LAN_ONLY))
+}
+
+/// Builds the provisioning state from an options map (as the service reports it).
+pub fn state_from_options(
+    options: &std::collections::HashMap<String, String>,
+    has_permanent_password: bool,
+) -> ProvisioningState {
+    let get = |k: &str| options.get(k).cloned().unwrap_or_default();
+    ProvisioningState {
+        id_server: get(OPTION_ID_SERVER),
+        key: get(OPTION_KEY),
+        lan_only: get(OPTION_LAN_ONLY) == "Y",
+        controller_only: hbb_common::config::option2bool(
+            OPTION_STOP_SERVICE,
+            &get(OPTION_STOP_SERVICE),
+        ),
+        has_permanent_password,
+    }
+}
+
+/// Upstream's "stop service" option: no rendezvous registration, no direct-IP listener.
+pub const OPTION_STOP_SERVICE: &str = "stop-service";
+
+/// Reads the live provisioning state, from the service over IPC where it runs, otherwise from
+/// the local config (the same files the user-level service writes).
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub fn provisioning_needed() -> bool {
+    let options = crate::ipc::get_options();
+    let has_password = match crate::ipc::get_config("permanent-password-set") {
+        Ok(Some(v)) => v.trim() == "Y",
+        _ => hbb_common::config::Config::has_permanent_password(),
+    };
+    #[allow(unused_mut)]
+    let mut state = state_from_options(&options, has_password);
+    #[cfg(windows)]
+    if state.id_server.is_empty() {
+        // A server baked into the exe name (upstream's custom-server naming) counts as set.
+        if let Ok(lic) = crate::platform::windows::get_license_from_exe_name() {
+            state.id_server = lic.host;
+            state.key = lic.key;
+        }
+    }
+    needs_provisioning(&state)
+}
