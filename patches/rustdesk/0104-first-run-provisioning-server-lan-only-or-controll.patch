index 000000000000..0b9854ea5191
--- /dev/null
+++ b/flutter/lib/desktop/widgets/remotesmith_setup.dart
@@ -0,0 +1,319 @@
+// RemoteSmith first-run setup (FLOW-2, AC-40).
+//
+// A fresh build has no rendezvous server. On first launch this asks for the ID server host and
+// its public key (or "Direct LAN only") and a permanent password (or "Controller only", which
+// turns incoming connections off with upstream's stop-service option), then stores them through the
+// same option and password calls the Settings page uses. Validation lives in Rust
+// (src/remotesmith.rs) so the CLI applies the same rules. Nothing is prefilled: the repo is
+// public and carries no personal infrastructure.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:get/get.dart';
+
+const String kRemoteSmithOptionLanOnly = 'remotesmith-lan-only';
+// Upstream's "stop service": no rendezvous registration and no direct-IP listener, so the
+// machine accepts no incoming connections. Settings > General > "Start service" undoes it,
+// after which this setup asks for the permanent password.
+const String kRemoteSmithOptionStopService = 'stop-service';
+const String kRemoteSmithSetupDialogTag = 'remotesmith-setup';
+
+bool _setupShowing = false;
+
+/// Shows the setup dialog when no route (server + key, or LAN only) is set, or when the machine
+/// accepts incoming connections but has no permanent password.
+Future<void> showRemoteSmithSetupIfNeeded() async {
+  if (_setupShowing || bind.isOutgoingOnly()) return;
+  if (!await bind.mainRemotesmithNeedsProvisioning()) return;
+  _setupShowing = true;
+  try {
+    await _showSetupDialog();
+  } finally {
+    _setupShowing = false;
+  }
+}
+
+Future<void> _showSetupDialog() async {
+  final host = TextEditingController(
+      text: await bind.mainGetOption(key: 'custom-rendezvous-server'));
+  final key = TextEditingController(text: await bind.mainGetOption(key: 'key'));
+  // Kept as they are (or taken from a pasted config): the dialog only edits host and key.
+  var relayServer = await bind.mainGetOption(key: 'relay-server');
+  var apiServer = await bind.mainGetOption(key: 'api-server');
+  final p0 = TextEditingController();
+  final p1 = TextEditingController();
+  final passwordAlreadySet =
+      (await bind.mainGetCommon(key: 'permanent-password-set')) == 'true';
+  var lanOnly =
+      (await bind.mainGetOption(key: kRemoteSmithOptionLanOnly)) == 'Y';
+  var controllerOnly =
+      (await bind.mainGetOption(key: kRemoteSmithOptionStopService)) == 'Y';
+  var obscure = true;
+  var serverErr = '';
+  var passErr = '';
+  var confirmErr = '';
+  var saving = false;
+  final maxLength = bind.mainMaxEncryptLen();
+
+  await gFFI.dialogManager.show((setState, close, context) {
+    Future<void> pasteConfig() async {
+      final data = await Clipboard.getData(Clipboard.kTextPlain);
+      final text = data?.text?.trim() ?? '';
+      if (text.isEmpty) return;
+      try {
+        // The export format of Settings > Network > ID/Relay server.
+        final sc = ServerConfig.decode(text);
+        setState(() {
+          host.text = sc.idServer;
+          key.text = sc.key;
+          relayServer = sc.relayServer;
+          apiServer = sc.apiServer;
+          lanOnly = false;
+          serverErr = '';
+        });
+      } catch (_) {
+        setState(() => serverErr =
+            'The clipboard does not hold an exported server config.');
+      }
+    }
+
+    void generate() {
+      final p = bind.mainRemotesmithGeneratePassword();
+      setState(() {
+        p0.text = p;
+        p1.text = p;
+        obscure = false;
+        passErr = '';
+        confirmErr = '';
+      });
+    }
+
+    Future<void> submit() async {
+      if (saving) return;
+      setState(() {
+        serverErr = '';
+        passErr = '';
+        confirmErr = '';
+      });
+      if (!lanOnly) {
+        final err = bind.mainRemotesmithValidateServer(
+            host: host.text.trim(), key: key.text.trim());
+        if (err.isNotEmpty) {
+          setState(() => serverErr = err);
+          return;
+        }
+      }
+      final pass = p0.text.trim();
+      final changePassword =
+          !controllerOnly && (pass.isNotEmpty || !passwordAlreadySet);
+      if (changePassword) {
+        final err = bind.mainRemotesmithValidatePassword(password: pass);
+        if (err.isNotEmpty) {
+          setState(() => passErr = err);
+          return;
+        }
+        if (p1.text.trim() != pass) {
+          setState(() =>
+              confirmErr = translate('The confirmation is not identical.'));
+          return;
+        }
+      }
+      setState(() => saving = true);
+      var closed = false;
+      try {
+        if (lanOnly) {
+          // No server at all: also drop any relay/API server so nothing is contacted.
+          await setServerConfig(null, null, ServerConfig());
+          await bind.mainSetOption(key: kRemoteSmithOptionLanOnly, value: 'Y');
+        } else {
+          await setServerConfig(
+              null,
+              null,
+              ServerConfig(
+                  idServer: host.text.trim(),
+                  key: key.text.trim(),
+                  relayServer: relayServer,
+                  apiServer: apiServer));
+          await bind.mainSetOption(key: kRemoteSmithOptionLanOnly, value: '');
+        }
+        if (changePassword) {
+          final ok =
+              await bind.mainSetPermanentPasswordWithResult(password: pass);
+          if (!ok) {
+            setState(() => passErr =
+                'Could not save the password. Is the RemoteSmith service running?');
+            return;
+          }
+        }
+        final stopped =
+            (await bind.mainGetOption(key: kRemoteSmithOptionStopService)) ==
+                'Y';
+        if (stopped != controllerOnly) {
+          await bind.mainSetOption(
+              key: kRemoteSmithOptionStopService,
+              value: controllerOnly ? 'Y' : '');
+        }
+        if (await bind.mainRemotesmithNeedsProvisioning()) {
+          setState(() => serverErr =
+              'Settings were not saved. Is the RemoteSmith service running?');
+          return;
+        }
+        closed = true;
+        close();
+      } finally {
+        if (!closed) setState(() => saving = false);
+      }
+    }
+
+    Widget radio(bool value, String label) => RadioListTile<bool>(
+          dense: true,
+          contentPadding: EdgeInsets.zero,
+          value: value,
+          groupValue: lanOnly,
+          title: Text(label),
+          onChanged: (v) => setState(() {
+            lanOnly = v ?? false;
+            serverErr = '';
+          }),
+        );
+
+    return CustomAlertDialog(
+      title: Row(children: [
+        Icon(Icons.settings_ethernet, color: MyTheme.accent),
+        Text('Set up ${bind.mainGetAppNameSync()}').paddingOnly(left: 10),
+      ]),
+      contentBoxConstraints: const BoxConstraints(minWidth: 500, maxWidth: 560),
+      // Scrolls when the window is small (the default 800x600 window cannot fit it all).
+      content: SingleChildScrollView(
+          child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(
+            'RemoteSmith has no built-in server. Use your own ID/relay server '
+            '(hbbs/hbbr) for connections from outside your network, or connect '
+            'directly on the LAN only.',
+            style: const TextStyle(fontSize: 13),
+          ).marginOnly(bottom: 8),
+          radio(false, 'Use my ID server'),
+          if (!lanOnly) ...[
+            TextField(
+              controller: host,
+              autofocus: true,
+              decoration: const InputDecoration(
+                  labelText: 'ID server host', hintText: 'host or host:port'),
+              onChanged: (_) => setState(() => serverErr = ''),
+            ),
+            TextField(
+              controller: key,
+              decoration: InputDecoration(
+                  labelText: 'Server public key',
+                  hintText: '44 characters, from id_ed25519.pub',
+                  errorText: serverErr.isNotEmpty ? serverErr : null,
+                  errorMaxLines: 3),
+              onChanged: (_) => setState(() => serverErr = ''),
+            ),
+            Align(
+              alignment: Alignment.centerRight,
+              child: TextButton.icon(
+                onPressed: pasteConfig,
+                icon: const Icon(Icons.content_paste, size: 16),
+                label: const Text('Paste exported config'),
+              ),
+            ),
+          ],
+          radio(true, 'Direct LAN only (no server)'),
+          if (lanOnly && serverErr.isNotEmpty)
+            Text(serverErr, style: const TextStyle(color: Colors.red)),
+          const Divider(height: 24),
+          CheckboxListTile(
+            dense: true,
+            contentPadding: EdgeInsets.zero,
+            controlAffinity: ListTileControlAffinity.leading,
+            value: controllerOnly,
+            title: const Text('Controller only'),
+            subtitle: const Text(
+                'This machine only controls others and never accepts incoming '
+                'connections, so it needs no password. To host later, use '
+                'Settings > General > Start service; you will then be asked for a password.'),
+            onChanged: (v) => setState(() {
+              controllerOnly = v ?? false;
+              passErr = '';
+              confirmErr = '';
+            }),
+          ),
+          if (!controllerOnly) ...[
+            Text(
+              passwordAlreadySet
+                  ? 'A permanent password is already set. Leave these empty to keep it.'
+                  : 'Set the permanent password other machines use to connect '
+                      '(at least 12 characters). The one-time password is disabled.',
+              style: const TextStyle(fontSize: 13),
+            ),
+            Row(children: [
+              Expanded(
+                child: TextField(
+                  controller: p0,
+                  obscureText: obscure,
+                  maxLength: maxLength,
+                  decoration: InputDecoration(
+                      labelText: translate('Password'),
+                      errorText: passErr.isNotEmpty ? passErr : null,
+                      counterText: '',
+                      errorMaxLines: 3),
+                  onChanged: (_) => setState(() => passErr = ''),
+                ),
+              ),
+              IconButton(
+                tooltip: obscure ? 'Show' : 'Hide',
+                icon: Icon(obscure ? Icons.visibility : Icons.visibility_off),
+                onPressed: () => setState(() => obscure = !obscure),
+              ),
+              IconButton(
+                tooltip: 'Copy',
+                icon: const Icon(Icons.copy),
+                onPressed: p0.text.isEmpty
+                    ? null
+                    : () {
+                        Clipboard.setData(ClipboardData(text: p0.text));
+                        showToast(translate('Copied'));
+                      },
+              ),
+            ]),
+            TextField(
+              controller: p1,
+              obscureText: obscure,
+              maxLength: maxLength,
+              decoration: InputDecoration(
+                  labelText: translate('Confirmation'),
+                  errorText: confirmErr.isNotEmpty ? confirmErr : null,
+                  counterText: ''),
+              onChanged: (_) => setState(() => confirmErr = ''),
+              onSubmitted: (_) => submit(),
+            ),
+            Align(
+              alignment: Alignment.centerLeft,
+              child: TextButton.icon(
+                onPressed: generate,
+                icon: const Icon(Icons.casino_outlined, size: 16),
+                label: const Text('Generate a strong password'),
+              ),
+            ),
+            const Text(
+              'Store the password in your password manager.',
+              style: TextStyle(fontSize: 12),
+            ),
+          ],
+        ],
+      )),
+      actions: [
+        dialogButton('Save',
+            icon: const Icon(Icons.done_rounded),
+            onPressed: saving ? null : submit),
+      ],
+      onSubmit: submit,
+    );
+  }, tag: kRemoteSmithSetupDialogTag);
+}
