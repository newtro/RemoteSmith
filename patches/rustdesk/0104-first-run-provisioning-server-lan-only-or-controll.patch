@@ -9,3 +9,484 @@ pub const UPDATE_CHECK_DISABLED: bool = true;
 
 /// Public source repository (AGPL-3.0 corresponding source).
 pub const SOURCE_URL: &str = "https://github.com/newtro/RemoteSmith";
