+//! "Server unreachable" within 10 s (RemoteSmith AC-45, §8 "Lightsail down").
+//!
+//! A connect by ID first has to reach the ID server: upstream allows `CONNECT_TIMEOUT` (18 s)
+//! for the TCP connect alone, after DNS, STUN and WebRTC setup, so with the server blackholed
+//! the user waits about 20 s for a generic error. RemoteSmith bounds that phase only: from the
+//! start of the connect (LAN-first attempt included) until the rendezvous connection is up. Once
+//! the server answered, the punch, relay and data timeouts are upstream's, unchanged. Routes
+//! that never use the server (an IP or host:port) leave the phase at once.
+
+use hbb_common::{anyhow::anyhow, tokio, ResultType};
+use std::future::Future;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::Duration;
+
+/// The bound on reaching the ID server (AC-45).
+pub const SERVER_DEADLINE: Duration = Duration::from_secs(10);
+
+/// The error a connect ends with when the ID server was not reached in time. Starts with the
+/// reason the user sees; contains "failed" so a first connect is not auto-retried (upstream's
+/// rule for failed connects), while a dropped session's reconnect streak still retries it.
+pub const SERVER_UNREACHABLE: &str = "Server unreachable: the ID server did not answer within 10 s, so connecting failed. Check the network, or connect by the peer's LAN IP address.";
+
+/// The error for a rendezvous connect that failed outright (refused: the VM is up but hbbs is
+/// stopped; no route; the name does not resolve) before the deadline: the same reason, with the
+/// cause.
+pub fn unreachable_because(cause: &dyn std::fmt::Display) -> hbb_common::anyhow::Error {
+    anyhow!(
+        "Server unreachable: cannot connect to the ID server ({}), so connecting failed. Check the network, or connect by the peer's LAN IP address.",
+        cause
+    )
+}
+
+/// Shared between the connect and its bound: set once the server phase is over.
+#[derive(Clone, Default, Debug)]
+pub struct Phase(Arc<AtomicBool>);
+
+impl Phase {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// The rendezvous connection is up, or this route does not use the server.
+    pub fn done(&self) {
+        self.0.store(true, Ordering::SeqCst);
+    }
+
+    pub fn is_done(&self) -> bool {
+        self.0.load(Ordering::SeqCst)
+    }
+}
+
+/// Run `connect`, but fail it with [`SERVER_UNREACHABLE`] if `phase` is not done within
+/// `deadline`. After that the connect runs to its own end.
+pub async fn bound<T>(
+    phase: &Phase,
+    deadline: Duration,
+    connect: impl Future<Output = ResultType<T>>,
+) -> ResultType<T> {
+    tokio::pin!(connect);
+    tokio::select! {
+        r = &mut connect => return r,
+        _ = tokio::time::sleep(deadline) => {}
+    }
+    if !phase.is_done() {
+        hbb_common::log::warn!("ID server not reached within {:?}; giving up", deadline);
+        return Err(anyhow!(SERVER_UNREACHABLE));
+    }
+    connect.await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Instant;
+
+    #[tokio::test]
+    async fn an_unreached_server_fails_at_the_deadline() {
+        let phase = Phase::new();
+        let t = Instant::now();
+        let r: ResultType<()> = bound(&phase, Duration::from_millis(200), std::future::pending()).await;
+        let took = t.elapsed();
+        assert_eq!(r.unwrap_err().to_string(), SERVER_UNREACHABLE);
+        assert!(took >= Duration::from_millis(200) && took < Duration::from_millis(1000), "{took:?}");
+        assert!(SERVER_UNREACHABLE.to_lowercase().starts_with("server unreachable"));
+        // Not retried on a first connect (upstream: "failed" texts are final).
+        assert!(!crate::client::check_if_retry("error", "Connection Error", SERVER_UNREACHABLE, false));
+    }
+
+    #[tokio::test]
+    async fn once_the_server_answered_the_connect_keeps_its_own_timeouts() {
+        let phase = Phase::new();
+        let p = phase.clone();
+        let r = bound(&phase, Duration::from_millis(100), async move {
+            p.done();
+            // Punch/relay take longer than the server bound: not cut.
+            tokio::time::sleep(Duration::from_millis(300)).await;
+            Ok(7)
+        })
+        .await;
+        assert_eq!(r.unwrap(), 7);
+    }
+
+    #[test]
+    fn a_refused_server_reads_as_server_unreachable_too() {
+        let e = unreachable_because(&"Connection refused (os error 61)").to_string();
+        assert!(e.starts_with("Server unreachable: "), "{e}");
+        assert!(e.contains("Connection refused (os error 61)"));
+        assert!(!crate::client::check_if_retry("error", "Connection Error", &e, false));
+    }
+
+    #[tokio::test]
+    async fn a_fast_result_or_error_passes_through() {
+        let phase = Phase::new();
+        assert_eq!(bound(&phase, SERVER_DEADLINE, async { Ok(1) }).await.unwrap(), 1);
+        let e = bound::<()>(&phase, SERVER_DEADLINE, async { Err(anyhow!("Remote desktop is offline")) })
+            .await
+            .unwrap_err();
+        assert_eq!(e.to_string(), "Remote desktop is offline");
+    }
+
+    /// The real rendezvous connect against a blackholed address (TEST-NET-1, never routed):
+    /// upstream's 18 s connect is cut at the bound.
+    #[tokio::test]
+    async fn a_blackholed_rendezvous_connect_is_cut_at_the_bound() {
+        let phase = Phase::new();
+        let p = phase.clone();
+        let t = Instant::now();
+        let r = bound(&phase, Duration::from_millis(500), async move {
+            let s = hbb_common::socket_client::connect_tcp(
+                "192.0.2.1:21116",
+                hbb_common::config::CONNECT_TIMEOUT,
+            )
+            .await?;
+            p.done();
+            Ok(s)
+        })
+        .await;
+        let took = t.elapsed();
+        // Either the bound fired, or this network refused at once (no route): never 18 s.
+        assert!(took < Duration::from_secs(3), "{took:?}");
+        assert!(r.is_err(), "connected to TEST-NET-1");
+    }
+}
