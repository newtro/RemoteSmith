@@ -0,0 +1,142 @@
+// RemoteSmith unit B3: peer identity (trust on first use) dialogs.
+// Rust side: src/remotesmith_trust/{identity,reconnect}.rs. Kept in its own file so
+// upstream's common.dart carries only the hook in msgBox().
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+
+/// Whether [type] is one of the msgbox types rendered here.
+bool isRemoteSmithTrustMsgbox(String type) =>
+    type.startsWith('remotesmith-identity');
+
+void showRemoteSmithTrustMsgbox(SessionID sessionId, String type, String title,
+    String text, OverlayDialogManager dialogManager) {
+  dialogManager.dismissAll();
+  _identityDialog(sessionId, type, title, text, dialogManager);
+}
+
+Widget _row(String label, String value) {
+  return Padding(
+    padding: const EdgeInsets.symmetric(vertical: 3),
+    child: Row(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        SizedBox(
+          width: 130,
+          child: Text('${translate(label)}:',
+              style: const TextStyle(fontWeight: FontWeight.bold)),
+        ),
+        Expanded(
+          child: SelectableText(value.isEmpty ? 'N/A' : value,
+              style: const TextStyle(fontFamily: 'monospace')),
+        ),
+      ],
+    ),
+  );
+}
+
+void _identityDialog(SessionID sessionId, String type, String title,
+    String text, OverlayDialogManager dialogManager) {
+  Map<String, dynamic> info = {};
+  try {
+    info = jsonDecode(text) as Map<String, dynamic>;
+  } catch (_) {}
+  String field(String k) => (info[k] ?? '').toString();
+  final peer = field('peer');
+  final id = field('id');
+  final fingerprint = field('fingerprint');
+  final pinnedId = field('pinned_id');
+  final pinnedFingerprint = field('pinned_fingerprint');
+  final isConfirm = type.startsWith('remotesmith-identity-confirm');
+
+  void answer(bool yes) {
+    // Bound to this prompt and the identity shown, so it can only confirm
+    // exactly what the user compared.
+    unawaited(bind.sessionSetCommon(
+        sessionId: sessionId,
+        key: 'remotesmith-identity',
+        value: jsonEncode({
+          'prompt': field('prompt'),
+          'id': id,
+          'fingerprint': fingerprint,
+          'answer': yes ? 'Y' : 'N',
+        })));
+    dialogManager.dismissAll();
+    if (!yes) {
+      closeConnection();
+    } else {
+      // Rust drops the stream that waited on this dialog and logs in on a fresh
+      // one, which must prove the key just pinned.
+      dialogManager.showLoading(translate('Connecting...'),
+          onCancel: closeConnection);
+    }
+  }
+
+  Future<void> forgetPeer() async {
+    // Deletes the peer's saved config: the pinned fingerprint and the saved
+    // password go with it (AC-39, AC-43). The next connection enrolls afresh.
+    if (peer.isNotEmpty) {
+      await bind.mainRemovePeer(id: peer);
+    }
+    dialogManager.dismissAll();
+    closeConnection();
+    showToast(translate('remotesmith-peer-forgotten'));
+  }
+
+  void close() {
+    dialogManager.dismissAll();
+    closeConnection();
+  }
+
+  final String tip;
+  if (isConfirm) {
+    tip = 'remotesmith-identity-confirm-tip';
+  } else if (fingerprint.isEmpty) {
+    tip = 'remotesmith-identity-unavailable-tip';
+  } else {
+    tip = 'remotesmith-identity-mismatch-tip';
+  }
+
+  dialogManager.show(
+    (setState, dismiss, context) => CustomAlertDialog(
+      title: Text(translate(title)),
+      content: SelectionArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(translate(tip)),
+            const SizedBox(height: 12),
+            if (!isConfirm && pinnedFingerprint.isNotEmpty) ...[
+              _row('remotesmith-saved-id', pinnedId),
+              _row('remotesmith-saved-fingerprint', pinnedFingerprint),
+              const SizedBox(height: 8),
+            ],
+            if (id.isNotEmpty) _row('ID', id),
+            if (fingerprint.isNotEmpty) _row('Fingerprint', fingerprint),
+          ],
+        ),
+      ),
+      actions: isConfirm
+          ? [
+              dialogButton('Cancel',
+                  onPressed: () => answer(false), isOutline: true),
+              dialogButton('remotesmith-trust-and-connect',
+                  onPressed: () => answer(true)),
+            ]
+          : [
+              if (pinnedFingerprint.isNotEmpty)
+                dialogButton('remotesmith-forget-peer',
+                    onPressed: forgetPeer, isOutline: true),
+              dialogButton('Close', onPressed: close),
+            ],
+      // Enter must never trust a key by accident; Esc declines.
+      onSubmit: isConfirm ? null : close,
+      onCancel: isConfirm ? () => answer(false) : close,
+    ),
+    tag: '$sessionId-$type',
+  );
+}
