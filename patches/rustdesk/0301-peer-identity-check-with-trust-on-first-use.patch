diff --git a/src/remotesmith_trust/identity.rs b/src/remotesmith_trust/identity.rs
new file mode 100644
index 000000000000..36d1e4ffbd18
--- /dev/null
+++ b/src/remotesmith_trust/identity.rs
@@ -0,0 +1,620 @@
+//! Peer identity, trust on first use (RemoteSmith DEF-3, §7, AC-37, AC-43).
+//!
+//! A peer is its stable RustDesk ID plus the fingerprint of its Ed25519 signing key (the key
+//! the host registers with hbbs and signs its handshake with). The fingerprint uses upstream's
+//! format ([`crate::common::pk_to_fingerprint`]), so it is the value the host shows in its own
+//! settings ("Fingerprint" under About) and over `ipc::get_fingerprint()`.
+//!
+//! Where the key comes from:
+//! - ID routes (hole punch, relay): hbbs signs the host's registered key, and
+//!   `Client::secure_connection` verifies the host's handshake with it.
+//! - Direct routes (an IP, or the LAN-first attempt): there is no server signature, so the
+//!   host sends its signing key in `SignedId.remotesmith_identity_pk` and signs the handshake
+//!   with it ([`direct_handshake`]). The key is only as good as the pin it is compared with,
+//!   which is exactly trust on first use.
+//!
+//! Either way the identity counts only when the stream ended up keyed by that handshake
+//! (`Stream::is_secured`): a handshake that fell back to plaintext proves nothing.
+//!
+//! The pin lives in the peer's own config (`PeerConfig.options`), so "Forget peer" (removing the
+//! peer) deletes it together with the saved password.
+
+use hbb_common::{
+    anyhow::anyhow,
+    bail, log,
+    protobuf::Message as _,
+    sodiumoxide::crypto::sign,
+    tcp::{kx_version_for, KxTranscript},
+    timeout, ResultType, Stream,
+};
+use base::message_proto::*;
+
+/// Peer option holding the pinned host key fingerprint.
+pub const OPTION_FINGERPRINT: &str = "remotesmith-host-fingerprint";
+/// Peer option holding the RustDesk ID the pinned host signed. For a peer saved by ID it equals
+/// the peer ID; for a peer saved by IP it is what makes "this IP now belongs to another machine"
+/// detectable (AC-37).
+pub const OPTION_HOST_ID: &str = "remotesmith-host-id";
+
+/// The identity a host proved during the handshake.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct HostIdentity {
+    pub id: String,
+    pub fingerprint: String,
+}
+
+impl HostIdentity {
+    pub fn new(id: &str, sign_pk: &[u8]) -> Self {
+        Self {
+            id: id.to_owned(),
+            fingerprint: fingerprint(sign_pk),
+        }
+    }
+}
+
+/// Upstream's display format: lowercase hex in groups of four.
+pub fn fingerprint(sign_pk: &[u8]) -> String {
+    crate::common::pk_to_fingerprint(sign_pk.to_vec())
+}
+
+fn normalize(fp: &str) -> String {
+    fp.chars()
+        .filter(|c| !c.is_whitespace() && *c != ':')
+        .map(|c| c.to_ascii_lowercase())
+        .collect()
+}
+
+/// The decision for one connection, made before any password-derived data is sent.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Verdict {
+    /// Pinned and matching: log in.
+    Trusted,
+    /// No pin yet: show ID and fingerprint and wait for the user to confirm (AC-43).
+    FirstUse(HostIdentity),
+    /// Same peer, different key: a reinstalled host or an impostor. Stop (AC-37).
+    KeyMismatch {
+        pinned: String,
+        offered: HostIdentity,
+    },
+    /// The pinned host's ID differs from the one that answered: the saved address now belongs to
+    /// another machine. Stop (AC-37).
+    IdMismatch {
+        pinned: String,
+        offered: HostIdentity,
+    },
+    /// The host proved no identity (a stock host, a key-less server, or a handshake that fell
+    /// back to plaintext). Stop: there is nothing to pin or to compare with.
+    Unavailable { enrolled: bool },
+}
+
+/// Compare what the host proved with the pin. `pinned_id` may be empty for pins written before
+/// the ID was stored; the fingerprint is what binds.
+pub fn evaluate(pinned_fp: &str, pinned_id: &str, offered: Option<&HostIdentity>) -> Verdict {
+    let enrolled = !normalize(pinned_fp).is_empty();
+    let Some(offered) = offered else {
+        return Verdict::Unavailable { enrolled };
+    };
+    if normalize(&offered.fingerprint).is_empty() {
+        return Verdict::Unavailable { enrolled };
+    }
+    if !enrolled {
+        return Verdict::FirstUse(offered.clone());
+    }
+    if normalize(pinned_fp) != normalize(&offered.fingerprint) {
+        return Verdict::KeyMismatch {
+            pinned: pinned_fp.to_owned(),
+            offered: offered.clone(),
+        };
+    }
+    if !pinned_id.is_empty() && pinned_id != offered.id {
+        return Verdict::IdMismatch {
+            pinned: pinned_id.to_owned(),
+            offered: offered.clone(),
+        };
+    }
+    Verdict::Trusted
+}
+
+/// The identity a secured stream proved: `sign_pk` is the host's signing key (verified by hbbs
+/// on ID routes, pinned by us on direct ones) and `signed_id` the ID it signed.
+pub fn proven_identity(
+    is_secured: bool,
+    signed_id: &str,
+    sign_pk: Option<&[u8]>,
+) -> Option<HostIdentity> {
+    match sign_pk {
+        Some(pk) if is_secured && pk.len() == sign::PUBLICKEYBYTES && !signed_id.is_empty() => {
+            Some(HostIdentity::new(signed_id, pk))
+        }
+        _ => None,
+    }
+}
+
+/// Msgbox types the Flutter UI renders with RemoteSmith's identity dialogs.
+pub const MSGBOX_CONFIRM: &str = "remotesmith-identity-confirm-nocancel";
+pub const MSGBOX_MISMATCH: &str = "remotesmith-identity-mismatch-nocancel";
+
+fn dialog_text(
+    peer: &str,
+    offered: Option<&HostIdentity>,
+    pinned: Option<(&str, &str)>,
+    prompt: Option<&str>,
+) -> String {
+    let mut v = hbb_common::serde_json::json!({ "peer": peer });
+    if let Some(p) = prompt {
+        v["prompt"] = p.into();
+    }
+    if let Some(o) = offered {
+        v["id"] = o.id.clone().into();
+        v["fingerprint"] = o.fingerprint.clone().into();
+    }
+    if let Some((id, fp)) = pinned {
+        v["pinned_id"] = id.into();
+        v["pinned_fingerprint"] = fp.into();
+    }
+    v.to_string()
+}
+
+/// What the caller does with the stream after [`gate`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Gate {
+    /// The host is the pinned one: log in on this stream.
+    Proceed,
+    /// Refused or not confirmed: close, do not log in.
+    Stop,
+    /// The user just confirmed a first use. The stream sat unread while they compared
+    /// fingerprints (long enough for the host to time it out), so it is dropped unused and a
+    /// fresh connection must log in; that one passes only if it proves the key just pinned.
+    Reconfirm,
+}
+
+/// The user's answer to one first-use prompt, as the UI sends it: JSON with the prompt id and
+/// the host ID and fingerprint it showed. `Some(yes)` only if it answers exactly this prompt for
+/// exactly this identity; anything else (another prompt's answer, e.g. a concurrent port-forward
+/// mapping's, or a stale one) is not an answer to this prompt.
+pub fn parse_answer(prompt: &str, shown: &HostIdentity, answer: &str) -> Option<bool> {
+    let v: hbb_common::serde_json::Value = hbb_common::serde_json::from_str(answer).ok()?;
+    let field = |k: &str| v.get(k).and_then(|x| x.as_str()).unwrap_or_default().to_owned();
+    if field("prompt") != prompt
+        || field("id") != shown.id
+        || normalize(&field("fingerprint")) != normalize(&shown.fingerprint)
+    {
+        return None;
+    }
+    match field("answer").as_str() {
+        "Y" => Some(true),
+        "N" => Some(false),
+        _ => None,
+    }
+}
+
+/// Commit a confirmed first-use pin only if the pin has not changed since the prompt was shown
+/// (compare-and-set): still empty, or already this very identity. Another identity pinned
+/// meanwhile (say by a concurrent prompt) is not overwritten; the caller stops instead.
+pub fn may_commit_pin(current_fp: &str, current_id: &str, confirmed: &HostIdentity) -> bool {
+    matches!(
+        evaluate(current_fp, current_id, Some(confirmed)),
+        Verdict::FirstUse(_) | Verdict::Trusted
+    )
+}
+
+/// The pre-login identity gate, run on every new stream before the host's `Hash` is read, so
+/// no password-derived data can leave before it passes.
+///
+/// `sign_pk` is the host signing key `Client::start` returned for this stream. On first use it
+/// asks the user (AC-43) and pins only after a yes; the credential is saved later by the normal
+/// login path on the fresh connection, so it too exists only after confirmation. There is no
+/// exemption (switch-sides included): every unpinned host is confirmed by the user.
+pub async fn gate(
+    interface: &impl crate::client::Interface,
+    receiver: &mut hbb_common::tokio::sync::mpsc::UnboundedReceiver<crate::client::Data>,
+    is_secured: bool,
+    sign_pk: Option<&[u8]>,
+) -> Gate {
+    let (peer, signed_id, pinned_fp, pinned_id) = {
+        let lc = interface.get_lch();
+        let lc = lc.read().unwrap();
+        (
+            interface.get_id(),
+            lc.remotesmith_signed_id.clone(),
+            lc.get_option(OPTION_FINGERPRINT),
+            lc.get_option(OPTION_HOST_ID),
+        )
+    };
+    let offered = proven_identity(is_secured, &signed_id, sign_pk);
+    match evaluate(&pinned_fp, &pinned_id, offered.as_ref()) {
+        Verdict::Trusted => {
+            if pinned_id.is_empty() {
+                if let Some(o) = &offered {
+                    let lc = interface.get_lch();
+                    lc.write()
+                        .unwrap()
+                        .set_option(OPTION_HOST_ID.to_owned(), o.id.clone());
+                }
+            }
+            Gate::Proceed
+        }
+        Verdict::FirstUse(o) => {
+            log::info!(
+                "peer {}: first connection, host {} key {}; asking to confirm",
+                peer,
+                o.id,
+                o.fingerprint
+            );
+            let prompt = uuid::Uuid::new_v4().to_string();
+            interface.msgbox(
+                MSGBOX_CONFIRM,
+                "Confirm peer identity",
+                &dialog_text(&peer, Some(&o), None, Some(&prompt)),
+                "",
+            );
+            loop {
+                match receiver.recv().await {
+                    Some(crate::client::Data::RemoteSmithIdentity(answer)) => {
+                        match parse_answer(&prompt, &o, &answer) {
+                            Some(true) => break,
+                            Some(false) => {
+                                log::info!("peer {}: identity not confirmed, not logging in", peer);
+                                return Gate::Stop;
+                            }
+                            // Not an answer to this prompt.
+                            None => log::warn!("peer {}: ignoring an identity answer for another prompt", peer),
+                        }
+                    }
+                    Some(crate::client::Data::Close) | None => {
+                        log::info!("peer {}: identity not confirmed, not logging in", peer);
+                        return Gate::Stop;
+                    }
+                    // Anything the UI queued meanwhile (input included) is dropped.
+                    Some(_) => {}
+                }
+            }
+            let lc = interface.get_lch();
+            let mut lc = lc.write().unwrap();
+            // Compare-and-set under the write lock: the pin may have changed while we waited.
+            let (cur_fp, cur_id) = (
+                lc.get_option(OPTION_FINGERPRINT),
+                lc.get_option(OPTION_HOST_ID),
+            );
+            if !may_commit_pin(&cur_fp, &cur_id, &o) {
+                log::warn!(
+                    "peer {}: pin changed to host {:?} key {:?} while confirming {} {}; not pinning",
+                    peer,
+                    cur_id,
+                    cur_fp,
+                    o.id,
+                    o.fingerprint
+                );
+                return Gate::Stop;
+            }
+            lc.set_option(OPTION_FINGERPRINT.to_owned(), o.fingerprint.clone());
+            lc.set_option(OPTION_HOST_ID.to_owned(), o.id.clone());
+            log::info!(
+                "peer {}: identity confirmed and pinned; reconnecting to log in",
+                peer
+            );
+            Gate::Reconfirm
+        }
+        Verdict::KeyMismatch { offered: o, .. } | Verdict::IdMismatch { offered: o, .. } => {
+            log::warn!(
+                "peer {}: identity mismatch (pinned host {:?} key {:?}, answered host {} key {}); \
+                 not sending the saved password",
+                peer,
+                pinned_id,
+                pinned_fp,
+                o.id,
+                o.fingerprint
+            );
+            interface.msgbox(
+                MSGBOX_MISMATCH,
+                "Peer identity mismatch",
+                &dialog_text(&peer, Some(&o), Some((&pinned_id, &pinned_fp)), None),
+                "",
+            );
+            Gate::Stop
+        }
+        Verdict::Unavailable { enrolled } => {
+            log::warn!(
+                "peer {}: the host proved no identity (enrolled: {}); not logging in",
+                peer,
+                enrolled
+            );
+            interface.msgbox(
+                MSGBOX_MISMATCH,
+                "Peer identity unavailable",
+                &dialog_text(&peer, None, Some((&pinned_id, &pinned_fp)), None),
+                "",
+            );
+            Gate::Stop
+        }
+    }
+}
+
+/// Controller side of the handshake on a direct route (no hbbs signature available).
+///
+/// Reads the host's `SignedId`, takes the signing key the host sent with it, checks the
+/// signature and, when `expected_id` is given, the signed ID, then sends our half of the key
+/// exchange and keys `conn`. Returns `(signed_id, sign_pk)`. Every failure is an error: unlike
+/// upstream's ID-route fallback, a direct route never continues in plaintext.
+pub async fn direct_handshake(
+    conn: &mut Stream,
+    expected_id: Option<&str>,
+    read_timeout_ms: u64,
+) -> ResultType<(String, Vec<u8>)> {
+    let bytes = match timeout(read_timeout_ms, conn.next()).await {
+        Ok(Some(Ok(bytes))) => bytes,
+        Ok(Some(Err(err))) => bail!("identity handshake: {}", err),
+        Ok(None) => bail!("Reset by the peer"),
+        Err(_) => bail!("identity handshake: the peer sent no identity"),
+    };
+    let msg = Message::parse_from_bytes(&bytes)
+        .map_err(|_| anyhow!("identity handshake: malformed message"))?;
+    let Some(message::Union::SignedId(si)) = msg.union else {
+        bail!("identity handshake: the peer sent no identity");
+    };
+    let sign_pk: [u8; sign::PUBLICKEYBYTES] = si
+        .remotesmith_identity_pk
+        .as_ref()
+        .try_into()
+        .map_err(|_| anyhow!("identity handshake: the peer sent no identity key"))?;
+    let (id, their_pk_b, _dtls, kx_version) =
+        crate::common::decode_id_pk_dtls(&si.id, &sign::PublicKey(sign_pk))
+            .map_err(|_| anyhow!("identity handshake: signature mismatch"))?;
+    if let Some(expected) = expected_id {
+        if id != expected {
+            bail!(
+                "identity handshake: expected peer {} but {} answered",
+                expected,
+                id
+            );
+        }
+    }
+    let (asymmetric_value, symmetric_value, key) =
+        crate::common::create_symmetric_key_msg(their_pk_b);
+    let picked = kx_version_for(kx_version);
+    let mut msg_out = Message::new();
+    msg_out.set_public_key(PublicKey {
+        asymmetric_value: asymmetric_value.clone(),
+        symmetric_value,
+        kx_version: picked,
+        ..Default::default()
+    });
+    timeout(read_timeout_ms, conn.send(&msg_out)).await??;
+    conn.set_negotiated_key(
+        key,
+        true,
+        &KxTranscript {
+            initiator_pk: &asymmetric_value,
+            responder_pk: &their_pk_b,
+            advertised: kx_version,
+            picked,
+        },
+    )?;
+    log::info!("direct route: peer {} proved its identity key", id);
+    Ok((id, sign_pk.to_vec()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hbb_common::{
+        rendezvous_proto::IdPk,
+        socket_client::connect_tcp,
+        sodiumoxide::crypto::box_,
+        tcp::{Encrypt, FramedStream, KX_VERSION_LATEST},
+        tokio::{self, sync::oneshot},
+    };
+
+    fn ident(id: &str, fp: &str) -> HostIdentity {
+        HostIdentity {
+            id: id.to_owned(),
+            fingerprint: fp.to_owned(),
+        }
+    }
+
+    #[test]
+    fn first_use_when_nothing_is_pinned() {
+        let offered = ident("123", "abcd ef01");
+        assert_eq!(
+            evaluate("", "", Some(&offered)),
+            Verdict::FirstUse(offered.clone())
+        );
+    }
+
+    #[test]
+    fn matching_pin_is_trusted_regardless_of_spacing_and_case() {
+        let offered = ident("123", "abcd ef01");
+        assert_eq!(evaluate("ABCDEF01", "123", Some(&offered)), Verdict::Trusted);
+        assert_eq!(evaluate("ab:cd:ef:01", "", Some(&offered)), Verdict::Trusted);
+    }
+
+    #[test]
+    fn a_different_key_is_a_mismatch_even_with_the_same_id() {
+        let offered = ident("123", "ffff 0000");
+        assert!(matches!(
+            evaluate("abcd ef01", "123", Some(&offered)),
+            Verdict::KeyMismatch { .. }
+        ));
+    }
+
+    #[test]
+    fn the_same_key_answering_under_another_id_is_a_mismatch() {
+        let offered = ident("999", "abcd ef01");
+        assert!(matches!(
+            evaluate("abcd ef01", "123", Some(&offered)),
+            Verdict::IdMismatch { .. }
+        ));
+    }
+
+    #[test]
+    fn no_identity_is_never_trusted() {
+        assert_eq!(
+            evaluate("abcd", "123", None),
+            Verdict::Unavailable { enrolled: true }
+        );
+        assert_eq!(evaluate("", "", None), Verdict::Unavailable { enrolled: false });
+        assert_eq!(
+            evaluate("", "", Some(&ident("1", " "))),
+            Verdict::Unavailable { enrolled: false }
+        );
+    }
+
+    #[test]
+    fn an_answer_binds_to_its_prompt_and_the_identity_shown() {
+        let shown = ident("123", "abcd ef01");
+        let ans = |p: &str, id: &str, fp: &str, a: &str| {
+            hbb_common::serde_json::json!({"prompt": p, "id": id, "fingerprint": fp, "answer": a})
+                .to_string()
+        };
+        assert_eq!(parse_answer("p1", &shown, &ans("p1", "123", "abcd ef01", "Y")), Some(true));
+        assert_eq!(parse_answer("p1", &shown, &ans("p1", "123", "ABCDEF01", "N")), Some(false));
+        // Another prompt's answer (a concurrent mapping) confirms nothing here.
+        assert_eq!(parse_answer("p1", &shown, &ans("p2", "123", "abcd ef01", "Y")), None);
+        // An answer about another key or host confirms nothing.
+        assert_eq!(parse_answer("p1", &shown, &ans("p1", "123", "ffff 0000", "Y")), None);
+        assert_eq!(parse_answer("p1", &shown, &ans("p1", "999", "abcd ef01", "Y")), None);
+        assert_eq!(parse_answer("p1", &shown, "Y"), None);
+        assert_eq!(parse_answer("p1", &shown, &ans("p1", "123", "abcd ef01", "")), None);
+    }
+
+    #[test]
+    fn a_confirmed_pin_never_overwrites_another_pinned_meanwhile() {
+        let a = ident("123", "aaaa 0001");
+        assert!(may_commit_pin("", "", &a));
+        assert!(may_commit_pin("aaaa0001", "123", &a));
+        // Key B got pinned by another prompt while A's dialog was open.
+        assert!(!may_commit_pin("bbbb 0002", "123", &a));
+        assert!(!may_commit_pin("aaaa 0001", "999", &a));
+    }
+
+    #[test]
+    fn identity_counts_only_on_a_secured_stream() {
+        let pk = [7u8; 32];
+        assert!(proven_identity(false, "1", Some(&pk)).is_none());
+        assert!(proven_identity(true, "1", Some(&pk[..31])).is_none());
+        assert!(proven_identity(true, "", Some(&pk)).is_none());
+        let id = proven_identity(true, "1", Some(&pk)).unwrap();
+        assert_eq!(id.fingerprint, fingerprint(&pk));
+        assert_eq!(id.id, "1");
+    }
+
+    /// What the stand-in host does with its identity in the handshake.
+    #[derive(Clone, Copy)]
+    enum Host {
+        /// As the patched host: sends its signing key and signs with it.
+        Honest,
+        /// Sends no identity at all, like an unpatched host's direct listener.
+        Silent,
+        /// Sends one key but signs with another.
+        WrongKey,
+    }
+
+    /// A stand-in host on loopback. Returns its address, its signing key and, once the
+    /// controller answered, whether the key exchange completed.
+    async fn host_stub(id: &'static str, mode: Host) -> (String, Vec<u8>, oneshot::Receiver<bool>) {
+        let (sign_pk, sign_sk) = sign::gen_keypair();
+        let (_, other_sk) = sign::gen_keypair();
+        let listener = hbb_common::tcp::new_listener("127.0.0.1:0", false)
+            .await
+            .unwrap();
+        let host = listener.local_addr().unwrap().to_string();
+        let (tx, rx) = oneshot::channel();
+        tokio::spawn(async move {
+            let (stream, addr) = listener.accept().await.unwrap();
+            let mut s = FramedStream::from(stream, addr);
+            if matches!(mode, Host::Silent) {
+                tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+                tx.send(false).ok();
+                return;
+            }
+            let (our_pk_b, our_sk_b) = box_::gen_keypair();
+            let signer = if matches!(mode, Host::WrongKey) {
+                &other_sk
+            } else {
+                &sign_sk
+            };
+            let id_pk = IdPk {
+                id: id.to_owned(),
+                pk: our_pk_b.0.to_vec().into(),
+                kx_version: KX_VERSION_LATEST,
+                ..Default::default()
+            }
+            .write_to_bytes()
+            .unwrap();
+            let mut msg = Message::new();
+            msg.set_signed_id(SignedId {
+                id: sign::sign(&id_pk, signer).into(),
+                remotesmith_identity_pk: sign_pk.0.to_vec().into(),
+                ..Default::default()
+            });
+            s.send(&msg).await.unwrap();
+            let ok = match s.next().await {
+                Some(Ok(bytes)) => match Message::parse_from_bytes(&bytes).ok().and_then(|m| m.union)
+                {
+                    Some(message::Union::PublicKey(pk)) => {
+                        Encrypt::decode(&pk.symmetric_value, &pk.asymmetric_value, &our_sk_b)
+                            .is_ok()
+                    }
+                    _ => false,
+                },
+                _ => false,
+            };
+            tx.send(ok).ok();
+        });
+        (host, sign_pk.0.to_vec(), rx)
+    }
+
+    #[tokio::test]
+    async fn direct_handshake_returns_the_key_the_host_signed_with() {
+        let (host, sign_pk, done) = host_stub("123456789", Host::Honest).await;
+        let mut conn = connect_tcp(host, 3000).await.unwrap();
+        let (id, pk) = direct_handshake(&mut conn, Some("123456789"), 3000)
+            .await
+            .unwrap();
+        assert_eq!(id, "123456789");
+        assert_eq!(pk, sign_pk);
+        assert!(conn.is_secured());
+        assert!(done.await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn direct_handshake_without_expected_id_accepts_and_reports_the_signed_id() {
+        let (host, _, _done) = host_stub("555", Host::Honest).await;
+        let mut conn = connect_tcp(host, 3000).await.unwrap();
+        let (id, _) = direct_handshake(&mut conn, None, 3000).await.unwrap();
+        assert_eq!(id, "555");
+    }
+
+    #[tokio::test]
+    async fn direct_handshake_refuses_another_machine_at_the_address() {
+        let (host, _, done) = host_stub("999", Host::Honest).await;
+        let mut conn = connect_tcp(host, 3000).await.unwrap();
+        let err = direct_handshake(&mut conn, Some("123"), 3000)
+            .await
+            .unwrap_err();
+        assert!(err.to_string().contains("expected peer 123"), "{err}");
+        assert!(!conn.is_secured());
+        drop(conn);
+        assert!(!done.await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn direct_handshake_refuses_a_signature_by_another_key() {
+        let (host, _, _done) = host_stub("123", Host::WrongKey).await;
+        let mut conn = connect_tcp(host, 3000).await.unwrap();
+        assert!(direct_handshake(&mut conn, Some("123"), 3000).await.is_err());
+        assert!(!conn.is_secured());
+    }
+
+    #[tokio::test]
+    async fn direct_handshake_times_out_on_a_host_without_identity() {
+        let (host, _, _done) = host_stub("123", Host::Silent).await;
+        let mut conn = connect_tcp(host, 3000).await.unwrap();
+        let start = std::time::Instant::now();
+        let err = direct_handshake(&mut conn, Some("123"), 300)
+            .await
+            .unwrap_err();
+        assert!(err.to_string().contains("no identity"), "{err}");
+        assert!(start.elapsed() < std::time::Duration::from_millis(1500));
+    }
+}
