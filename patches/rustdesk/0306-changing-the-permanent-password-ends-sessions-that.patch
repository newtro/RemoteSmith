@@ -0,0 +1,85 @@
+//! Ending sessions when the host's permanent password changes (RemoteSmith AC-39).
+//!
+//! Upstream leaves every session up when the password changes, so a controller that logged in
+//! with the old password keeps control (and a 30 s reconnect could ride the old session). Each
+//! change of the stored permanent password bumps an epoch. Every authenticated connection
+//! remembers an epoch: a permanent-password login the one taken before the stored password was
+//! read for it, any other login the one at authorization. Its once-a-second timer closes it
+//! with a no-retry reason once the epoch moved on, and a login whose epoch is already stale at
+//! validation or authorization is refused. The controller then needs the new
+//! password; its reconnect policy never retries that close reason.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static EPOCH: AtomicU64 = AtomicU64::new(0);
+
+/// The current epoch.
+pub fn current() -> u64 {
+    EPOCH.load(Ordering::SeqCst)
+}
+
+/// Compare the stored permanent password before and after an update and move the epoch on if it
+/// changed. Returns whether it did.
+pub fn note_storage_change(before: &str, after: &str) -> bool {
+    if before == after {
+        return false;
+    }
+    let e = EPOCH.fetch_add(1, Ordering::SeqCst) + 1;
+    hbb_common::log::info!(
+        "permanent password changed (epoch {}); ending sessions that used the old one",
+        e
+    );
+    true
+}
+
+/// `Some(epoch)` if the password has not changed since `epoch` was taken (before the stored
+/// password was read for a login), else `None`: that login used a password that is gone.
+pub fn validated_in(epoch: u64) -> Option<u64> {
+    (epoch == current()).then_some(epoch)
+}
+
+/// Whether a 30 s resume entry (the host's recent-session cache) made in `entry_epoch` may still
+/// let a reconnect in without the password: only if the password has not changed since.
+pub fn resume_entry_valid(entry_epoch: u64) -> bool {
+    entry_epoch == current()
+}
+
+/// Whether an authenticated connection recorded in `authed_epoch` must end now.
+pub fn is_stale(authed_epoch: Option<u64>) -> bool {
+    matches!(authed_epoch, Some(e) if e != current())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_real_change_ends_sessions_that_used_the_old_password() {
+        let before = current();
+        let authed = Some(before);
+        assert!(!note_storage_change("same", "same"));
+        assert!(!is_stale(authed));
+        assert!(note_storage_change("old", "new"));
+        assert!(is_stale(authed));
+        // A login after the change uses the new password and stays.
+        assert!(!is_stale(Some(current())));
+        // A connection with no recorded epoch (not authenticated) is not affected.
+        assert!(!is_stale(None));
+
+        // One test, not two: the epoch is process-global and tests run in parallel.
+        // A change between reading the password and recording the login is caught:
+        // validate_password takes the epoch, then reads the stored (old) password ...
+        let taken = current();
+        // ... the password changes before the login is recorded ...
+        assert!(note_storage_change("old-storage", "new-storage"));
+        // ... so the old-password login is refused instead of landing on the new epoch.
+        assert_eq!(validated_in(taken), None);
+        // A resume entry from before the change no longer lets a reconnect in.
+        assert!(!resume_entry_valid(taken));
+        // A login validated after the change is recorded with the new epoch and stays.
+        let fresh = current();
+        assert_eq!(validated_in(fresh), Some(fresh));
+        assert!(resume_entry_valid(fresh));
+        assert!(!is_stale(validated_in(fresh)));
+    }
+}
