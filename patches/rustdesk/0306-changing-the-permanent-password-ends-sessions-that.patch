@@ -0,0 +1,56 @@
+//! Ending sessions when the host's permanent password changes (RemoteSmith AC-39).
+//!
+//! Upstream leaves every session up when the password changes, so a controller that logged in
+//! with the old password keeps control (and a 30 s reconnect could ride the old session). Each
+//! change of the stored permanent password bumps an epoch; a connection that authenticated with
+//! the permanent password remembers the epoch it did so in, and its once-a-second timer closes
+//! it with a no-retry reason once the epoch moved on. The controller then needs the new
+//! password; its reconnect policy never retries that close reason.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static EPOCH: AtomicU64 = AtomicU64::new(0);
+
+/// The current epoch.
+pub fn current() -> u64 {
+    EPOCH.load(Ordering::SeqCst)
+}
+
+/// Compare the stored permanent password before and after an update and move the epoch on if it
+/// changed. Returns whether it did.
+pub fn note_storage_change(before: &str, after: &str) -> bool {
+    if before == after {
+        return false;
+    }
+    let e = EPOCH.fetch_add(1, Ordering::SeqCst) + 1;
+    hbb_common::log::info!(
+        "permanent password changed (epoch {}); ending sessions that used the old one",
+        e
+    );
+    true
+}
+
+/// Whether a connection that authenticated with the permanent password in `authed_epoch` must
+/// end now.
+pub fn is_stale(authed_epoch: Option<u64>) -> bool {
+    matches!(authed_epoch, Some(e) if e != current())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_real_change_ends_sessions_that_used_the_old_password() {
+        let before = current();
+        let authed = Some(before);
+        assert!(!note_storage_change("same", "same"));
+        assert!(!is_stale(authed));
+        assert!(note_storage_change("old", "new"));
+        assert!(is_stale(authed));
+        // A login after the change uses the new password and stays.
+        assert!(!is_stale(Some(current())));
+        // A session that never used the permanent password is never affected.
+        assert!(!is_stale(None));
+    }
+}
