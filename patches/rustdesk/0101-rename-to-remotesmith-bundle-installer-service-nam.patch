+#[cfg(test)]
+mod remotesmith_branding_tests {
+    use super::*;
+
+    fn script(name: &str) -> String {
+        correct_app_name(
+            PRIVILEGES_SCRIPTS_DIR
+                .get_file(name)
+                .and_then(|f| f.contents_utf8())
+                .unwrap(),
+        )
+    }
+
+    // DEC-15: launchd labels, plist paths, the bundle path and the preferences dir all carry
+    // the RemoteSmith name and org, and nothing still says RustDesk or com.carriez.
+    #[test]
+    fn privileged_scripts_are_renamed() {
+        let full = crate::get_full_name();
+        assert_eq!(full, "ai.johnnycode.RemoteSmith");
+        for name in [
+            "daemon.plist",
+            "agent.plist",
+            "install.scpt",
+            "update.scpt",
+            "uninstall.scpt",
+        ] {
+            let s = script(name);
+            assert!(!s.contains("carriez"), "{name}: {s}");
+            assert!(!s.contains("RustDesk") && !s.contains("rustdesk"), "{name}: {s}");
+        }
+        assert!(script("daemon.plist").contains(&format!("<string>{full}_service</string>")));
+        assert!(script("agent.plist").contains(&format!("<string>{full}_server</string>")));
+        assert!(script("agent.plist")
+            .contains("/Applications/RemoteSmith.app/Contents/MacOS/RemoteSmith"));
+        let install = script("install.scpt");
+        assert!(install.contains(&format!("/LaunchDaemons/{full}_service.plist")));
+        // install.scpt copies the user's config to root's: it must be Config's own directory.
+        let config_dir = hbb_common::config::Config::file()
+            .parent()
+            .unwrap()
+            .file_name()
+            .unwrap()
+            .to_string_lossy()
+            .to_string();
+        assert_eq!(config_dir, full);
+        assert!(install.contains(&format!("/Library/Preferences/{full}/")));
+    }
+}
