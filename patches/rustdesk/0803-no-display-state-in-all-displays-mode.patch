diff --git a/flutter/lib/remotesmith/display_topology.dart b/flutter/lib/remotesmith/display_topology.dart
new file mode 100644
index 000000000000..95a1518c70ab
--- /dev/null
+++ b/flutter/lib/remotesmith/display_topology.dart
@@ -0,0 +1,43 @@
+/// RemoteSmith display topology policy (DEF-5, AC-52).
+///
+/// Upstream only noticed an empty display list when a single display was selected; in
+/// All-displays mode it kept the last frame and the old display geometry. The empty case is now
+/// decided first, whatever the view mode.
+library;
+
+/// What to do when the host reports a new display list.
+enum DisplaysUpdate {
+  /// No display left: show "No display available" and release held input.
+  noDisplay,
+
+  /// The current selection (one display, or all of them) still exists: refresh the view.
+  updateView,
+
+  /// The selected display is gone but others remain: switch to a remaining one.
+  switchDisplay,
+}
+
+/// [currentDisplay] is the selected display index, or [allDisplaysValue] in All-displays mode.
+DisplaysUpdate displaysUpdate({
+  required int displayCount,
+  required int currentDisplay,
+  required int allDisplaysValue,
+}) {
+  if (displayCount <= 0) return DisplaysUpdate.noDisplay;
+  if (currentDisplay == allDisplaysValue) return DisplaysUpdate.updateView;
+  if (currentDisplay >= 0 && currentDisplay < displayCount) {
+    return DisplaysUpdate.updateView;
+  }
+  return DisplaysUpdate.switchDisplay;
+}
+
+/// The mouse buttons held in a Flutter pointer `buttons` bitmask, by their RustDesk names
+/// (kPrimaryButton, kSecondaryButton, kMiddleMouseButton, kBackMouseButton,
+/// kForwardMouseButton).
+List<String> heldMouseButtons(int buttons) => [
+      if (buttons & 0x01 != 0) 'left',
+      if (buttons & 0x02 != 0) 'right',
+      if (buttons & 0x04 != 0) 'wheel',
+      if (buttons & 0x08 != 0) 'back',
+      if (buttons & 0x10 != 0) 'forward',
+    ];
diff --git a/flutter/test/remotesmith_display_topology_test.dart b/flutter/test/remotesmith_display_topology_test.dart
new file mode 100644
index 000000000000..b86c537e55f6
--- /dev/null
+++ b/flutter/test/remotesmith_display_topology_test.dart
@@ -0,0 +1,35 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/remotesmith/display_topology.dart';
+
+void main() {
+  const all = -1;
+  DisplaysUpdate decide(int count, int current) => displaysUpdate(
+      displayCount: count, currentDisplay: current, allDisplaysValue: all);
+
+  test('the last display going away is the no-display state in every view mode', () {
+    // AC-52: All-displays mode used to skip this and keep a frozen frame.
+    expect(decide(0, all), DisplaysUpdate.noDisplay);
+    expect(decide(0, 0), DisplaysUpdate.noDisplay);
+    expect(decide(0, 2), DisplaysUpdate.noDisplay);
+  });
+
+  test('a remaining selection refreshes the view', () {
+    expect(decide(1, all), DisplaysUpdate.updateView);
+    expect(decide(3, all), DisplaysUpdate.updateView);
+    expect(decide(2, 0), DisplaysUpdate.updateView);
+    expect(decide(2, 1), DisplaysUpdate.updateView);
+  });
+
+  test('a removed selected display switches to a remaining one', () {
+    expect(decide(1, 1), DisplaysUpdate.switchDisplay);
+    expect(decide(2, 5), DisplaysUpdate.switchDisplay);
+    expect(decide(2, -7), DisplaysUpdate.switchDisplay);
+  });
+
+  test('held buttons are decoded from the pointer bitmask', () {
+    expect(heldMouseButtons(0), isEmpty);
+    expect(heldMouseButtons(0x01), ['left']);
+    expect(heldMouseButtons(0x03), ['left', 'right']);
+    expect(heldMouseButtons(0x1f), ['left', 'right', 'wheel', 'back', 'forward']);
+  });
+}
