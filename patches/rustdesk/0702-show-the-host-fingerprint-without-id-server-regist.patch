 /// The host's public-key fingerprint in the format RustDesk shows it (`ipc` config
-/// "fingerprint"), once the key is confirmed by the rendezvous server.
+/// "fingerprint"): the key this host signs every handshake with (`server::identity_handshake`),
+/// which is what a controller pins on first use on the direct route and what hbbs vouches for
+/// on ID routes.
+///
+/// RemoteSmith: shown whether or not an ID server ever confirmed the key. Upstream waits for
+/// `key_confirmed` (set by an ID-server registration), so a LAN-only host that never registered
+/// had nothing to compare with during enrollment (FLOW-2, AC-43). Generates the key pair if
+/// there is none yet, exactly as the first handshake would.
 pub fn key_fingerprint() -> Option<String> {
-    if Config::get_key_confirmed() {
-        let pk = Config::get_key_pair().1;
-        if !pk.is_empty() {
-            return Some(crate::common::pk_to_fingerprint(pk));
-        }
-    }
-    None
+    fingerprint_of(&Config::get_key_pair().1)
+}
+
+/// `pk`'s fingerprint, or `None` for a missing or malformed key.
+pub fn fingerprint_of(pk: &[u8]) -> Option<String> {
+    crate::remotesmith_trust::identity::own_fingerprint(pk)
 }
 
