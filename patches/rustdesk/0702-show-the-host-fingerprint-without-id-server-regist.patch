 }
 
+/// The fingerprint a host shows for its own signing key `pk` (the key its handshake signs
+/// with), or `None` for a missing or malformed key. Independent of ID-server registration
+/// (FLOW-2, AC-43): a LAN-only host is enrolled by this very value.
+pub fn own_fingerprint(pk: &[u8]) -> Option<String> {
+    (pk.len() == sign::PUBLICKEYBYTES).then(|| fingerprint(pk))
+}
