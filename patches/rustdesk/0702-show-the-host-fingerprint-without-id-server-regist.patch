+    /// C1 (finding 3, FLOW-2, AC-43): two fresh LAN-only hosts (each a new key pair that no ID
+    /// server ever confirmed) each show a fingerprint, the two differ, and each is exactly the
+    /// value a controller pins from that host's direct handshake.
+    #[tokio::test]
+    async fn lan_only_hosts_show_the_fingerprint_the_direct_handshake_pins() {
+        let mut shown = Vec::new();
+        for id in ["100000001", "100000002"] {
+            let (pk, sk) = sign::gen_keypair();
+            let on_host = crate::remotesmith::host::fingerprint_of(&pk.0)
+                .expect("a never-registered host still shows its fingerprint");
+            let (host, _, done) =
+                super::test_support::host_stub_keyed(id, Host::Honest, (pk, sk)).await;
+            let mut conn = connect_tcp(host, 3000).await.unwrap();
+            let (signed_id, sign_pk) = direct_handshake(&mut conn, None, 3000).await.unwrap();
+            let offered = proven_identity(conn.is_secured(), &signed_id, Some(&sign_pk)).unwrap();
+            assert_eq!(offered.fingerprint, on_host, "the controller pins what the host shows");
+            assert_eq!(evaluate("", "", Some(&offered)), Verdict::FirstUse(offered.clone()));
+            assert!(done.await.unwrap());
+            shown.push(on_host);
+        }
+        assert_ne!(shown[0], shown[1]);
+        assert_eq!(crate::remotesmith::host::fingerprint_of(&[1, 2, 3]), None);
+        assert_eq!(crate::remotesmith::host::fingerprint_of(&[]), None);
+    }
