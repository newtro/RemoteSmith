 use hbb_common::protobuf::EnumOrUnknown;
 use std::collections::{BTreeMap, BTreeSet};
 
+/// Peer silence after which a connection that holds input down is treated as lost. The
+/// controller answers the host's TestDelay every second, so this is ten missed heartbeats:
+/// ordinary relay or Wi-Fi stalls stay well under it, and a drag or held modifier survives them.
+/// Without held input upstream's 30 s timeout applies unchanged.
+pub const HOLDING_LOSS_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(10);
+
+/// Whether the host should end the connection now: it holds input down and the peer has been
+/// silent past [`HOLDING_LOSS_TIMEOUT`]. Ending it (rather than releasing and carrying on) keeps
+/// both sides consistent: the controller reconnects and sends its real key and button state.
+pub fn treat_as_lost(silence: std::time::Duration, holding: bool) -> bool {
+    holding && silence >= HOLDING_LOSS_TIMEOUT
+}
