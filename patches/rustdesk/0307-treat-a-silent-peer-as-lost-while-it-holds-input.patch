+    #[test]
+    fn delayed_heartbeats_with_a_held_modifier_and_a_drag_keep_the_session() {
+        use std::time::Duration;
+        let mut h = HeldInput::default();
+        h.on_key(&ck(ControlKey::Shift, true), false);
+        h.on_mouse(&mouse(MOUSE_TYPE_DOWN, MOUSE_BUTTON_LEFT, 5, 5));
+        let holding = !h.is_empty();
+        // A relay stall: heartbeats arrive late, but within the loss threshold.
+        for late_ms in [1_500u64, 3_000, 5_000, 9_900] {
+            assert!(!treat_as_lost(Duration::from_millis(late_ms), holding), "{late_ms}");
+        }
+        // Nothing has been released meanwhile: the drag and the modifier are still held.
+        assert!(!h.is_empty());
+        // Ten missed heartbeats: lost; the teardown then releases both.
+        assert!(treat_as_lost(HOLDING_LOSS_TIMEOUT, holding));
+        let (m, k) = h.take_releases();
+        assert_eq!((m.len(), k.len()), (1, 1));
+    }
+
+    #[test]
+    fn without_held_input_silence_is_left_to_upstream() {
+        assert!(!treat_as_lost(std::time::Duration::from_secs(25), false));
+    }
