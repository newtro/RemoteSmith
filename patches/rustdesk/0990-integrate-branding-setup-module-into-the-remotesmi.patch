+    /// Round-2 gate: a cancelled privilege prompt with an existing password must not close
+    /// setup as "Controller only" while hosting stays on.
+    #[test]
+    fn controller_only_requires_confirmed_stop() {
+        let with_password = |stop: &str| {
+            state_from_options(
+                &opts(&[(OPTION_LAN_ONLY, "Y"), (OPTION_STOP_SERVICE, stop)]),
+                true,
+            )
+        };
+        // Cancelled on Windows (flag restored) or macOS (flag never set): refused.
+        assert!(!incoming_stopped("", false));
+        assert!(setup_result(&with_password(""), true, incoming_stopped("", false)).is_err());
+        // macOS: flag set but the service is still listening (async stop): refused.
+        assert!(!incoming_stopped("Y", true));
+        assert!(setup_result(&with_password("Y"), true, incoming_stopped("Y", true)).is_err());
+        // Confirmed: flag set and nothing listening.
+        assert!(incoming_stopped("Y", false));
+        assert!(setup_result(&with_password("Y"), true, incoming_stopped("Y", false)).is_ok());
+        // Without Controller only, the existing password is enough.
+        assert!(setup_result(&with_password(""), false, false).is_ok());
+    }
