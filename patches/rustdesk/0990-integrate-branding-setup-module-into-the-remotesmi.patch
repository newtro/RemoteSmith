+/// True when something is bound to the direct-IP port (the host side still accepts direct
+/// connections). Checked by trying to bind it ourselves; nothing is connected or sent.
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub fn direct_port_listening(port: u16) -> bool {
+    use std::net::{Ipv4Addr, Ipv6Addr, TcpListener};
+    let v6 = TcpListener::bind((Ipv6Addr::UNSPECIFIED, port)).is_err();
+    let v4 = TcpListener::bind((Ipv4Addr::UNSPECIFIED, port)).is_err();
+    v6 || v4
+}
+
+/// The live check behind the dialog's Save: "" when setup may close, otherwise the reason.
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub fn check_setup(wants_controller_only: bool) -> String {
+    let options = crate::ipc::get_options();
+    let stop = options.get(OPTION_STOP_SERVICE).cloned().unwrap_or_default();
+    let port = options
+        .get("direct-access-port")
+        .and_then(|p| p.parse::<u16>().ok())
+        .filter(|p| *p > 0)
+        .unwrap_or((hbb_common::config::RENDEZVOUS_PORT + 2) as u16);
+    let stopped = incoming_stopped(&stop, direct_port_listening(port));
+    if wants_controller_only && !stopped {
+        return setup_result(&ProvisioningState::default(), true, false)
+            .err()
+            .unwrap_or_default();
+    }
+    if provisioning_needed() {
+        return setup_result(&ProvisioningState::default(), false, true)
+            .err()
+            .unwrap_or_default();
+    }
+    String::new()
+}
+
+/// Builds the provisioning state from an options map (as the service reports it).
+pub fn state_from_options(
+    options: &std::collections::HashMap<String, String>,
+    has_permanent_password: bool,
+) -> ProvisioningState {
+    let get = |k: &str| options.get(k).cloned().unwrap_or_default();
+    ProvisioningState {
+        id_server: get(OPTION_ID_SERVER),
+        key: get(OPTION_KEY),
+        lan_only: get(OPTION_LAN_ONLY) == "Y",
+        controller_only: hbb_common::config::option2bool(
+            OPTION_STOP_SERVICE,
+            &get(OPTION_STOP_SERVICE),
+        ),
+        has_permanent_password,
+    }
+}
+
+/// Upstream's "stop service" option: no rendezvous registration, no direct-IP listener.
+pub const OPTION_STOP_SERVICE: &str = "stop-service";
+
+/// Reads the live provisioning state, from the service over IPC where it runs, otherwise from
+/// the local config (the same files the user-level service writes).
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub fn provisioning_needed() -> bool {
+    let options = crate::ipc::get_options();
+    let has_password = match crate::ipc::get_config("permanent-password-set") {
+        Ok(Some(v)) => v.trim() == "Y",
+        _ => hbb_common::config::Config::has_permanent_password(),
+    };
+    #[allow(unused_mut)]
+    let mut state = state_from_options(&options, has_password);
+    if state.controller_only {
+        // Only counts while nothing listens on the direct port any more.
+        let port = options
+            .get("direct-access-port")
+            .and_then(|p| p.parse::<u16>().ok())
+            .filter(|p| *p > 0)
+            .unwrap_or((hbb_common::config::RENDEZVOUS_PORT + 2) as u16);
+        state.controller_only = !direct_port_listening(port);
+    }
+    #[cfg(windows)]
+    if state.id_server.is_empty() {
+        // A server baked into the exe name (upstream's custom-server naming) counts as set.
+        if let Ok(lic) = crate::platform::windows::get_license_from_exe_name() {
+            state.id_server = lic.host;
+            state.key = lic.key;
+        }
+    }
+    needs_provisioning(&state)
+}
