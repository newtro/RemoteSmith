+    /// Round-2 gate: a rejected --import-config leaves both destination files byte-identical,
+    /// even when the primary file alone would have been accepted.
+    #[test]
+    fn rejected_import_writes_nothing() {
+        let dir = std::env::temp_dir().join(format!(
+            "remotesmith-import-test-{}-{}",
+            std::process::id(),
+            hbb_common::rand::random::<u32>()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let (dst, dst2) = (dir.join("dst.toml"), dir.join("dst2.toml"));
+        std::fs::write(&dst, "id = '111111111'\npassword = 'old'\n").unwrap();
+        std::fs::write(&dst2, "[options]\ncustom-rendezvous-server = 'old.example.com'\n").unwrap();
+        let before = (std::fs::read(&dst).unwrap(), std::fs::read(&dst2).unwrap());
+        std::thread::sleep(std::time::Duration::from_millis(1100));
+        let (src, src2) = (dir.join("src.toml"), dir.join("src2.toml"));
+        // A non-empty source: an id and a key pair (an empty one is skipped by upstream).
+        std::fs::write(
+            &src,
+            "id = '999999999'\npassword = 'new'\nkey_pair = [[1, 2, 3], [4, 5, 6]]\n",
+        )
+        .unwrap();
+        let far_future = std::time::SystemTime::now() + std::time::Duration::from_secs(3600);
+        // Server without a key: rejected, nothing written.
+        std::fs::write(&src2, "[options]\ncustom-rendezvous-server = 'rs.example.com'\n").unwrap();
+        assert!(import_config_files(&src, &src2, &dst, &dst2, far_future).is_err());
+        assert_eq!(std::fs::read(&dst).unwrap(), before.0);
+        assert_eq!(std::fs::read(&dst2).unwrap(), before.1);
+        // Malformed key and bad lan-only value: rejected too.
+        std::fs::write(&src2, "[options]\ncustom-rendezvous-server = 'rs.example.com'\nkey = 'nope'\n").unwrap();
+        assert!(import_config_files(&src, &src2, &dst, &dst2, far_future).is_err());
+        std::fs::write(&src2, "[options]\nremotesmith-lan-only = 'yes'\n").unwrap();
+        assert!(import_config_files(&src, &src2, &dst, &dst2, far_future).is_err());
+        assert_eq!(std::fs::read(&dst).unwrap(), before.0);
+        assert_eq!(std::fs::read(&dst2).unwrap(), before.1);
+        // A valid pair is imported (both files newer than the destinations).
+        std::fs::write(&src2, format!("[options]\ncustom-rendezvous-server = 'rs.example.com'\nkey = '{KEY}'\n")).unwrap();
+        assert_eq!(
+            import_config_files(&src, &src2, &dst, &dst2, far_future),
+            Ok((true, true))
+        );
+        assert_ne!(std::fs::read(&dst).unwrap(), before.0);
+        let imported: hbb_common::config::Config2 = hbb_common::config::load_path(dst2.clone());
+        assert_eq!(imported.options.get(OPTION_KEY).map(String::as_str), Some(KEY));
+        std::fs::remove_dir_all(&dir).ok();
+    }
