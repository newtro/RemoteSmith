+    #[test]
+    fn provisioning_state() {
+        let need = |o: &[(&str, &str)], pw: bool| needs_provisioning(&state_from_options(&opts(o), pw));
+        // Fresh install: nothing set.
+        assert!(need(&[], false));
+        assert!(need(&[], true));
+        // Server without a key, or with a malformed key or host: not a usable route.
+        assert!(need(&[(OPTION_ID_SERVER, "rs.example.com")], true));
+        assert!(need(&[(OPTION_ID_SERVER, "rs.example.com"), (OPTION_KEY, "short")], true));
+        assert!(need(&[(OPTION_ID_SERVER, "http://rs"), (OPTION_KEY, KEY)], true));
+        assert!(need(&[(OPTION_KEY, KEY)], true));
+        // A route but no password, and not controller only.
+        assert!(need(&[(OPTION_ID_SERVER, "rs.example.com"), (OPTION_KEY, KEY)], false));
+        assert!(need(&[(OPTION_LAN_ONLY, "Y")], false));
+        // Controller only still needs a route.
+        assert!(need(&[(OPTION_STOP_SERVICE, "Y")], false));
+        // Done.
+        assert!(!need(&[(OPTION_ID_SERVER, "rs.example.com"), (OPTION_KEY, KEY)], true));
+        assert!(!need(&[(OPTION_LAN_ONLY, "Y")], true));
+        assert!(!need(&[(OPTION_LAN_ONLY, "Y"), (OPTION_STOP_SERVICE, "Y")], false));
+        assert!(!need(
+            &[(OPTION_ID_SERVER, "rs.example.com:21116"), (OPTION_KEY, KEY), (OPTION_STOP_SERVICE, "Y")],
+            false
+        ));
+        // Switching a controller-only machine to host (start service) needs the password again.
+        assert!(need(&[(OPTION_LAN_ONLY, "Y"), (OPTION_STOP_SERVICE, "")], false));
+    }
