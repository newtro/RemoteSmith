+    /// Finding 10: a malformed (or truncated-to-empty) newer source file is rejected and leaves
+    /// both destinations byte-identical, instead of importing defaults over valid settings.
+    #[test]
+    fn malformed_import_is_rejected() {
+        let dir = std::env::temp_dir().join(format!(
+            "remotesmith-import-bad-{}-{}",
+            std::process::id(),
+            hbb_common::rand::random::<u32>()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let (dst, dst2) = (dir.join("dst.toml"), dir.join("dst2.toml"));
+        std::fs::write(&dst, "id = '111111111'\npassword = 'old'\n").unwrap();
+        std::fs::write(
+            &dst2,
+            format!("[options]\ncustom-rendezvous-server = 'old.example.com'\nkey = '{KEY}'\n"),
+        )
+        .unwrap();
+        let before = (std::fs::read(&dst).unwrap(), std::fs::read(&dst2).unwrap());
+        std::thread::sleep(std::time::Duration::from_millis(1100));
+        let (src, src2) = (dir.join("src.toml"), dir.join("src2.toml"));
+        let good_src = "id = '999999999'\npassword = 'new'\nkey_pair = [[1, 2, 3], [4, 5, 6]]\n";
+        let far_future = std::time::SystemTime::now() + std::time::Duration::from_secs(3600);
+        let unchanged = || {
+            assert_eq!(std::fs::read(&dst).unwrap(), before.0);
+            assert_eq!(std::fs::read(&dst2).unwrap(), before.1);
+        };
+        // A valid primary with a malformed, newer options file.
+        std::fs::write(&src, good_src).unwrap();
+        for bad2 in [
+            "[options\nkey = 'x'\n",
+            "[options]\nkey = \n",
+            "options = 3\n",
+            "[options]\ncustom-rendezvous-server = 7\n",
+            "",
+            "  \n",
+        ] {
+            std::fs::write(&src2, bad2).unwrap();
+            let err = import_config_files(&src, &src2, &dst, &dst2, far_future).unwrap_err();
+            assert!(err.starts_with("Invalid config file"), "{err}");
+            unchanged();
+        }
+        // A malformed primary is rejected too (upstream skipped it as "empty" at best).
+        std::fs::write(&src2, format!("[options]\ncustom-rendezvous-server = 'rs.example.com'\nkey = '{KEY}'\n")).unwrap();
+        std::fs::write(&src, "id = '999999999'\nkey_pair = [[1, 2, 3]\n").unwrap();
+        assert!(import_config_files(&src, &src2, &dst, &dst2, far_future).is_err());
+        unchanged();
+        // A missing options file is still allowed (nothing to import for it).
+        std::fs::write(&src, good_src).unwrap();
+        std::fs::remove_file(&src2).unwrap();
+        assert_eq!(import_config_files(&src, &src2, &dst, &dst2, far_future), Ok((true, false)));
+        assert_eq!(std::fs::read(&dst2).unwrap(), before.1);
+        // A file written by the app itself (confy's serializer) passes the option-count check.
+        let mut cfg2 = hbb_common::config::Config2::default();
+        for (k, v) in [
+            ("custom-rendezvous-server", "rs.example.com"),
+            ("key", KEY),
+            ("whitelist", "192.168.1.0/24,10.0.0.1"),
+            ("note", "quote \" and 'apostrophe' and \\ backslash"),
+        ] {
+            cfg2.options.insert(k.to_owned(), v.to_owned());
+        }
+        hbb_common::config::store_path(src2.clone(), cfg2).unwrap();
+        assert_eq!(import_config_files(&src, &src2, &dst, &dst2, far_future), Ok((false, true)));
+        std::fs::remove_dir_all(&dir).ok();
+    }
