     validate_option(OPTION_LAN_ONLY, get(OPTION_LAN_ONLY))
 }
 
+/// How many entries the file's `options` table has (`usize::MAX` if `options` is not a table),
+/// or `None` if this TOML parser cannot read the file (confy's older parser then decides).
+fn raw_option_count(text: &str) -> Option<usize> {
+    use hbb_common::toml::Value;
+    let v: Value = hbb_common::toml::from_str(text).ok()?;
+    Some(match v.get("options") {
+        None => 0,
+        Some(Value::Table(t)) => t.len(),
+        Some(_) => usize::MAX,
+    })
+}
