@@ -239,15 +251,32 @@ pub fn import_config_files(
     exe_time: std::time::SystemTime,
 ) -> Result<(bool, bool), String> {
     use hbb_common::{
-        config::{load_path, store_path, Config, Config2},
+        config::{store_path, try_load_path, Config, Config2},
         get_modified_time,
     };
-    let config: Config = load_path(src.into());
+    // RemoteSmith(0802): a source file that exists but does not parse is rejected; upstream's
+    // load_path would turn it into defaults, which could then overwrite valid settings.
+    let invalid = |e: hbb_common::anyhow::Error| format!("Invalid config file: {e}");
+    let config: Config = try_load_path(src.into()).map_err(invalid)?;
     if config.is_empty() {
         hbb_common::log::info!("Empty source config, skipped");
         return Ok((false, false));
     }
-    let config2: Config2 = load_path(src2.into());
+    let text2 = std::fs::read_to_string(src2).ok();
+    if text2.as_deref().map_or(false, |t| t.trim().is_empty()) {
+        return Err(format!("Invalid config file: {} is empty", src2.display()));
+    }
+    let config2: Config2 = try_load_path(src2.into()).map_err(invalid)?;
+    // Config2's field deserializers turn a wrongly typed value into a default instead of an
+    // error, so also check that every option in the file survived parsing.
+    if let Some(n) = text2.as_deref().and_then(raw_option_count) {
+        if n != config2.options.len() {
+            return Err(format!(
+                "Invalid config file: {} has malformed options",
+                src2.display()
+            ));
+        }
+    }
     validate_imported_options(&config2.options)?;
     let write1 = get_modified_time(src) > get_modified_time(dst) && get_modified_time(src) < exe_time;
     let write2 = get_modified_time(src2) > get_modified_time(dst2);
