index 000000000000..b7a3090eff26
--- /dev/null
+++ b/src/remotesmith_trust/lan_first.rs
@@ -0,0 +1,193 @@
+//! LAN-first route for saved peers (RemoteSmith DEC-11, DEF-8, AC-7, AC-8, AC-38).
+//!
+//! Upstream reaches a peer by ID only through hbbs (its intranet path needs hbbs too), and goes
+//! to the direct port 21118 only when the user types an IP. So with the VM down, an ID connect
+//! fails even on the same LAN. RemoteSmith tries the peer's LAN address(es) first, with the
+//! identity handshake (the host must prove the saved peer's ID before anything else happens),
+//! all within 3 s, and only then the ID route.
+//!
+//! Hints come from the peer's config (the address that last worked, see [`OPTION_LAN_HINT`]),
+//! LAN discovery, and the address hbbs reports when it says the peer is on our LAN. They are
+//! hints only: the identity check decides who answered (DEF-3).
+
+use hbb_common::{
+    bail,
+    config::{Config, LanPeers, RELAY_PORT},
+    futures::future::{select_ok, FutureExt},
+    log,
+    socket_client::connect_tcp_local,
+    timeout, ResultType, Stream,
+};
+use std::time::Instant;
+
+/// Peer option: the LAN address (IP or IP:port) the last successful LAN route used.
+pub const OPTION_LAN_HINT: &str = "remotesmith-lan-hint";
+/// The whole LAN attempt, connect and identity handshake, gets this long (DEF-8).
+pub const LAN_BUDGET_MS: u64 = 3_000;
+/// Label shown for the route ("Direct ... (LAN)").
+pub const ROUTE_LABEL: &str = "LAN";
+const MAX_HINTS: usize = 4;
+
+/// The direct-server address for a hint: an IP, or IP:port as stored.
+pub fn direct_addr(hint: &str) -> Option<String> {
+    let hint = hint.trim();
+    if hint.is_empty() {
+        return None;
+    }
+    if let Ok(sa) = hint.parse::<std::net::SocketAddr>() {
+        return Some(sa.to_string());
+    }
+    if let Ok(ip) = hint.parse::<std::net::IpAddr>() {
+        return Some(std::net::SocketAddr::new(ip, (RELAY_PORT + 1) as u16).to_string());
+    }
+    None
+}
+
+/// Ordered, de-duplicated direct addresses to try: the saved hint first, then discovery.
+pub fn candidates(saved_hint: &str, discovered: &[String]) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for h in std::iter::once(saved_hint).chain(discovered.iter().map(|s| s.as_str())) {
+        if let Some(a) = direct_addr(h) {
+            if !out.contains(&a) {
+                out.push(a);
+            }
+        }
+        if out.len() >= MAX_HINTS {
+            break;
+        }
+    }
+    out
+}
+
+/// IPs LAN discovery has seen for `peer_id`, most recent peer first.
+pub fn discovered_ips(peer_id: &str) -> Vec<String> {
+    LanPeers::load()
+        .peers
+        .into_iter()
+        .filter(|p| p.id == peer_id)
+        .flat_map(|p| p.ip_mac.into_keys())
+        .collect()
+}
+
+/// Whether the LAN-first attempt applies at all: not through a proxy or WebSocket transport
+/// (a direct LAN socket would bypass them) and not when relay is forced.
+pub fn applies(force_relay: bool) -> bool {
+    !force_relay && Config::get_socks().is_none() && !hbb_common::config::use_ws()
+}
+
+/// A private-network address worth remembering as a hint.
+pub fn is_lan_ip(ip: &std::net::IpAddr) -> bool {
+    match ip {
+        std::net::IpAddr::V4(v4) => v4.is_private() || v4.is_link_local(),
+        std::net::IpAddr::V6(v6) => {
+            let s = v6.segments();
+            (s[0] & 0xfe00) == 0xfc00 || (s[0] & 0xffc0) == 0xfe80
+        }
+    }
+}
+
+/// Try every candidate at once; the first that connects AND proves `expected_id` wins and the
+/// rest are dropped (so only one session can come of it). Bounded by `budget_ms` overall.
+/// Returns the stream, the address that won and the host's signing key.
+pub async fn connect(
+    expected_id: &str,
+    addrs: &[String],
+    budget_ms: u64,
+) -> ResultType<(Stream, String, Vec<u8>)> {
+    if addrs.is_empty() {
+        bail!("no LAN address known");
+    }
+    let start = Instant::now();
+    let attempts = addrs.iter().map(|addr| {
+        let addr = addr.clone();
+        let expected_id = expected_id.to_owned();
+        async move {
+            let mut conn = connect_tcp_local(addr.as_str(), None, budget_ms).await?;
+            let left = budget_ms.saturating_sub(start.elapsed().as_millis() as u64).max(1);
+            let (_, pk) = super::identity::direct_handshake(&mut conn, Some(&expected_id), left)
+                .await?;
+            Ok::<_, hbb_common::anyhow::Error>((conn, addr, pk))
+        }
+        .boxed()
+    });
+    match timeout(budget_ms, select_ok(attempts)).await {
+        Ok(Ok(((conn, addr, pk), _rest))) => {
+            log::info!(
+                "LAN route to {} via {} in {:?}",
+                expected_id,
+                addr,
+                start.elapsed()
+            );
+            Ok((conn, addr, pk))
+        }
+        Ok(Err(err)) => bail!("LAN route failed: {}", err),
+        Err(_) => bail!("LAN route timed out after {} ms", budget_ms),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::identity::test_support::{host_stub, Host};
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn hints_become_direct_server_addresses() {
+        assert_eq!(direct_addr("192.168.1.20"), Some("192.168.1.20:21118".into()));
+        assert_eq!(direct_addr("192.168.1.20:4000"), Some("192.168.1.20:4000".into()));
+        assert_eq!(direct_addr("fe80::1"), Some("[fe80::1]:21118".into()));
+        assert_eq!(direct_addr("not an ip"), None);
+        assert_eq!(direct_addr(""), None);
+    }
+
+    #[test]
+    fn candidates_put_the_saved_hint_first_and_dedupe() {
+        let c = candidates(
+            "10.0.0.5",
+            &["10.0.0.6".into(), "10.0.0.5".into(), "junk".into()],
+        );
+        assert_eq!(c, vec!["10.0.0.5:21118", "10.0.0.6:21118"]);
+        let many: Vec<String> = (1..10).map(|i| format!("10.0.0.{i}")).collect();
+        assert_eq!(candidates("", &many).len(), MAX_HINTS);
+    }
+
+    #[test]
+    fn only_private_addresses_are_hints() {
+        assert!(is_lan_ip(&"192.168.1.2".parse().unwrap()));
+        assert!(is_lan_ip(&"10.1.2.3".parse().unwrap()));
+        assert!(is_lan_ip(&"fd00::1".parse().unwrap()));
+        assert!(!is_lan_ip(&"8.8.8.8".parse().unwrap()));
+        assert!(!is_lan_ip(&"2001:db8::1".parse().unwrap()));
+    }
+
+    #[hbb_common::tokio::test]
+    async fn the_peer_that_proves_the_expected_id_wins() {
+        let (wrong, _, _) = host_stub("999", Host::Honest).await;
+        let (right, pk, _) = host_stub("123", Host::Honest).await;
+        let (conn, addr, got_pk) = connect("123", &[wrong, right.clone()], LAN_BUDGET_MS)
+            .await
+            .unwrap();
+        assert_eq!(addr, right);
+        assert_eq!(got_pk, pk);
+        assert!(conn.is_secured());
+    }
+
+    #[hbb_common::tokio::test]
+    async fn a_stale_address_gives_up_within_the_budget() {
+        // A listener that accepts and then says nothing, like a host that is not RemoteSmith,
+        // plus an address nothing listens on.
+        let (silent, _, _) = host_stub("123", Host::Silent).await;
+        let start = Instant::now();
+        let Err(err) = connect("123", &[silent, "127.0.0.1:1".into()], 500).await else {
+            panic!("a silent host must not win");
+        };
+        assert!(start.elapsed() < Duration::from_millis(1500), "{:?}", start.elapsed());
+        assert!(err.to_string().contains("LAN route"), "{err}");
+    }
+
+    #[hbb_common::tokio::test]
+    async fn another_machine_at_the_hint_is_not_accepted() {
+        let (other, _, _) = host_stub("999", Host::Honest).await;
+        assert!(connect("123", &[other], LAN_BUDGET_MS).await.is_err());
+    }
+}
