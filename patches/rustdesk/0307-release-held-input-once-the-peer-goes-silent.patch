+    /// RemoteSmith (AC-41): inject the up events for whatever `held` still holds, through the
+    /// same path the downs took (main-thread queue on macOS, portable service on Windows).
+    #[cfg(not(any(target_os = "android", target_os = "ios")))]
+    fn release_held(
+        held: &mut crate::remotesmith_trust::held_input::HeldInput,
+        last_mouse_conn: &Option<(i32, String, u32)>,
+    ) {
+        if held.is_empty() {
+            return;
+        }
+        let (mouse_ups, key_ups) = held.take_releases();
+        log::info!(
+            "releasing {} held button(s) and {} key(s) (peer gone or silent)",
+            mouse_ups.len(),
+            key_ups.len()
+        );
+        if let Some((conn_id, username, argb)) = last_mouse_conn {
+            for m in mouse_ups.iter() {
+                handle_mouse(m, *conn_id, username.clone(), *argb, true, false);
+            }
+        }
+        for k in key_ups.iter() {
+            handle_key(k);
+        }
+    }
