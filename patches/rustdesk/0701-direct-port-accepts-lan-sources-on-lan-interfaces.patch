+    /// Real sockets on this machine, through the dual-stack listener direct_server uses: a
+    /// connection from this host's own LAN address is admitted, one over loopback is not.
+    #[hbb_common::tokio::test]
+    async fn live_listener_admits_lan_and_refuses_loopback() {
+        use hbb_common::tokio::net::TcpStream;
+        let listener = hbb_common::tcp::listen_any(0).await.unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let accept_one = |to: SocketAddr| {
+            let listener = &listener;
+            async move {
+                let _c = TcpStream::connect(to).await.unwrap();
+                let (s, peer) = listener.accept().await.unwrap();
+                admit(s.local_addr().unwrap(), peer).await
+            }
+        };
+        assert!(!accept_one(sa(&format!("127.0.0.1:{port}"))).await, "loopback admitted");
+        let all = local_interfaces();
+        let lan = all.iter().find_map(|i| {
+            is_lan_interface(this_os(), i, &all)
+                .then(|| i.nets.iter().find(|(ip, p)| ip.is_ipv4() && *p >= 8 && *p <= 30).map(|(ip, _)| *ip))
+                .flatten()
+        });
+        match lan {
+            Some(ip) => assert!(
+                accept_one(SocketAddr::new(ip, port)).await,
+                "this host's own LAN address {ip} refused"
+            ),
+            None => eprintln!("no IPv4 LAN interface on this machine; LAN half skipped"),
+        }
+    }
