+    /// Gate review: Windows adapters must be hardware-backed. An unknown virtual adapter with
+    /// an innocent name, a Hyper-V internal switch and a Wi-Fi Direct adapter are refused; the
+    /// host adapter of a Hyper-V external switch (the physical NIC's MAC, NIC itself unbound)
+    /// is accepted.
+    #[test]
+    fn windows_adapters_must_be_hardware_backed() {
+        let nic = win(5, Kind::Ethernet, "Ethernet Intel(R) Ethernet Connection I219-V", true, 0x10, &[]);
+        let external = win(9, Kind::Ethernet, "vEthernet (LAN) Hyper-V Virtual Ethernet Adapter", false, 0x10, &[("192.168.1.40", 24)]);
+        let internal = win(10, Kind::Ethernet, "vEthernet (Lab) Hyper-V Virtual Ethernet Adapter #3", false, 0x77, &[("172.30.0.1", 20)]);
+        let mystery = win(11, Kind::Ethernet, "Ethernet 5 Some Overlay Adapter", false, 0x55, &[("192.168.1.41", 24)]);
+        let wifi_direct = win(12, Kind::Wireless, "Local Area Connection* 2 Microsoft Wi-Fi Direct Virtual Adapter", false, 0x11, &[]);
+        let all = vec![nic.clone(), external.clone(), internal.clone(), mystery.clone(), wifi_direct.clone()];
+        assert!(is_lan_interface(Os::Windows, &nic, &all));
+        assert!(is_lan_interface(Os::Windows, &external, &all), "external switch host adapter");
+        assert!(!is_lan_interface(Os::Windows, &internal, &all), "internal switch");
+        assert!(!is_lan_interface(Os::Windows, &mystery, &all), "unknown virtual adapter");
+        assert!(!is_lan_interface(Os::Windows, &wifi_direct, &all));
+        // Without the hardware table (GetIfTable2 failed): fail closed.
+        let unknown = Iface { hw: None, ..nic.clone() };
+        assert!(!is_lan_interface(Os::Windows, &unknown, &[unknown.clone()]));
+        // The MAC must belong to a *hardware* adapter, not just any other adapter.
+        let twin = win(13, Kind::Ethernet, "Ethernet 6 Clone", false, 0x77, &[]);
+        assert!(!is_lan_interface(Os::Windows, &twin, &[twin.clone(), internal.clone()]));
+        assert_eq!(
+            check(Os::Windows, &mapped("192.168.1.40", 21118), &mapped("192.168.1.20", 5), &all),
+            Ok("{9}".into())
+        );
+        assert!(matches!(
+            check(Os::Windows, &mapped("192.168.1.41", 21118), &mapped("192.168.1.20", 5), &all),
+            Err(Refusal::NotLan { .. })
+        ));
+    }
