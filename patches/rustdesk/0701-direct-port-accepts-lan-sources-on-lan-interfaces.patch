+    fn windows_firewall_rules_scope_only_the_direct_port() {
+        assert_eq!(tcp_ports_except(21118), "1-21117,21119-65535");
+        assert_eq!(tcp_ports_except(1), "2-65535");
+        assert_eq!(tcp_ports_except(2), "1,3-65535");
+        assert_eq!(tcp_ports_except(65535), "1-65534");
+        assert_eq!(tcp_ports_except(65534), "1-65533,65535");
+        let r = windows_inbound_rules("RemoteSmith Service", "C:\\Program Files\\RemoteSmith\\RemoteSmith.exe", 21118);
+        assert_eq!(r.len(), 3);
+        assert!(r.iter().all(|l| l.contains("name=\"RemoteSmith Service\" dir=in action=allow program=\"C:\\Program Files\\RemoteSmith\\RemoteSmith.exe\"")));
+        assert!(r[0].ends_with(" protocol=udp"));
+        assert!(r[1].ends_with(" protocol=tcp localport=1-21117,21119-65535"));
+        assert!(r[2].ends_with(" protocol=tcp localport=21118 remoteip=localsubnet"));
+        // No rule opens the direct port to every source.
+        assert!(!r.iter().any(|l| !l.contains("protocol=")));
+    }
