+/// At most one refusal line per second, with a count of the ones folded into it, so a scan of
+/// the port cannot flood the log.
+fn log_refusal(peer: &SocketAddr, local: &SocketAddr, why: &Refusal) {
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+    static LAST: Mutex<Option<(Instant, u64)>> = Mutex::new(None);
+    let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+    match last.as_mut() {
+        Some((at, suppressed)) if at.elapsed() < Duration::from_secs(1) => *suppressed += 1,
+        _ => {
+            let suppressed = last.map(|(_, n)| n).unwrap_or(0);
+            hbb_common::log::warn!(
+                "direct access from {} to {} refused: {}{}",
+                peer,
+                local,
+                why,
+                if suppressed > 0 {
+                    format!(" ({suppressed} more refused in the last second)")
+                } else {
+                    String::new()
+                }
+            );
+            *last = Some((Instant::now(), 0));
+        }
+    }
+}
+
+/// The gate `direct_server` runs on every accepted connection before handing it on. Logs and
+/// returns false for a refused one; the caller drops the stream unread.
+pub async fn admit(local: SocketAddr, peer: SocketAddr) -> bool {
+    let ifaces = match hbb_common::tokio::task::spawn_blocking(local_interfaces_cached).await {
+        Ok(v) => v,
+        Err(e) => {
+            hbb_common::log::error!("direct access: cannot list interfaces: {e}");
+            Vec::new()
+        }
+    };
+    match check(this_os(), &local, &peer, &ifaces) {
+        Ok(iface) => {
+            hbb_common::log::info!("direct access from {} on LAN interface {}", peer, iface);
+            true
+        }
+        Err(why) => {
+            log_refusal(&peer, &local, &why);
+            false
+        }
+    }
+}
+
+/// The addresses the direct server listens on where it pins listeners to interfaces (macOS):
+/// every address of every LAN interface, as `(interface index, address:port)`. Link-local IPv6
+/// addresses carry their interface as scope.
+pub fn bind_plan(os: Os, ifaces: &[Iface], port: u16) -> Vec<(u32, SocketAddr)> {
+    use std::net::SocketAddrV6;
+    let mut out = Vec::new();
+    for i in ifaces.iter().filter(|i| is_lan_interface(os, i, ifaces)) {
+        for (ip, _) in &i.nets {
+            let addr = match ip {
+                IpAddr::V4(_) => SocketAddr::new(*ip, port),
+                IpAddr::V6(v6) => {
+                    let link_local = (v6.segments()[0] & 0xffc0) == 0xfe80;
+                    SocketAddr::V6(SocketAddrV6::new(*v6, port, 0, if link_local { i.index } else { 0 }))
+                }
+            };
+            if !out.iter().any(|(_, a)| *a == addr) {
+                out.push((i.index, addr));
+            }
+        }
+    }
+    out
+}
+
+/// macOS: the direct server's listeners, one per LAN address, each pinned to its interface with
+/// `IP_BOUND_IF` / `IPV6_BOUND_IF` (see the module docs). [`Self::refresh`] follows address
+/// changes; accepted connections come out of [`Self::next`].
+#[cfg(target_os = "macos")]
+pub struct LanListeners {
+    port: u16,
+    tasks: std::collections::HashMap<(u32, SocketAddr), hbb_common::tokio::task::JoinHandle<()>>,
+    failed: std::collections::HashSet<(u32, SocketAddr)>,
+    tx: hbb_common::tokio::sync::mpsc::UnboundedSender<(hbb_common::tokio::net::TcpStream, SocketAddr)>,
+    rx: hbb_common::tokio::sync::mpsc::UnboundedReceiver<(hbb_common::tokio::net::TcpStream, SocketAddr)>,
+}
+
+#[cfg(target_os = "macos")]
+impl LanListeners {
+    pub fn new(port: u16) -> Self {
+        let (tx, rx) = hbb_common::tokio::sync::mpsc::unbounded_channel();
+        Self {
+            port,
+            tasks: Default::default(),
+            failed: Default::default(),
+            tx,
+            rx,
+        }
+    }
+
+    pub fn port(&self) -> u16 {
+        self.port
+    }
+
+    /// Addresses currently listened on.
+    pub fn bound(&self) -> Vec<(u32, SocketAddr)> {
+        self.tasks.keys().copied().collect()
+    }
+
+    /// One listener on `addr`, pinned to interface `index`.
+    pub fn bind_pinned(index: u32, addr: SocketAddr) -> std::io::Result<std::net::TcpListener> {
+        use hbb_common::libc;
+        use std::os::fd::{FromRawFd, OwnedFd, AsRawFd};
+        let domain = if addr.is_ipv4() { libc::AF_INET } else { libc::AF_INET6 };
+        let fd = unsafe { libc::socket(domain, libc::SOCK_STREAM, 0) };
+        if fd < 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+        let set = |level: libc::c_int, opt: libc::c_int, v: libc::c_int| -> std::io::Result<()> {
+            let r = unsafe {
+                libc::setsockopt(
+                    fd.as_raw_fd(),
+                    level,
+                    opt,
+                    &v as *const _ as *const libc::c_void,
+                    std::mem::size_of::<libc::c_int>() as libc::socklen_t,
+                )
+            };
+            if r == 0 { Ok(()) } else { Err(std::io::Error::last_os_error()) }
+        };
+        set(libc::SOL_SOCKET, libc::SO_REUSEADDR, 1)?;
+        if addr.is_ipv4() {
+            set(libc::IPPROTO_IP, libc::IP_BOUND_IF, index as libc::c_int)?;
+        } else {
+            set(libc::IPPROTO_IPV6, libc::IPV6_V6ONLY, 1)?;
+            set(libc::IPPROTO_IPV6, libc::IPV6_BOUND_IF, index as libc::c_int)?;
+        }
+        let l = std::net::TcpListener::from(fd);
+        // std has no bind-after-options API; do it through socket2-free libc as well.
+        let (raw, len) = sockaddr_of(&addr);
+        if unsafe { libc::bind(l.as_raw_fd(), &raw as *const _ as *const libc::sockaddr, len) } != 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        if unsafe { libc::listen(l.as_raw_fd(), 128) } != 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        l.set_nonblocking(true)?;
+        Ok(l)
+    }
+
+    /// Bind listeners for addresses that appeared, drop those whose address went away.
+    pub fn refresh(&mut self) {
+        let plan = bind_plan(this_os(), &local_interfaces_cached(), self.port);
+        self.tasks.retain(|k, t| {
+            let keep = plan.contains(k);
+            if !keep {
+                t.abort();
+                hbb_common::log::info!("direct access: stopped listening on {} (if {})", k.1, k.0);
+            }
+            keep
+        });
+        self.failed.retain(|k| plan.contains(k));
+        for key in plan {
+            if self.tasks.contains_key(&key) {
+                continue;
+            }
+            let (index, addr) = key;
+            let listener = match Self::bind_pinned(index, addr)
+                .and_then(hbb_common::tokio::net::TcpListener::from_std)
+            {
+                Ok(l) => l,
+                Err(e) => {
+                    if self.failed.insert(key) {
+                        hbb_common::log::error!("direct access: cannot listen on {addr} (if {index}): {e}");
+                    }
+                    continue;
+                }
+            };
+            self.failed.remove(&key);
+            hbb_common::log::info!("direct access: listening on {addr} (if {index})");
+            let tx = self.tx.clone();
+            self.tasks.insert(
+                key,
+                hbb_common::tokio::spawn(async move {
+                    loop {
+                        match listener.accept().await {
+                            Ok(c) => {
+                                if tx.send(c).is_err() {
+                                    return;
+                                }
+                            }
+                            Err(e) => {
+                                hbb_common::log::warn!("direct access: accept on {addr}: {e}");
+                                hbb_common::tokio::time::sleep(std::time::Duration::from_millis(500)).await;
+                            }
+                        }
+                    }
+                }),
+            );
+        }
+    }
+
+    /// The next accepted connection, or `None` after `ms` without one.
+    pub async fn next(&mut self, ms: u64) -> Option<(hbb_common::tokio::net::TcpStream, SocketAddr)> {
+        hbb_common::tokio::time::timeout(std::time::Duration::from_millis(ms), self.rx.recv())
+            .await
+            .ok()
+            .flatten()
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl Drop for LanListeners {
+    fn drop(&mut self) {
+        for t in self.tasks.values() {
+            t.abort();
+        }
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn sockaddr_of(addr: &SocketAddr) -> (hbb_common::libc::sockaddr_storage, hbb_common::libc::socklen_t) {
+    use hbb_common::libc;
+    let mut ss: libc::sockaddr_storage = unsafe { std::mem::zeroed() };
+    let len = match addr {
+        SocketAddr::V4(a) => {
+            let sin = libc::sockaddr_in {
+                sin_len: std::mem::size_of::<libc::sockaddr_in>() as u8,
+                sin_family: libc::AF_INET as libc::sa_family_t,
+                sin_port: a.port().to_be(),
+                sin_addr: libc::in_addr { s_addr: u32::from(*a.ip()).to_be() },
+                sin_zero: [0; 8],
+            };
+            unsafe { std::ptr::write(&mut ss as *mut _ as *mut libc::sockaddr_in, sin) };
+            std::mem::size_of::<libc::sockaddr_in>()
+        }
+        SocketAddr::V6(a) => {
+            let sin6 = libc::sockaddr_in6 {
+                sin6_len: std::mem::size_of::<libc::sockaddr_in6>() as u8,
+                sin6_family: libc::AF_INET6 as libc::sa_family_t,
+                sin6_port: a.port().to_be(),
+                sin6_flowinfo: a.flowinfo(),
+                sin6_addr: libc::in6_addr { s6_addr: a.ip().octets() },
+                sin6_scope_id: a.scope_id(),
+            };
+            unsafe { std::ptr::write(&mut ss as *mut _ as *mut libc::sockaddr_in6, sin6) };
+            std::mem::size_of::<libc::sockaddr_in6>()
+        }
+    };
+    (ss, len as libc::socklen_t)
+}
+
+/// The TCP local-port list `localport=` takes for "every port but `port`".
+pub fn tcp_ports_except(port: u16) -> String {
+    let mut parts = Vec::new();
+    if port > 1 {
+        parts.push(if port == 2 { "1".to_owned() } else { format!("1-{}", port - 1) });
+    }
+    if port < u16::MAX {
+        parts.push(if port == u16::MAX - 1 {
+            u16::MAX.to_string()
+        } else {
+            format!("{}-{}", port + 1, u16::MAX)
+        });
+    }
+    parts.join(",")
+}
+
+/// Windows installer: the inbound `netsh` rules that replace upstream's single "allow every
+/// inbound packet to the program" rule. Same rule name, so upstream's uninstall (`delete rule
+/// name=...`, which removes every rule of that name) still cleans them all up.
+/// - UDP and every TCP port but the direct port: as upstream (hole punching, LAN discovery).
+/// - The direct port: from the local subnet only (DEF-14, AC-51). The app refuses non-LAN
+///   interfaces and non-local sources itself ([`check`]); this is the OS layer under it.
+pub fn windows_inbound_rules(rule_name: &str, exe: &str, direct_port: u16) -> Vec<String> {
+    let base = format!(
+        "netsh advfirewall firewall add rule name=\"{rule_name}\" dir=in action=allow program=\"{exe}\" enable=yes"
+    );
+    vec![
+        format!("{base} protocol=udp"),
+        format!("{base} protocol=tcp localport={}", tcp_ports_except(direct_port)),
+        // Wired and Wi-Fi interface types only (not RAS/VPN), one rule each.
+        format!("{base} protocol=tcp localport={direct_port} remoteip=localsubnet interfacetype=lan"),
+        format!("{base} protocol=tcp localport={direct_port} remoteip=localsubnet interfacetype=wireless"),
+    ]
+}
