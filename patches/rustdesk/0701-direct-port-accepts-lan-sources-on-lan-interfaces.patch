+    /// Gate round 2: the physical NIC under a Hyper-V external switch has no IP, so the IP
+    /// enumeration does not list it; the MAC inventory comes from the full interface table.
+    #[test]
+    fn external_switch_matches_a_hardware_nic_that_has_no_ip() {
+        let mac = [0x3c, 0x7c, 0x3f, 0x11, 0x22, 0x33];
+        let listed = vec![
+            iface(9, "{9}", Kind::Ethernet, "vEthernet (LAN) Hyper-V Virtual Ethernet Adapter", &[("192.168.1.40", 24)]),
+            iface(10, "{10}", Kind::Ethernet, "vEthernet (Lab) Hyper-V Virtual Ethernet Adapter #3", &[("172.30.0.1", 20)]),
+        ];
+        let rows = [
+            HwRow { index: 9, if_type: 6, hw: Hw { hardware: false, mac: Some(mac) } },
+            HwRow { index: 10, if_type: 6, hw: Hw { hardware: false, mac: Some([0x00, 0x15, 0x5d, 9, 9, 9]) } },
+            // The physical NIC: hardware, any oper status, no IP, not in `listed`.
+            HwRow { index: 5, if_type: 6, hw: Hw { hardware: true, mac: Some(mac) } },
+            // A hardware row of another type is not inventory.
+            HwRow { index: 7, if_type: 23, hw: Hw { hardware: true, mac: Some([1, 2, 3, 4, 5, 6]) } },
+        ];
+        let all = merge_hw_inventory(listed.clone(), &rows);
+        assert_eq!(all.len(), 3, "the address-less NIC is added, the ppp row is not");
+        let nic = all.iter().find(|i| i.index == 5).unwrap();
+        assert!(nic.nets.is_empty() && nic.hw.unwrap().hardware);
+        assert_eq!(
+            check(Os::Windows, &mapped("192.168.1.40", 21118), &mapped("192.168.1.20", 5), &all),
+            Ok("{9}".into()),
+            "external switch adapter admitted via the unlisted NIC's MAC"
+        );
+        assert!(matches!(
+            check(Os::Windows, &mapped("172.30.0.1", 21118), &mapped("172.30.0.9", 5), &all),
+            Err(Refusal::NotLan { .. })
+        ));
+        // Without the hardware row (inventory from IP enumeration only) it would be refused.
+        let partial = merge_hw_inventory(listed, &rows[..2]);
+        assert!(check(Os::Windows, &mapped("192.168.1.40", 21118), &mapped("192.168.1.20", 5), &partial).is_err());
+    }
