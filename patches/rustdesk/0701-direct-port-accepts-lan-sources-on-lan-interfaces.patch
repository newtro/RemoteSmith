+    /// Gate review (receiving interface): the macOS listeners are pinned to the LAN interface.
+    /// A connection to the LAN address is accepted; loopback has no listener at all, and a socket
+    /// pinned to en0 cannot complete a handshake that arrived elsewhere (here: loopback).
+    #[cfg(target_os = "macos")]
+    #[hbb_common::tokio::test]
+    async fn pinned_listeners_accept_on_the_lan_address_only() {
+        use hbb_common::tokio::net::TcpStream;
+        use std::time::Duration;
+        let ifs = local_interfaces();
+        let Some((idx, lan_ip)) = ifs.iter().find_map(|i| {
+            is_lan_interface(Os::Macos, i, &ifs)
+                .then(|| i.nets.iter().find(|(ip, _)| ip.is_ipv4()).map(|(ip, _)| (i.index, *ip)))
+                .flatten()
+        }) else {
+            eprintln!("no IPv4 LAN interface; skipped");
+            return;
+        };
+        let port = std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port();
+        let mut l = LanListeners::new(port);
+        l.refresh();
+        assert!(l.bound().contains(&(idx, SocketAddr::new(lan_ip, port))), "{:?}", l.bound());
+        let _c = TcpStream::connect(SocketAddr::new(lan_ip, port)).await.unwrap();
+        let (s, peer) = l.next(2000).await.expect("LAN connection accepted");
+        assert_eq!(s.local_addr().unwrap().ip(), lan_ip);
+        assert!(admit(s.local_addr().unwrap(), peer).await);
+        let lo = hbb_common::tokio::time::timeout(
+            Duration::from_secs(2),
+            TcpStream::connect(("127.0.0.1", port)),
+        )
+        .await;
+        assert!(!matches!(lo, Ok(Ok(_))), "loopback reached the direct server");
+        // The pinning itself: a listener on 127.0.0.1 pinned to the LAN interface never
+        // completes a loopback handshake.
+        let pinned = LanListeners::bind_pinned(idx, "127.0.0.1:0".parse().unwrap()).unwrap();
+        let p2 = pinned.local_addr().unwrap().port();
+        let r = hbb_common::tokio::time::timeout(
+            Duration::from_secs(2),
+            TcpStream::connect(("127.0.0.1", p2)),
+        )
+        .await;
+        assert!(!matches!(r, Ok(Ok(_))), "pinned socket completed a handshake from another interface");
+        drop(l);
+    }
