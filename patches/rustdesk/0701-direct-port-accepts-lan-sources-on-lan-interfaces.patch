+/// One `MIB_IF_ROW2` row: interface index, IANA ifType, hardware facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HwRow {
+    pub index: u32,
+    pub if_type: u32,
+    pub hw: Hw,
+}
+
+/// Windows: attach the `GetIfTable2` facts to the IP-enumerated interfaces, and add every
+/// hardware row that the IP enumeration did not list as an address-less entry. GetAdaptersAddresses
+/// (default_net) omits a physical NIC that a Hyper-V *external* switch unbound from IP, yet its
+/// MAC is exactly what identifies the switch's host vEthernet adapter, so the MAC inventory must
+/// come from the full interface table (any oper status). Address-less entries own no address,
+/// so they can never admit a connection themselves.
+pub fn merge_hw_inventory(mut ifaces: Vec<Iface>, rows: &[HwRow]) -> Vec<Iface> {
+    for i in ifaces.iter_mut() {
+        i.hw = rows.iter().find(|r| r.index == i.index).map(|r| r.hw);
+    }
+    for r in rows.iter().filter(|r| r.hw.hardware) {
+        if ifaces.iter().any(|i| i.index == r.index) {
+            continue;
+        }
+        let kind = match r.if_type {
+            6 => Kind::Ethernet,  // IF_TYPE_ETHERNET_CSMACD
+            71 => Kind::Wireless, // IF_TYPE_IEEE80211
+            _ => continue,
+        };
+        ifaces.push(Iface {
+            index: r.index,
+            name: format!("{{if {}}}", r.index),
+            description: "hardware adapter without IP (MAC inventory only)".into(),
+            kind,
+            nets: Vec::new(),
+            hw: Some(r.hw),
+        });
+    }
+    ifaces
+}
+
+/// Windows: every `MIB_IF_ROW2` row of the full interface table.
+#[cfg(windows)]
+fn windows_hw_table() -> Vec<HwRow> {
+    use windows::Win32::NetworkManagement::IpHelper::{FreeMibTable, GetIfTable2, MIB_IF_TABLE2};
+    let mut out = Vec::new();
+    unsafe {
+        let mut table: *mut MIB_IF_TABLE2 = std::ptr::null_mut();
+        if GetIfTable2(&mut table).is_err() || table.is_null() {
+            hbb_common::log::error!("direct access: GetIfTable2 failed; no adapter counts as LAN");
+            return out;
+        }
+        let rows = std::slice::from_raw_parts(
+            (*table).Table.as_ptr(),
+            (*table).NumEntries as usize,
+        );
+        for r in rows {
+            // Bit 0 of the flags byte is HardwareInterface.
+            let hardware = (r.InterfaceAndOperStatusFlags._bitfield & 1) != 0;
+            let mac = (r.PhysicalAddressLength == 6).then(|| {
+                let mut m = [0u8; 6];
+                m.copy_from_slice(&r.PhysicalAddress[..6]);
+                m
+            });
+            if !out.iter().any(|x: &HwRow| x.index == r.InterfaceIndex) {
+                out.push(HwRow {
+                    index: r.InterfaceIndex,
+                    if_type: r.Type,
+                    hw: Hw { hardware, mac },
+                });
+            }
+        }
+        FreeMibTable(table as *const _);
+    }
+    out
+}
+
+/// This machine's interfaces, now.
+pub fn local_interfaces() -> Vec<Iface> {
+    let listed: Vec<Iface> = default_net::get_interfaces()
+        .into_iter()
+        .map(|i| Iface {
+            hw: None,
+            index: i.index,
+            description: [i.friendly_name.as_deref(), i.description.as_deref()]
+                .into_iter()
+                .flatten()
+                .collect::<Vec<_>>()
+                .join(" "),
+            kind: kind_of(i.if_type),
+            nets: i
+                .ipv4
+                .iter()
+                .map(|n| (IpAddr::V4(n.addr), n.prefix_len))
+                .chain(
+                    i.ipv6
+                        .iter()
+                        .map(|n| (IpAddr::V6(strip_embedded_scope(n.addr)), n.prefix_len)),
+                )
+                .collect(),
+            name: i.name,
+        })
+        .collect();
+    #[cfg(windows)]
+    return merge_hw_inventory(listed, &windows_hw_table());
+    #[cfg(not(windows))]
+    listed
+}
