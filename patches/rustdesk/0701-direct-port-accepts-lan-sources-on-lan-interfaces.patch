+/// RemoteSmith (DEF-14, AC-51): on macOS the direct server listens per LAN address, pinned to
+/// its interface (weak host model; see remotesmith_trust::direct_access), not on the wildcard.
+#[cfg(target_os = "macos")]
+async fn direct_server(server: ServerPtr) {
+    use crate::remotesmith_trust::direct_access::{admit, LanListeners};
+    let mut listeners: Option<LanListeners> = None;
+    let mut refreshed = Instant::now();
+    loop {
+        let disabled = !option2bool(
+            OPTION_DIRECT_SERVER,
+            &Config::get_option(OPTION_DIRECT_SERVER),
+        ) || option2bool("stop-service", &Config::get_option("stop-service"));
+        let port = get_direct_port() as u16;
+        if disabled || listeners.as_ref().map_or(false, |l| l.port() != port) {
+            if listeners.take().is_some() {
+                log::info!("Exit direct access listen");
+            }
+        }
+        if disabled {
+            sleep(1.).await;
+            continue;
+        }
+        let l = listeners.get_or_insert_with(|| {
+            let mut l = LanListeners::new(port);
+            l.refresh();
+            refreshed = Instant::now();
+            log::info!("Direct server listening on: {:?}", l.bound());
+            l
+        });
+        if refreshed.elapsed() >= std::time::Duration::from_secs(3) {
+            l.refresh();
+            refreshed = Instant::now();
+        }
+        let Some((stream, addr)) = l.next(1000).await else {
+            continue;
+        };
+        stream.set_nodelay(true).ok();
+        let Ok(local_addr) = stream.local_addr() else {
+            continue;
+        };
+        let server = server.clone();
+        tokio::spawn(async move {
+            if !admit(local_addr, addr).await {
+                return;
+            }
+            allow_err!(
+                crate::server::create_tcp_connection(
+                    server,
+                    hbb_common::Stream::from(stream, local_addr),
+                    addr,
+                    // RemoteSmith: run the identity handshake on direct connections too (DEF-3).
+                    true,
+                    ConnectionMeta::default(),
+                )
+                .await
+            );
+        });
+    }
+}
