--- /dev/null
+++ b/src/remotesmith_trust/direct_access.rs
@@ -0,0 +1,1128 @@
+//! The direct-access port (21118 by default) accepts LAN peers only (RemoteSmith DEF-14, AC-51).
+//!
+//! Upstream's direct server listens on every interface and serves any source. RemoteSmith keeps
+//! it on (Direct LAN only and LAN-first need it) but refuses, right after `accept` and before
+//! any byte is read or written, every connection that
+//! - arrived on an interface that is not a physical LAN interface (loopback, utun/tun/tap, ppp,
+//!   ipsec, WireGuard, Tailscale/ZeroTier, Windows VPN adapters, ...), or
+//! - comes from an address outside the subnet of the local address it reached (so a VPN or a
+//!   routed network reaching the LAN address is refused too).
+//!
+//! The interface a connection was *received* on is what counts, not only the one owning the
+//! address it reached:
+//! - macOS uses the weak host model: a packet that came in over a VPN (utun) may be addressed to
+//!   the Wi-Fi address, even from a source inside the Wi-Fi subnet when the VPN routes an
+//!   overlapping subnet. So the direct server does not listen on the wildcard address there:
+//!   [`LanListeners`] binds one listener per address of each LAN interface, each pinned to its
+//!   interface with `IP_BOUND_IF` / `IPV6_BOUND_IF`. A socket pinned to en0 only answers out of
+//!   en0, so a handshake that arrived over utun (or loopback) never completes.
+//! - Windows uses the strong host model by default (weak host receive is off): a packet that
+//!   arrives on one adapter for another adapter's address is dropped, so the adapter owning the
+//!   local address is the one that received it. The OS firewall rule for the port is also
+//!   limited to LAN/wireless interface types and the local subnet (platform/windows.rs, the
+//!   MSI's FirewallRules.cpp). Adapters must be positively hardware-backed (`HardwareInterface`
+//!   from GetIfTable2); a Hyper-V vEthernet adapter counts only when it carries the MAC of a
+//!   hardware adapter, which is how an *external* switch's host adapter looks (an internal or
+//!   Default Switch adapter has a generated MAC).
+//!
+//! The subnet check applies on top, on every platform.
+//!
+//! Known limits (deferred; both need an attacker on a VPN that carries an overlapping LAN
+//! prefix, and the identity and password layers still apply):
+//! - macOS: `IP_BOUND_IF` pins the reply path, it is not an ingress filter. A VPN set up with
+//!   asymmetric routing or proxy ARP, so that replies to the peer leave through the LAN
+//!   interface and still reach it, can complete a handshake.
+//! - Windows: VPN clients that turn on weak host receive/send or forwarding on their adapter
+//!   (GlobalProtect does) let a packet that came in over the VPN reach the LAN adapter's
+//!   address, which defeats the destination-owner check; the LAN/wireless-typed firewall rule
+//!   still filters by interface type.
+
+use std::net::{IpAddr, SocketAddr};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Os {
+    Macos,
+    Windows,
+    Other,
+}
+
+pub fn this_os() -> Os {
+    if cfg!(target_os = "macos") {
+        Os::Macos
+    } else if cfg!(windows) {
+        Os::Windows
+    } else {
+        Os::Other
+    }
+}
+
+/// The interface kinds the classifier cares about (from `default_net::InterfaceType`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Ethernet,
+    Wireless,
+    Loopback,
+    Tunnel,
+    Ppp,
+    Other,
+}
+
+/// One local interface, reduced to what the decision needs.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Iface {
+    pub index: u32,
+    pub name: String,
+    /// Windows: friendly name and adapter description, joined; empty elsewhere.
+    pub description: String,
+    pub kind: Kind,
+    /// Addresses with their on-link prefix length.
+    pub nets: Vec<(IpAddr, u8)>,
+    /// Windows: what the adapter is backed by (GetIfTable2). `None` elsewhere, or when it could
+    /// not be read (then a Windows adapter is not LAN: fail closed).
+    pub hw: Option<Hw>,
+}
+
+/// Windows adapter facts from `MIB_IF_ROW2`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct Hw {
+    /// `InterfaceAndOperStatusFlags.HardwareInterface`: a physical NIC, not a virtual adapter.
+    pub hardware: bool,
+    pub mac: Option<[u8; 6]>,
+}
+
+/// Windows: hardware-backed, or a virtual adapter carrying a hardware adapter's MAC (the host
+/// adapter of a Hyper-V external switch, bound to that NIC). Internal/Default Switch, VPN, TAP,
+/// Wintun and VM host-only adapters have MACs of their own, so they are not.
+fn windows_hardware_backed(iface: &Iface, all: &[Iface]) -> bool {
+    let Some(hw) = iface.hw else {
+        return false;
+    };
+    if hw.hardware {
+        return true;
+    }
+    let Some(mac) = hw.mac.filter(|m| m.iter().any(|b| *b != 0)) else {
+        return false;
+    };
+    all.iter().any(|o| {
+        o.index != iface.index
+            && o.hw.map_or(false, |h| h.hardware && h.mac == Some(mac))
+            && matches!(o.kind, Kind::Ethernet | Kind::Wireless)
+    })
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Refusal {
+    /// No local interface owns the address the connection reached (or the platform does not
+    /// list it, e.g. a Windows adapter type outside the known set). Fail closed.
+    UnknownInterface,
+    /// The connection reached an interface that is not a physical LAN interface.
+    NotLan { iface: String },
+    /// The source is not on the subnet of the local address it reached.
+    OutsideSubnet { iface: String },
+}
+
+impl std::fmt::Display for Refusal {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Refusal::UnknownInterface => write!(f, "no LAN interface owns the local address"),
+            Refusal::NotLan { iface } => write!(f, "interface {iface} is not a LAN interface"),
+            Refusal::OutsideSubnet { iface } => {
+                write!(f, "source is outside the local subnet of {iface}")
+            }
+        }
+    }
+}
+
+/// Adapter names/descriptions of VPN and overlay software that presents itself as Ethernet on
+/// Windows (TAP adapters, some vendor clients). Lowercase substrings.
+const WINDOWS_VPN_MARKERS: &[&str] = &[
+    "vpn",
+    "tap-windows",
+    "tap-win32",
+    "tap adapter",
+    "wireguard",
+    "wintun",
+    "openvpn",
+    "tailscale",
+    "zerotier",
+    "anyconnect",
+    "fortinet",
+    "fortissl",
+    "pangp",
+    "globalprotect",
+    "juniper",
+    "pulse secure",
+    "sonicwall",
+    "nordlynx",
+    "hamachi",
+    "softether",
+    "array networks",
+    "f5 networks",
+    "checkpoint",
+    "check point",
+    "zscaler",
+    "sophos",
+    "barracuda",
+    "pritunl",
+    "nebula",
+    // Host-internal virtual networks (VM and WSL guests), never the physical LAN. (Backup for
+    // the hardware check; a Hyper-V *external* switch adapter passes it by MAC.)
+    "vmware",
+    "virtualbox",
+    "host-only",
+    "(wsl",
+    "default switch",
+];
+
+/// Interface name prefixes that are never LAN on Linux/BSD.
+const UNIX_NON_LAN_PREFIXES: &[&str] = &[
+    "lo", "tun", "tap", "ppp", "wg", "zt", "tailscale", "utun", "ipsec", "gif", "stf", "docker",
+    "br-", "veth", "virbr", "vmnet", "vboxnet", "awdl", "llw", "bridge", "anpi", "ap",
+];
+
+/// Whether `iface` is a physical LAN interface on `os`. `all` is the machine's interface list
+/// (Windows matches a virtual adapter's MAC against the hardware ones).
+pub fn is_lan_interface(os: Os, iface: &Iface, all: &[Iface]) -> bool {
+    if matches!(iface.kind, Kind::Loopback | Kind::Tunnel | Kind::Ppp) {
+        return false;
+    }
+    let name = iface.name.to_ascii_lowercase();
+    match os {
+        // macOS names every wired and Wi-Fi port (built-in, USB, Thunderbolt) enN. Everything
+        // else is virtual: utun (VPNs, iCloud Private Relay), ipsec, ppp, gif/stf, awdl/llw
+        // (AirDrop), bridgeN (Internet Sharing, VMs, Thunderbolt Bridge), anpi, vmenet, ...
+        Os::Macos => {
+            name.len() > 2
+                && name.starts_with("en")
+                && name[2..].chars().all(|c| c.is_ascii_digit())
+        }
+        // Windows names adapters freely. Only wired and Wi-Fi types, positively backed by
+        // hardware (see [`windows_hardware_backed`]), and no VPN/virtual product name as a
+        // second line of defence. (Wintun/WireGuard adapters have a type default_net does not
+        // list, so they never get here.)
+        Os::Windows => {
+            let desc = format!("{} {}", name, iface.description.to_ascii_lowercase());
+            matches!(iface.kind, Kind::Ethernet | Kind::Wireless)
+                && windows_hardware_backed(iface, all)
+                && !WINDOWS_VPN_MARKERS.iter().any(|m| desc.contains(m))
+        }
+        Os::Other => {
+            matches!(iface.kind, Kind::Ethernet | Kind::Wireless)
+                && !UNIX_NON_LAN_PREFIXES.iter().any(|p| name.starts_with(p))
+        }
+    }
+}
+
+/// `a` and `b` share the first `prefix` bits (same family only).
+fn same_subnet(a: &IpAddr, b: &IpAddr, prefix: u8) -> bool {
+    match (a, b) {
+        (IpAddr::V4(a), IpAddr::V4(b)) => {
+            // A degenerate mask (shorter than /8) would make "the subnet" the internet.
+            if !(8..=32).contains(&prefix) {
+                return false;
+            }
+            let mask = u32::MAX.checked_shl(32 - prefix as u32).unwrap_or(0);
+            (u32::from(*a) & mask) == (u32::from(*b) & mask)
+        }
+        (IpAddr::V6(a), IpAddr::V6(b)) => {
+            if !(32..=128).contains(&prefix) {
+                return false;
+            }
+            let mask = u128::MAX.checked_shl(128 - prefix as u32).unwrap_or(0);
+            (u128::from(*a) & mask) == (u128::from(*b) & mask)
+        }
+        _ => false,
+    }
+}
+
+fn scope_of(addr: &SocketAddr) -> u32 {
+    match addr {
+        SocketAddr::V6(v6) => v6.scope_id(),
+        SocketAddr::V4(_) => 0,
+    }
+}
+
+/// Decide one accepted connection. `local` is the socket's local address (the address the peer
+/// reached), `peer` its source. IPv4-mapped IPv6 addresses (the dual-stack listener) count as
+/// IPv4. Returns the interface name on success.
+pub fn check(os: Os, local: &SocketAddr, peer: &SocketAddr, ifaces: &[Iface]) -> Result<String, Refusal> {
+    let local_ip = local.ip().to_canonical();
+    let peer_ip = peer.ip().to_canonical();
+    let scope = if local_ip.is_ipv6() { scope_of(local) } else { 0 };
+    let owners: Vec<&Iface> = ifaces
+        .iter()
+        .filter(|i| scope == 0 || i.index == scope)
+        .filter(|i| i.nets.iter().any(|(ip, _)| ip.to_canonical() == local_ip))
+        .collect();
+    if owners.is_empty() {
+        return Err(Refusal::UnknownInterface);
+    }
+    // The same address on two interfaces is ambiguous; every owner must be LAN (fail closed).
+    if let Some(bad) = owners.iter().find(|i| !is_lan_interface(os, i, ifaces)) {
+        return Err(Refusal::NotLan {
+            iface: bad.name.clone(),
+        });
+    }
+    if peer_ip.is_loopback() || peer_ip.is_unspecified() {
+        return Err(Refusal::OutsideSubnet {
+            iface: owners[0].name.clone(),
+        });
+    }
+    for iface in &owners {
+        // The peer must be on-link for the very address it reached.
+        let on_link = iface.nets.iter().any(|(ip, prefix)| {
+            ip.to_canonical() == local_ip && same_subnet(&local_ip, &peer_ip, *prefix)
+        });
+        if on_link {
+            return Ok(iface.name.clone());
+        }
+    }
+    Err(Refusal::OutsideSubnet {
+        iface: owners[0].name.clone(),
+    })
+}
+
+fn kind_of(t: default_net::interface::InterfaceType) -> Kind {
+    use default_net::interface::InterfaceType as T;
+    match t {
+        T::Ethernet | T::GigabitEthernet | T::FastEthernetT | T::FastEthernetFx => Kind::Ethernet,
+        T::Wireless80211 => Kind::Wireless,
+        T::Loopback => Kind::Loopback,
+        T::Tunnel => Kind::Tunnel,
+        T::Ppp => Kind::Ppp,
+        _ => Kind::Other,
+    }
+}
+
+/// macOS getifaddrs may return link-local IPv6 addresses with the KAME-embedded scope in the
+/// second 16-bit group (fe80:N::...); the socket's own address never has it.
+fn strip_embedded_scope(ip: std::net::Ipv6Addr) -> std::net::Ipv6Addr {
+    let mut s = ip.segments();
+    if (s[0] & 0xffc0) == 0xfe80 {
+        s[1] = 0;
+    }
+    std::net::Ipv6Addr::from(s)
+}
+
+/// This machine's interfaces, at most 2 s old: one listing serves a burst of connections, so a
+/// flood of the port cannot turn into a flood of interface enumerations.
+pub fn local_interfaces_cached() -> Vec<Iface> {
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+    static CACHE: Mutex<Option<(Instant, Vec<Iface>)>> = Mutex::new(None);
+    let mut c = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((at, v)) = c.as_ref() {
+        if at.elapsed() < Duration::from_secs(2) {
+            return v.clone();
+        }
+    }
+    let v = local_interfaces();
+    *c = Some((Instant::now(), v.clone()));
+    v
+}
