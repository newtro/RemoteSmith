From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Scott Smith <scott@newtrostudios.com>
Date: Mon, 12 Oct 2026 20:03:57 -0400
Subject: remotesmith(0601): start the bundled menu-bar tray at login

The release build embeds the sidecar (DEC-20) as a login-item helper app,
Contents/Library/LoginItems/RemoteSmith Tray.app. The main window registers
it once with SMAppService (macOS 13+) and launches it if it is not running.
Builds without the helper are unchanged. Serves B5 / FLOW-1 / AC-1.
---
 flutter/macos/Runner/AppDelegate.swift | 40 ++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/flutter/macos/Runner/AppDelegate.swift b/flutter/macos/Runner/AppDelegate.swift
index 46372a5822fc..29b841b279da 100644
--- a/flutter/macos/Runner/AppDelegate.swift
+++ b/flutter/macos/Runner/AppDelegate.swift
@@ -1,5 +1,6 @@
 import Cocoa
 import FlutterMacOS
+import ServiceManagement
 
 @main
 class AppDelegate: FlutterAppDelegate {
@@ -20,5 +21,44 @@ class AppDelegate: FlutterAppDelegate {
     override func applicationDidFinishLaunching(_ aNotification: Notification) {
         launched = true;
         NSApplication.shared.activate(ignoringOtherApps: true);
+        remotesmithStartTray()
+    }
+}
+
+// RemoteSmith (DEC-20): the menu-bar sidecar ships as a login-item helper app inside this bundle,
+// Contents/Library/LoginItems/RemoteSmith Tray.app. When the main window starts (no arguments, so
+// not --server/--cm/--connect child processes), register it once with SMAppService so it starts at
+// login, and launch it if it is not running. Unregistering is left to the user (System Settings >
+// General > Login Items), and a deliberate opt-out is remembered and not undone. Builds without
+// the helper (plain build.py / flutter build) skip all of this.
+let remotesmithTrayBundleId = "ai.johnnycode.remotesmith.tray"
+let remotesmithTrayRegisteredKey = "RemoteSmithTrayLoginItemRegistered"
+
+func remotesmithStartTray() {
+    guard CommandLine.arguments.count <= 1 else { return }
+    let helper = Bundle.main.bundleURL
+        .appendingPathComponent("Contents/Library/LoginItems/RemoteSmith Tray.app")
+    guard FileManager.default.fileExists(atPath: helper.path) else { return }
+    if #available(macOS 13.0, *) {
+        let service = SMAppService.loginItem(identifier: remotesmithTrayBundleId)
+        let defaults = UserDefaults.standard
+        if service.status == .notRegistered && !defaults.bool(forKey: remotesmithTrayRegisteredKey) {
+            do {
+                try service.register()
+                defaults.set(true, forKey: remotesmithTrayRegisteredKey)
+            } catch {
+                NSLog("RemoteSmith: could not register the tray login item: \(error)")
+            }
+        }
+    }
+    let running = NSRunningApplication.runningApplications(withBundleIdentifier: remotesmithTrayBundleId)
+    guard running.isEmpty else { return }
+    let config = NSWorkspace.OpenConfiguration()
+    config.activates = false
+    config.addsToRecentItems = false
+    NSWorkspace.shared.openApplication(at: helper, configuration: config) { _, error in
+        if let error = error {
+            NSLog("RemoteSmith: could not start the tray: \(error)")
+        }
     }
 }
