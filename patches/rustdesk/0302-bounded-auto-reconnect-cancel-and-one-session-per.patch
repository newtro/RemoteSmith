+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const CE: &str = "Connection Error";
+
+    fn secs(s: u64) -> Duration {
+        Duration::from_secs(s)
+    }
+
+    #[test]
+    fn delays_double_up_to_the_cap() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        let delays: Vec<_> = (0..6)
+            .map(|i| p.on_msgbox(t0 + secs(i), "error", CE, "Reset by the peer", true))
+            .collect();
+        assert_eq!(
+            delays,
+            [1, 2, 4, 8, 8, 8].map(|s| Decision::RetryIn(secs(s))).to_vec()
+        );
+    }
+
+    #[test]
+    fn transient_failures_after_a_drop_are_retried_even_when_upstream_would_not() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        assert!(matches!(
+            p.on_msgbox(t0, "error", CE, "Reset by the peer", true),
+            Decision::RetryIn(_)
+        ));
+        // The network is still down / the host is rebooting.
+        for text in [
+            "Failed to connect to rendezvous server: Please try later",
+            "Remote desktop is offline",
+            "Timeout",
+        ] {
+            assert!(
+                matches!(p.on_msgbox(t0 + secs(5), "error", CE, text, false), Decision::RetryIn(_)),
+                "{text}"
+            );
+        }
+    }
+
+    #[test]
+    fn before_the_first_login_upstream_classification_decides() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        assert_eq!(
+            p.on_msgbox(t0, "error", CE, "Remote desktop is offline", false),
+            Decision::NoRetry
+        );
+        assert!(matches!(
+            p.on_msgbox(t0, "error", CE, "Reset by the peer", true),
+            Decision::RetryIn(_)
+        ));
+    }
+
+    #[test]
+    fn auth_refusals_and_identity_problems_are_never_retried() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        for text in [
+            "Wrong Password",
+            CLOSE_REASON_PASSWORD_CHANGED,
+            "Closed manually by the peer",
+            "Key mismatch",
+            "ID does not exist",
+            "Peer identity mismatch",
+            "Connection not allowed",
+        ] {
+            assert_eq!(p.on_msgbox(t0, "error", CE, text, true), Decision::NoRetry, "{text}");
+        }
+    }
+
+    #[test]
+    fn the_streak_ends_sixty_seconds_after_its_first_failure() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        for _ in 0..4 {
+            assert!(matches!(p.on_msgbox(t0, "error", CE, "Timeout", true), Decision::RetryIn(_)));
+        }
+        // The delay is at its 8 s cap now, but the last one never runs past the window.
+        assert_eq!(
+            p.on_msgbox(t0 + secs(57), "error", CE, "Timeout", true),
+            Decision::RetryIn(secs(3))
+        );
+        assert_eq!(
+            p.on_msgbox(t0 + secs(60), "error", CE, "Timeout", true),
+            Decision::GiveUp
+        );
+        assert!(p.last_delay().is_none());
+    }
+
+    #[test]
+    fn cancel_stops_retrying_until_a_manual_reconnect() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        assert!(matches!(p.on_msgbox(t0, "error", CE, "Timeout", true), Decision::RetryIn(_)));
+        assert!(p.in_streak());
+        p.cancel();
+        assert!(!p.in_streak());
+        assert_eq!(p.on_msgbox(t0 + secs(1), "error", CE, "Timeout", true), Decision::GiveUp);
+        p.on_manual_reconnect();
+        assert_eq!(
+            p.on_msgbox(t0 + secs(2), "error", CE, "Timeout", true),
+            Decision::RetryIn(secs(1))
+        );
+    }
+
+    #[test]
+    fn a_closed_session_is_never_reopened() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        assert!(matches!(p.on_msgbox(t0, "error", CE, "Timeout", true), Decision::RetryIn(_)));
+        p.on_user_closed();
+        assert!(p.should_abort());
+        assert_eq!(p.on_msgbox(t0, "error", CE, "Timeout", true), Decision::NoRetry);
+        p.on_manual_reconnect();
+        assert!(p.should_abort() && p.is_closed());
+    }
+
+    #[test]
+    fn a_cancelled_streak_aborts_a_late_connect_until_reconnect() {
+        let mut p = RetryPolicy::default();
+        assert!(!p.should_abort());
+        p.cancel();
+        assert!(p.should_abort());
+        p.on_manual_reconnect();
+        assert!(!p.should_abort());
+    }
+
+    #[test]
+    fn a_successful_login_resets_the_window() {
+        let t0 = Instant::now();
+        let mut p = RetryPolicy::default();
+        p.on_connected();
+        p.on_msgbox(t0, "error", CE, "Timeout", true);
+        p.on_connected();
+        assert!(!p.in_streak());
+        assert_eq!(
+            p.on_msgbox(t0 + secs(100), "error", CE, "Timeout", true),
+            Decision::RetryIn(secs(1))
+        );
+    }
+
+    #[test]
+    fn other_msgboxes_pass_through() {
+        let mut p = RetryPolicy::default();
+        assert_eq!(
+            p.on_msgbox(Instant::now(), "input-password", "Password Required", "", false),
+            Decision::NoRetry
+        );
+        assert!(!p.in_streak());
+    }
+}
