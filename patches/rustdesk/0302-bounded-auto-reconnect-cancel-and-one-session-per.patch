+++ b/src/remotesmith_trust/reconnect.rs
@@ -0,0 +1,350 @@
+//! Controller reconnect policy (RemoteSmith DEF-7, AC-24, AC-46).
+//!
+//! Upstream retries a retryable "Connection Error" forever, doubling the delay, and only for a
+//! narrow set of texts: once a session has dropped, the very next attempt usually fails with
+//! "Failed to connect ..." or "offline" (the network is still down, the host is rebooting), which
+//! upstream treats as final. RemoteSmith's rule:
+//!
+//! - Before the first successful login, upstream's classification decides, but the streak is
+//!   bounded like any other.
+//! - After a session was up, any transient failure is retried; auth failures, refusals and
+//!   identity problems never are.
+//! - Retries stop 60 s after the first failure of the streak, or at once on Cancel. The UI then
+//!   shows "Disconnected — Reconnect"; only a manual Reconnect starts a new streak.
+//! - Upstream never reopens a session the user closed (closing removes the session, and with it
+//!   this state); nothing here changes that.
+
+use std::time::{Duration, Instant};
+
+/// How long a streak of failed attempts is retried (DEF-7).
+pub const RETRY_WINDOW: Duration = Duration::from_secs(60);
+/// Delay before the first retry; doubles per attempt up to [`MAX_DELAY`].
+pub const FIRST_DELAY: Duration = Duration::from_secs(1);
+pub const MAX_DELAY: Duration = Duration::from_secs(8);
+
+/// Msgbox the UI renders as "Disconnected — Reconnect".
+pub const MSGBOX_DISCONNECTED: &str = "remotesmith-disconnected-nocancel";
+pub const DISCONNECTED_TITLE: &str = "Disconnected";
+pub const DISCONNECTED_TEXT: &str = "remotesmith-disconnected-tip";
+
+/// Close reason the host sends when its password changed (AC-39). Never retried: the saved
+/// credential no longer works.
+pub const CLOSE_REASON_PASSWORD_CHANGED: &str = "Session closed by the peer: its password changed";
+
+/// Failures that are never worth another attempt, whatever came before.
+const PERMANENT: &[&str] = &[
+    "manually",
+    "restricted",
+    "incoming only",
+    "not allowed",
+    "mismatch",
+    "not exist",
+    "password",
+    "identity",
+];
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Decision {
+    /// Not a retryable connection failure: show it as upstream does.
+    NoRetry,
+    /// Retry after this delay.
+    RetryIn(Duration),
+    /// The streak is over (window spent or cancelled): show "Disconnected — Reconnect".
+    GiveUp,
+}
+
+#[derive(Debug, Default, Clone)]
+pub struct RetryPolicy {
+    /// A login succeeded at least once in this session.
+    established: bool,
+    first_failure: Option<Instant>,
+    attempts: u32,
+    cancelled: bool,
+    /// The user closed the session. Sticky: nothing reopens it.
+    closed: bool,
+    last_delay: Option<Duration>,
+}
+
+/// Whether `text` describes a connection failure (as opposed to any other msgbox).
+pub fn is_connection_failure(msgtype: &str, title: &str) -> bool {
+    msgtype == "error" && title == "Connection Error"
+}
+
+fn is_permanent(text: &str) -> bool {
+    let t = text.to_lowercase();
+    PERMANENT.iter().any(|p| t.contains(p))
+}
+
+impl RetryPolicy {
+    /// A login succeeded: the session is up and any streak is over.
+    pub fn on_connected(&mut self) {
+        self.established = true;
+        self.first_failure = None;
+        self.attempts = 0;
+        self.cancelled = false;
+        self.last_delay = None;
+    }
+
+    /// The user pressed Reconnect on "Disconnected": a fresh streak.
+    pub fn on_manual_reconnect(&mut self) {
+        if self.closed {
+            return;
+        }
+        self.first_failure = None;
+        self.attempts = 0;
+        self.cancelled = false;
+        self.last_delay = None;
+    }
+
+    /// The user pressed Cancel during a reconnect: no more automatic attempts.
+    pub fn cancel(&mut self) {
+        self.cancelled = true;
+        self.last_delay = None;
+    }
+
+    /// A login succeeded at least once in this session.
+    pub fn is_established(&self) -> bool {
+        self.established
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.cancelled
+    }
+
+    /// The user closed the session (tab or window): it must never be reopened (AC-24).
+    pub fn on_user_closed(&mut self) {
+        self.closed = true;
+        self.cancelled = true;
+        self.last_delay = None;
+    }
+
+    pub fn is_closed(&self) -> bool {
+        self.closed
+    }
+
+    /// Whether a connect that just completed must be dropped instead of logged in: the user
+    /// cancelled the reconnect or closed the session while it was in flight.
+    pub fn should_abort(&self) -> bool {
+        self.closed || self.cancelled
+    }
+
+    /// Whether automatic reconnecting is in progress (a streak has started and not ended).
+    pub fn in_streak(&self) -> bool {
+        self.first_failure.is_some() && !self.cancelled
+    }
+
+    /// The delay chosen by the last [`Decision::RetryIn`], for the UI's countdown.
+    pub fn last_delay(&self) -> Option<Duration> {
+        self.last_delay
+    }
+
+    /// Decide what follows a msgbox. `upstream_retry` is upstream's `check_if_retry` verdict.
+    pub fn on_msgbox(
+        &mut self,
+        now: Instant,
+        msgtype: &str,
+        title: &str,
+        text: &str,
+        upstream_retry: bool,
+    ) -> Decision {
+        if self.closed {
+            return Decision::NoRetry;
+        }
+        if !is_connection_failure(msgtype, title) {
+            return if upstream_retry {
+                // Not a shape this policy knows; leave upstream's behaviour alone.
+                Decision::RetryIn(FIRST_DELAY)
+            } else {
+                Decision::NoRetry
+            };
+        }
+        let retryable = !is_permanent(text) && (self.established || upstream_retry);
+        if !retryable {
+            self.first_failure = None;
+            self.attempts = 0;
+            self.last_delay = None;
+            return Decision::NoRetry;
+        }
+        if self.cancelled {
+            return Decision::GiveUp;
+        }
+        let first = *self.first_failure.get_or_insert(now);
+        let elapsed = now.saturating_duration_since(first);
+        if elapsed >= RETRY_WINDOW {
+            self.last_delay = None;
+            return Decision::GiveUp;
+        }
+        let delay = FIRST_DELAY
+            .checked_mul(1u32 << self.attempts.min(16))
+            .unwrap_or(MAX_DELAY)
+            .min(MAX_DELAY)
+            // The last attempt starts inside the window, not after it.
+            .min(RETRY_WINDOW - elapsed);
+        self.attempts += 1;
+        self.last_delay = Some(delay);
+        Decision::RetryIn(delay)
+    }
+}
