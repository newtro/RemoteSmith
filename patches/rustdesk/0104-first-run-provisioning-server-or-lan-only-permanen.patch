+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn host_validation() {
+        for ok in [
+            "rs.example.com",
+            "rs.example.com:21116",
+            "10.0.0.5",
+            "10.0.0.5:21116",
+            "my-server",
+            "[2001:db8::1]:21116",
+            "  rs.example.com  ",
+        ] {
+            assert!(validate_server_host(ok).is_ok(), "{ok}");
+        }
+        for bad in [
+            "",
+            "   ",
+            "https://rs.example.com",
+            "rs.example.com/path",
+            "rs example.com",
+            "rs.example.com:0",
+            "rs.example.com:99999",
+            "rs.example.com:abc",
+            ":21116",
+            "-bad.example.com",
+            "bad_name.example.com",
+            "[2001:db8::1",
+            "[2001:db8::1]",
+            "[2001:db8::1]:",
+            "2001:db8::1",
+            "::1",
+            "[nope]:21116",
+            "2001:db8::zz",
+        ] {
+            assert!(validate_server_host(bad).is_err(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn key_validation() {
+        // A real-format key: 32 bytes, standard base64 (44 chars with one '=').
+        let key = "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=";
+        assert_eq!(key.len(), 44);
+        assert!(validate_server_key(key).is_ok());
+        assert!(validate_server_key(&format!(" {key}\n")).is_ok());
+        assert!(validate_server_key("").is_err());
+        assert!(validate_server_key(&key[..43]).is_err());
+        assert!(validate_server_key(&format!("{key}A")).is_err());
+        // 44 characters but not base64.
+        assert!(validate_server_key("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!=").is_err());
+        // 44 characters of base64 that decode to 33 bytes (no padding).
+        assert!(validate_server_key("MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWZn").is_err());
+    }
+
+    #[test]
+    fn password_validation() {
+        assert!(validate_permanent_password("").is_err());
+        assert!(validate_permanent_password("elevenchars").is_err());
+        assert!(validate_permanent_password("   elevenchars   ").is_err());
+        assert!(validate_permanent_password("twelve-chars").is_ok());
+        // Characters, not bytes.
+        assert!(validate_permanent_password("ééééééééééé").is_err());
+    }
+
+    #[test]
+    fn generated_passwords() {
+        let a = generate_password();
+        let b = generate_password();
+        assert_eq!(a.chars().count(), GENERATED_PASSWORD_LEN);
+        assert!(validate_permanent_password(&a).is_ok());
+        assert!(a.bytes().all(|c| PASSWORD_CHARS.contains(&c)));
+        assert_ne!(a, b);
+        for _ in 0..200 {
+            let p = generate_password();
+            assert!(p.chars().any(|c| c.is_ascii_digit()), "{p}");
+            assert!(p.chars().any(|c| c.is_ascii_lowercase()), "{p}");
+            assert!(p.chars().any(|c| c.is_ascii_uppercase()), "{p}");
+        }
+    }
+
+    #[test]
+    fn provisioning_state() {
+        // Fresh install: nothing set.
+        assert!(needs_provisioning("", false, false));
+        // A route but no password, or a password but no route.
+        assert!(needs_provisioning("rs.example.com", false, false));
+        assert!(needs_provisioning("", true, false));
+        assert!(needs_provisioning("", false, true));
+        assert!(needs_provisioning("   ", false, true));
+        // Done.
+        assert!(!needs_provisioning("rs.example.com", false, true));
+        assert!(!needs_provisioning("", true, true));
+    }
+
+    #[test]
+    fn cli_option_validation() {
+        assert!(validate_option(OPTION_ID_SERVER, "rs.example.com:21116").is_ok());
+        assert!(validate_option(OPTION_ID_SERVER, "http://x").is_err());
+        assert!(validate_option(OPTION_ID_SERVER, "").is_ok()); // clearing is allowed
+        assert!(validate_option(OPTION_KEY, "short").is_err());
+        assert!(validate_option(OPTION_KEY, "").is_ok());
+        assert!(validate_option(OPTION_LAN_ONLY, "Y").is_ok());
+        assert!(validate_option(OPTION_LAN_ONLY, "yes").is_err());
+        assert!(validate_option("direct-server", "anything").is_ok());
+    }
+
+    #[test]
+    fn no_personal_defaults() {
+        // DEC-15 / AC-33: the source carries no server host or key.
+        let src = include_str!("remotesmith.rs");
+        assert!(!src.contains(&["johnnycode", ".ai"].concat()));
+    }
