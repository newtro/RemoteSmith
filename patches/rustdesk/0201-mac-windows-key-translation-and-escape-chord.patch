+//! RemoteSmith key-mapping contract (DEC-6 / DEC-22, PLAN §6.1).
+//!
+//! Translation happens on the controller, on the key events upstream has already built for the
+//! peer (`keyboard::event_to_key_events`), so the host stays stock. Only the modifier keys are
+//! rewritten; every other key is forwarded as upstream built it.
+//!
+//! Translated mode, Mac controller -> Windows host: Cmd->Ctrl, Ctrl->Ctrl, Option->Alt, and
+//! Cmd+Tab->Alt+Tab. Windows controller -> Mac host: Ctrl->Cmd, Win->Ctrl, Alt->Option, and
+//! Alt+Tab->Cmd+Tab. Raw mode (translation off) is upstream's map mode untouched.
+//!
+//! The escape chord (Ctrl+Option+Cmd+Esc on a Mac, Ctrl+Alt+Win+Esc on Windows: the same physical
+//! keys) is matched on physical keys before any mapping, in both modes, and Esc is never forwarded.
+//!
+//! The pure parts (`direction`, `Translator`, `ChordTracker`, `translate_with`) carry the unit
+//! tests; `keyboard.rs` holds the glue that sends events and releases capture.
+
+use base::message_proto::*;
+use hbb_common::protobuf::EnumOrUnknown;
+use rdev::{Event, EventType, Key};
+use std::sync::Mutex;
+
+/// Peer option: "Y" or empty = translate when the OSes differ (the default), "N" = raw keys.
+pub const OPTION_TRANSLATE_SHORTCUTS: &str = "remotesmith-translate-shortcuts";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Direction {
+    /// Raw keys, or no translation defined for this OS pair.
+    #[default]
+    None,
+    MacToWindows,
+    WindowsToMac,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LocalOs {
+    MacOs,
+    Windows,
+    Other,
+}
+
+pub fn local_os() -> LocalOs {
+    if cfg!(target_os = "macos") {
+        LocalOs::MacOs
+    } else if cfg!(target_os = "windows") {
+        LocalOs::Windows
+    } else {
+        LocalOs::Other
+    }
+}
+
+/// Upstream's peer platform strings ("Mac OS", "Windows") in keyboard.rs's form ("macos", "windows").
+pub fn normalize_peer(peer_platform: &str) -> String {
+    peer_platform
+        .chars()
+        .filter(|c| !c.is_whitespace())
+        .collect::<String>()
+        .to_lowercase()
+}
+
+/// The mapping in force for a session: `option` is the peer's OPTION_TRANSLATE_SHORTCUTS value.
+pub fn direction(local: LocalOs, peer_platform: &str, option: &str) -> Direction {
+    if option == "N" {
+        return Direction::None;
+    }
+    match (local, normalize_peer(peer_platform).as_str()) {
+        (LocalOs::MacOs, "windows") => Direction::MacToWindows,
+        (LocalOs::Windows, "macos") => Direction::WindowsToMac,
+        _ => Direction::None,
+    }
+}
+
+/// The mapping for a session, from its peer platform and peer option.
+pub fn session_direction<T: crate::ui_session_interface::InvokeUiSession>(
+    session: &crate::ui_session_interface::Session<T>,
+) -> Direction {
+    direction(
+        local_os(),
+        &session.peer_platform(),
+        &session.get_option(OPTION_TRANSLATE_SHORTCUTS.to_owned()),
+    )
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Mod {
+    Ctrl,
+    Alt,
+    Meta,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Side {
+    Left,
+    Right,
+}
+
+/// A Ctrl/Alt/Meta key with its side. Shift is never remapped, so it is not modelled.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct ModKey {
+    pub m: Mod,
+    pub side: Side,
+}
+
+impl ModKey {
+    pub const fn new(m: Mod, side: Side) -> Self {
+        Self { m, side }
+    }
+
+    pub fn from_rdev(key: Key) -> Option<Self> {
+        Some(match key {
+            Key::ControlLeft => Self::new(Mod::Ctrl, Side::Left),
+            Key::ControlRight => Self::new(Mod::Ctrl, Side::Right),
+            Key::Alt => Self::new(Mod::Alt, Side::Left),
+            Key::AltGr => Self::new(Mod::Alt, Side::Right),
+            Key::MetaLeft => Self::new(Mod::Meta, Side::Left),
+            Key::MetaRight => Self::new(Mod::Meta, Side::Right),
+            _ => return None,
+        })
+    }
+
+    pub fn to_rdev(self) -> Key {
+        match (self.m, self.side) {
+            (Mod::Ctrl, Side::Left) => Key::ControlLeft,
+            (Mod::Ctrl, Side::Right) => Key::ControlRight,
+            (Mod::Alt, Side::Left) => Key::Alt,
+            (Mod::Alt, Side::Right) => Key::AltGr,
+            (Mod::Meta, Side::Left) => Key::MetaLeft,
+            (Mod::Meta, Side::Right) => Key::MetaRight,
+        }
+    }
+
+    pub fn from_control_key(ck: ControlKey) -> Option<Self> {
+        Some(match ck {
+            ControlKey::Control => Self::new(Mod::Ctrl, Side::Left),
+            ControlKey::RControl => Self::new(Mod::Ctrl, Side::Right),
+            ControlKey::Alt => Self::new(Mod::Alt, Side::Left),
+            ControlKey::RAlt => Self::new(Mod::Alt, Side::Right),
+            ControlKey::Meta => Self::new(Mod::Meta, Side::Left),
+            ControlKey::RWin => Self::new(Mod::Meta, Side::Right),
+            _ => return None,
+        })
+    }
+
+    pub fn to_control_key(self) -> ControlKey {
+        match (self.m, self.side) {
+            (Mod::Ctrl, Side::Left) => ControlKey::Control,
+            (Mod::Ctrl, Side::Right) => ControlKey::RControl,
+            (Mod::Alt, Side::Left) => ControlKey::Alt,
+            (Mod::Alt, Side::Right) => ControlKey::RAlt,
+            (Mod::Meta, Side::Left) => ControlKey::Meta,
+            (Mod::Meta, Side::Right) => ControlKey::RWin,
+        }
+    }
+
+    /// The key code map/translate mode puts in `KeyEvent.chr` for this key on `peer` ("windows"
+    /// scancodes, "macos" virtual key codes), from the same rdev tables upstream maps with.
+    pub fn peer_code(self, peer: &str) -> u32 {
+        let key = self.to_rdev();
+        match peer {
+            "windows" => rdev::win_scancode_from_key(key).unwrap_or_default(),
+            "macos" => rdev::macos_keycode_from_key(key).unwrap_or_default() as u32,
+            _ => rdev::linux_keycode_from_key(key).unwrap_or_default(),
+        }
+    }
+}
+
+/// Translated-mode modifier table (PLAN §6.1).
+pub fn base_mod(dir: Direction, m: Mod) -> Mod {
+    match (dir, m) {
+        (Direction::MacToWindows, Mod::Meta) => Mod::Ctrl,
+        (Direction::WindowsToMac, Mod::Ctrl) => Mod::Meta,
+        (Direction::WindowsToMac, Mod::Meta) => Mod::Ctrl,
+        _ => m,
+    }
+}
+
+/// App switching: (physical modifier the controller's OS switches with, host's switch modifier).
+fn switcher(dir: Direction) -> Option<(Mod, Mod)> {
+    match dir {
+        Direction::MacToWindows => Some((Mod::Meta, Mod::Alt)),
+        Direction::WindowsToMac => Some((Mod::Alt, Mod::Meta)),
+        Direction::None => None,
+    }
+}
+
+/// One modifier transition to send to the host.
+pub type ModOut = (ModKey, bool);
+
+/// Tracks which host modifier each held physical modifier was sent as, with a count per host key
+/// so two physical keys mapped to one host key (Mac Cmd and Ctrl both -> Ctrl) press it once and
+/// release it after the last of them.
+#[derive(Debug, Default)]
+pub struct Translator {
+    dir: Direction,
+    held: Vec<(ModKey, ModKey)>,
+    emitted: Vec<(ModKey, u32)>,
+}
+
+impl Translator {
+    /// Change the mapping. Everything sent under the old mapping is released first (AC-59).
+    pub fn set_direction(&mut self, dir: Direction) -> Vec<ModOut> {
+        if dir == self.dir {
+            return Vec::new();
+        }
+        let out = self.release_all();
+        self.dir = dir;
+        out
+    }
+
+    /// Key-ups for every host modifier still held; forgets all physical state.
+    pub fn release_all(&mut self) -> Vec<ModOut> {
+        self.held.clear();
+        self.emitted
+            .drain(..)
+            .filter(|(_, n)| *n > 0)
+            .map(|(k, _)| (k, false))
+            .collect()
+    }
+
+    #[cfg(test)]
+    pub fn is_idle(&self) -> bool {
+        self.held.is_empty() && self.emitted.is_empty()
+    }
+
+    fn press(&mut self, k: ModKey) -> Option<ModOut> {
+        if let Some((_, n)) = self.emitted.iter_mut().find(|(e, _)| *e == k) {
+            *n += 1;
+            return None;
+        }
+        self.emitted.push((k, 1));
+        Some((k, true))
+    }
+
+    fn release(&mut self, k: ModKey) -> Option<ModOut> {
+        let i = self.emitted.iter().position(|(e, _)| *e == k)?;
+        self.emitted[i].1 -= 1;
+        if self.emitted[i].1 > 0 {
+            return None;
+        }
+        self.emitted.remove(i);
+        Some((k, false))
+    }
+
+    /// A physical modifier went down or up. Returns what to send in its place (possibly nothing).
+    pub fn modifier(&mut self, phys: ModKey, down: bool) -> Vec<ModOut> {
+        let held = self.held.iter().position(|(p, _)| *p == phys);
+        match (down, held) {
+            // Already down (auto-repeat): the host already has it.
+            (true, Some(_)) => Vec::new(),
+            (true, None) => {
+                let e = ModKey::new(base_mod(self.dir, phys.m), phys.side);
+                self.held.push((phys, e));
+                self.press(e).into_iter().collect()
+            }
+            (false, Some(i)) => {
+                let (_, e) = self.held.remove(i);
+                self.release(e).into_iter().collect()
+            }
+            // Never sent (pressed before capture, or released by a mode change): drop it.
+            (false, None) => Vec::new(),
+        }
+    }
+
+    /// Tab went down: while the controller's switch modifier is held, move it to the host's
+    /// switch modifier (Cmd+Tab -> Alt+Tab, Alt+Tab -> Cmd+Tab). It stays there until released.
+    pub fn tab_down(&mut self) -> Vec<ModOut> {
+        let Some((from, to)) = switcher(self.dir) else {
+            return Vec::new();
+        };
+        let mut out = Vec::new();
+        for i in 0..self.held.len() {
+            let (p, e) = self.held[i];
+            if p.m != from || e.m == to {
+                continue;
+            }
+            // Always the left key: right Alt is AltGr (Ctrl+Alt) on many Windows layouts.
+            let new = ModKey::new(to, Side::Left);
+            out.extend(self.release(e));
+            self.held[i].1 = new;
+            out.extend(self.press(new));
+        }
+        out
+    }
+
+    /// The host modifier class for a local modifier class, for upstream's legacy-mode modifier
+    /// lists: what a held key of that class is currently sent as, else the table.
+    pub fn map_class(&self, m: Mod) -> Mod {
+        self.held
+            .iter()
+            .find(|(p, _)| p.m == m)
+            .map(|(_, e)| e.m)
+            .unwrap_or_else(|| base_mod(self.dir, m))
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum ChordAction {
+    /// Not part of the escape chord: handle normally.
+    Pass,
+    /// The chord's Esc (repeat or release): drop it.
+    Consume,
+    /// The chord completed: drop the Esc, release capture.
+    Release,
+}
+
+/// Physical modifier state for the escape chord. Fed from the grab loop for every key, captured
+/// or not, so it stays right across capture changes; updates are idempotent.
+#[derive(Debug, Default)]
+pub struct ChordTracker {
+    held: Vec<ModKey>,
+    esc_consumed: bool,
+}
+
+impl ChordTracker {
+    pub fn track(&mut self, key: Key, down: bool) {
+        let Some(k) = ModKey::from_rdev(key) else {
+            return;
+        };
+        let pos = self.held.iter().position(|h| *h == k);
+        match (down, pos) {
+            (true, None) => self.held.push(k),
+            (false, Some(i)) => {
+                self.held.remove(i);
+                // The chord is broken, so the next Esc with the chord is a new chord. The
+                // consumed Esc's own release is usually never seen: capture is gone by then.
+                if !self.chord_held() {
+                    self.esc_consumed = false;
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn has(&self, m: Mod) -> bool {
+        self.held.iter().any(|k| k.m == m)
+    }
+
+    pub fn chord_held(&self) -> bool {
+        self.has(Mod::Ctrl) && self.has(Mod::Alt) && self.has(Mod::Meta)
+    }
+
+    #[cfg(test)]
+    pub fn on_key(&mut self, key: Key, down: bool) -> ChordAction {
+        self.track(key, down);
+        if key != Key::Escape {
+            return ChordAction::Pass;
+        }
+        self.on_escape(down)
+    }
+
+    /// Esc went down or up; modifier state comes from `track`.
+    pub fn on_escape(&mut self, down: bool) -> ChordAction {
+        if down {
+            if self.chord_held() {
+                if self.esc_consumed {
+                    return ChordAction::Consume;
+                }
+                self.esc_consumed = true;
+                return ChordAction::Release;
+            }
+            // A fresh Esc: forget a consumed Esc whose release never arrived (capture was gone).
+            self.esc_consumed = false;
+            ChordAction::Pass
+        } else if self.esc_consumed {
+            self.esc_consumed = false;
+            ChordAction::Consume
+        } else {
+            ChordAction::Pass
+        }
+    }
+}
+
+fn event_key(event: &Event) -> Option<(Key, bool)> {
+    match event.event_type {
+        EventType::KeyPress(k) => Some((k, true)),
+        EventType::KeyRelease(k) => Some((k, false)),
+        _ => None,
+    }
+}
+
+/// Windows sends a fake LCtrl (scan code 0x021D) with AltGr; it is not a physical Ctrl.
+fn is_fake_ctrl(event: &Event) -> bool {
+    cfg!(target_os = "windows") && event.position_code == 0x021D
+}
+
+fn set_mod_key(e: &mut KeyEvent, k: ModKey, peer: &str, mode: KeyboardMode) {
+    match e.union {
+        Some(key_event::Union::ControlKey(_)) => e.set_control_key(k.to_control_key()),
+        Some(key_event::Union::Chr(_)) => e.set_chr(k.peer_code(peer)),
+        _ if mode == KeyboardMode::Legacy => e.set_control_key(k.to_control_key()),
+        _ => e.set_chr(k.peer_code(peer)),
+    }
+}
+
+/// A modifier event in the shape upstream would have built for `mode`.
+pub fn build_mod_event(m: ModOut, peer: &str, mode: KeyboardMode) -> KeyEvent {
+    let mut e = KeyEvent::new();
+    e.mode = mode.into();
+    set_mod_key(&mut e, m.0, peer, mode);
+    e.down = m.1;
+    e
+}
+
+fn remap_modifier_list(t: &Translator, e: &mut KeyEvent) {
+    let mut out: Vec<EnumOrUnknown<ControlKey>> = Vec::with_capacity(e.modifiers.len());
+    for ck in e.modifiers.iter() {
+        let ck = match ck.enum_value() {
+            Ok(v) => match ModKey::from_control_key(v) {
+                Some(k) => ModKey::new(t.map_class(k.m), k.side)
+                    .to_control_key()
+                    .into(),
+                None => *ck,
+            },
+            Err(_) => *ck,
+        };
+        if !out.contains(&ck) {
+            out.push(ck);
+        }
+    }
+    e.modifiers = out;
+}
+
+/// Translate the events upstream built for one physical key. Pure apart from `t`.
+pub fn translate_with(
+    t: &mut Translator,
+    dir: Direction,
+    peer: &str,
+    mode: KeyboardMode,
+    event: &Event,
+    events: Vec<KeyEvent>,
+) -> Vec<KeyEvent> {
+    let peer = normalize_peer(peer);
+    let mut out: Vec<KeyEvent> = t
+        .set_direction(dir)
+        .into_iter()
+        .map(|m| build_mod_event(m, &peer, mode))
+        .collect();
+    if dir == Direction::None {
+        // Raw mode / same OS: upstream's events, untouched.
+        out.extend(events);
+        return out;
+    }
+    let Some((key, down)) = event_key(event) else {
+        out.extend(events);
+        return out;
+    };
+    if let Some(phys) = ModKey::from_rdev(key) {
+        // Upstream dropped it (e.g. the fake AltGr LCtrl, or no mapping for this peer).
+        let Some(template) = events.into_iter().next() else {
+            return out;
+        };
+        if is_fake_ctrl(event) {
+            return out;
+        }
+        for m in t.modifier(phys, down) {
+            let mut e = template.clone();
+            set_mod_key(&mut e, m.0, &peer, mode);
+            e.down = m.1;
+            e.press = false;
+            remap_modifier_list(t, &mut e);
+            out.push(e);
+        }
+        return out;
+    }
+    if key == Key::Tab && down {
+        let switched = t.tab_down();
+        // Legacy mode carries the modifier state on every event (the host syncs to it), so the
+        // switched modifier events keep the Tab's list, e.g. Shift for Cmd+Shift+Tab.
+        let mut mods = events.first().map(|e| e.clone()).unwrap_or_default();
+        remap_modifier_list(t, &mut mods);
+        for m in switched {
+            let mut e = build_mod_event(m, &peer, mode);
+            if mode == KeyboardMode::Legacy {
+                e.modifiers = mods.modifiers.clone();
+            }
+            out.push(e);
+        }
+    }
+    for mut e in events {
+        remap_modifier_list(t, &mut e);
+        out.push(e);
+    }
+    out
+}
+
+/// Mouse events carry modifier flags (Cmd+click and so on); map them with the same table.
+pub fn map_mouse_modifiers(dir: Direction, mods: &mut Vec<EnumOrUnknown<ControlKey>>) {
+    if dir == Direction::None {
+        return;
+    }
+    let t = Translator {
+        dir,
+        ..Default::default()
+    };
+    let mut e = KeyEvent::new();
+    e.modifiers = std::mem::take(mods);
+    remap_modifier_list(&t, &mut e);
+    *mods = e.modifiers;
+}
+
+// ---- process-wide state (one physical keyboard, like upstream's TO_RELEASE) --------------------
+
+lazy_static::lazy_static! {
+    static ref TRANSLATOR: Mutex<Translator> = Mutex::new(Translator::default());
+    static ref CHORD: Mutex<ChordTracker> = Mutex::new(ChordTracker::default());
+}
+
+/// Record a physical key for the escape chord (the grab loop calls this for every key event).
+pub fn track_physical(event: &Event) {
+    if is_fake_ctrl(event) {
+        return;
+    }
+    if let Some((key, down)) = event_key(event) {
+        CHORD.lock().unwrap().track(key, down);
+    }
+}
+
+/// Escape-chord check for a key about to be forwarded. Runs before any mapping. Modifier state
+/// comes only from `track_physical`, so synthetic releases cannot clear it.
+pub fn check_escape_chord(event: &Event) -> ChordAction {
+    match event_key(event) {
+        Some((Key::Escape, down)) => CHORD.lock().unwrap().on_escape(down),
+        _ => ChordAction::Pass,
+    }
+}
+
+pub fn translate(
+    dir: Direction,
+    peer: &str,
+    mode: KeyboardMode,
+    event: &Event,
+    events: Vec<KeyEvent>,
+) -> Vec<KeyEvent> {
+    translate_with(
+        &mut TRANSLATOR.lock().unwrap(),
+        dir,
+        peer,
+        mode,
+        event,
+        events,
+    )
+}
+
+/// A Right-Ctrl tap for a Windows host, sent before the escape chord's releases: with no other
+/// key after Win, releasing Win (raw mode, or a Windows controller) would open the Start menu.
+pub fn win_key_mask_events(peer: &str, mode: KeyboardMode) -> Vec<KeyEvent> {
+    let peer = normalize_peer(peer);
+    if peer != "windows" {
+        return Vec::new();
+    }
+    let k = ModKey::new(Mod::Ctrl, Side::Right);
+    vec![
+        build_mod_event((k, true), &peer, mode),
+        build_mod_event((k, false), &peer, mode),
+    ]
+}
+
+/// Key-ups for whatever the translation still holds on the host (e.g. the Alt it switched to).
+pub fn take_release_events(peer: &str, mode: KeyboardMode) -> Vec<KeyEvent> {
+    let peer = normalize_peer(peer);
+    TRANSLATOR
+        .lock()
+        .unwrap()
+        .release_all()
+        .into_iter()
+        .map(|m| build_mod_event(m, &peer, mode))
+        .collect()
+}
