+        let out = translate_with(&mut t, d, "Windows", mode, &ev(Key::KeyC, true), vec![c]);
+        assert_eq!(
+            out[0].modifiers,
+            vec![
+                EnumOrUnknown::new(ControlKey::Control),
+                ControlKey::Shift.into()
+            ]
+        );
+        // Cmd+Tab: Control up, Alt down, then Tab with Alt in its modifier list.
+        let mut tab = KeyEvent::new();
+        tab.mode = mode.into();
+        tab.set_control_key(ControlKey::Tab);
+        tab.down = true;
+        tab.modifiers = vec![ControlKey::Meta.into()];
+        let out = translate_with(&mut t, d, "Windows", mode, &ev(Key::Tab, true), vec![tab]);
+        assert_eq!(out.len(), 3);
+        assert_eq!(
+            (out[0].control_key(), out[0].down),
+            (ControlKey::Control, false)
+        );
+        assert_eq!((out[1].control_key(), out[1].down), (ControlKey::Alt, true));
+        assert_eq!(out[2].control_key(), ControlKey::Tab);
+        assert_eq!(out[2].modifiers, vec![EnumOrUnknown::new(ControlKey::Alt)]);
+        assert_eq!(out[1].modifiers, out[2].modifiers);
+        // Cmd+Shift+Tab keeps Shift on the switched Alt.
+        let mut tab = KeyEvent::new();
+        tab.mode = mode.into();
+        tab.set_control_key(ControlKey::Tab);
+        tab.down = true;
+        tab.modifiers = vec![ControlKey::Meta.into(), ControlKey::Shift.into()];
+        let mut t = Translator::default();
+        let mut cmd = KeyEvent::new();
+        cmd.mode = mode.into();
+        cmd.set_control_key(ControlKey::Meta);
+        cmd.down = true;
+        translate_with(
+            &mut t,
+            d,
+            "Windows",
+            mode,
+            &ev(Key::MetaLeft, true),
+            vec![cmd],
+        );
+        let out = translate_with(&mut t, d, "Windows", mode, &ev(Key::Tab, true), vec![tab]);
+        assert_eq!((out[1].control_key(), out[1].down), (ControlKey::Alt, true));
+        assert!(out[1].modifiers.contains(&ControlKey::Shift.into()));
+    }
+
+    #[test]
+    fn mouse_modifiers() {
+        let mut m: Vec<EnumOrUnknown<ControlKey>> =
+            vec![ControlKey::Meta.into(), ControlKey::Shift.into()];
+        map_mouse_modifiers(Direction::MacToWindows, &mut m);
+        assert_eq!(
+            m,
+            vec![
+                EnumOrUnknown::new(ControlKey::Control),
+                ControlKey::Shift.into()
+            ]
+        );
+        let mut m: Vec<EnumOrUnknown<ControlKey>> =
+            vec![ControlKey::Control.into(), ControlKey::Meta.into()];
+        map_mouse_modifiers(Direction::WindowsToMac, &mut m);
+        assert_eq!(
+            m,
+            vec![
+                EnumOrUnknown::new(ControlKey::Meta),
+                ControlKey::Control.into()
+            ]
+        );
+        let mut m: Vec<EnumOrUnknown<ControlKey>> =
+            vec![ControlKey::Meta.into(), ControlKey::Control.into()];
+        map_mouse_modifiers(Direction::MacToWindows, &mut m);
+        assert_eq!(m, vec![EnumOrUnknown::new(ControlKey::Control)]);
+        let mut m: Vec<EnumOrUnknown<ControlKey>> = vec![ControlKey::Meta.into()];
+        map_mouse_modifiers(Direction::None, &mut m);
+        assert_eq!(m, vec![EnumOrUnknown::new(ControlKey::Meta)]);
+    }
+}
