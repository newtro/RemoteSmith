@@ -1261,6 +1272,7 @@ impl Connection {
                         );
                     }
                     MessageInput::Key((mut msg, press)) => {
+                        held.on_key(&msg, press);
                         // Set the press state to false, use `down` only in `handle_key()`.
                         msg.press = false;
                         if press {
@@ -1310,6 +1322,24 @@ impl Connection {
                 }
             }
         }
+        // RemoteSmith (AC-41): the connection is gone; let go of everything it still holds,
+        // through the same injection path the downs took.
+        if !held.is_empty() {
+            let (mouse_ups, key_ups) = held.take_releases();
+            log::info!(
+                "connection ended holding {} button(s) and {} key(s); releasing",
+                mouse_ups.len(),
+                key_ups.len()
+            );
+            if let Some((conn_id, username, argb)) = last_mouse_conn {
+                for m in mouse_ups.iter() {
+                    handle_mouse(m, conn_id, username.clone(), argb, true, false);
+                }
+            }
+            for k in key_ups.iter() {
+                handle_key(k);
+            }
+        }
         #[cfg(target_os = "linux")]
         clear_remapped_keycode();
         log::debug!("Input thread exited");
