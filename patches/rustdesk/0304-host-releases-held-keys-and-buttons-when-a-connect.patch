diff --git a/src/remotesmith_trust/held_input.rs b/src/remotesmith_trust/held_input.rs
new file mode 100644
index 000000000000..d6aaa510b159
--- /dev/null
+++ b/src/remotesmith_trust/held_input.rs
@@ -0,0 +1,203 @@
+//! What a connection is holding down on the host, so it can be let go (RemoteSmith DEF-7,
+//! AC-41).
+//!
+//! Upstream releases almost nothing when a connection ends: `release_pressed_modifiers` in
+//! `Drop for Connection` covers a set that is nearly always empty, held keys are force-released
+//! only after six minutes or at process exit, and mouse buttons never are. So a drop during a
+//! drag, or while a key is held, leaves it stuck on the host.
+//!
+//! The connection's input thread feeds every event it injects through [`HeldInput`] and, when
+//! the connection ends, injects the matching "up" events through the same path (main-thread
+//! queue on macOS, the portable service on Windows when it runs), so they reach whatever got the
+//! "down".
+
+use crate::common::input::{MOUSE_TYPE_DOWN, MOUSE_TYPE_MASK, MOUSE_TYPE_UP};
+use base::message_proto::{key_event, KeyEvent, KeyboardMode, MouseEvent};
+use hbb_common::protobuf::EnumOrUnknown;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum KeyId {
+    Control(i32, i32),
+    Chr(i32, u32),
+    Win2Win(i32, u32),
+}
+
+fn key_id(evt: &KeyEvent) -> Option<KeyId> {
+    let mode = evt.mode.value();
+    match evt.union {
+        Some(key_event::Union::ControlKey(ck)) => Some(KeyId::Control(mode, ck.value())),
+        Some(key_event::Union::Chr(c)) => Some(KeyId::Chr(mode, c)),
+        Some(key_event::Union::Win2winHotkey(c)) => Some(KeyId::Win2Win(mode, c)),
+        // Unicode and sequences are typed whole, never held.
+        _ => None,
+    }
+}
+
+#[derive(Default, Debug)]
+pub struct HeldInput {
+    keys: BTreeMap<KeyId, KeyEvent>,
+    /// Button bits currently down.
+    buttons: BTreeSet<i32>,
+    /// Where the last mouse event pointed, for the synthesized releases.
+    last_pos: (i32, i32),
+}
+
+impl HeldInput {
+    /// Record a key event as injected. `press` (a click) holds nothing.
+    pub fn on_key(&mut self, evt: &KeyEvent, press: bool) {
+        let Some(id) = key_id(evt) else {
+            return;
+        };
+        if evt.down && !press {
+            self.keys.insert(id, evt.clone());
+        } else {
+            self.keys.remove(&id);
+        }
+    }
+
+    /// Record a mouse event as injected.
+    pub fn on_mouse(&mut self, evt: &MouseEvent) {
+        self.last_pos = (evt.x, evt.y);
+        let buttons = evt.mask >> 3;
+        if buttons == 0 {
+            return;
+        }
+        match evt.mask & MOUSE_TYPE_MASK {
+            MOUSE_TYPE_DOWN => {
+                self.buttons.insert(buttons);
+            }
+            MOUSE_TYPE_UP => {
+                self.buttons.remove(&buttons);
+            }
+            _ => {}
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.keys.is_empty() && self.buttons.is_empty()
+    }
+
+    /// The events that let go of everything still held, and forget it: buttons first (ends a
+    /// drag where it is), then keys.
+    pub fn take_releases(&mut self) -> (Vec<MouseEvent>, Vec<KeyEvent>) {
+        let (x, y) = self.last_pos;
+        let mouse = std::mem::take(&mut self.buttons)
+            .into_iter()
+            .map(|b| MouseEvent {
+                mask: (b << 3) | MOUSE_TYPE_UP,
+                x,
+                y,
+                ..Default::default()
+            })
+            .collect();
+        let keys = std::mem::take(&mut self.keys)
+            .into_values()
+            .map(|mut k| {
+                k.down = false;
+                k.press = false;
+                // No modifiers in the release: they would be pressed again around it.
+                k.modifiers.clear();
+                if k.mode.enum_value().is_err() {
+                    k.mode = EnumOrUnknown::new(KeyboardMode::Legacy);
+                }
+                k
+            })
+            .collect();
+        (mouse, keys)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::common::input::{MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT, MOUSE_TYPE_MOVE};
+    use base::message_proto::ControlKey;
+
+    fn mouse(t: i32, b: i32, x: i32, y: i32) -> MouseEvent {
+        MouseEvent {
+            mask: (b << 3) | t,
+            x,
+            y,
+            ..Default::default()
+        }
+    }
+
+    fn ck(k: ControlKey, down: bool) -> KeyEvent {
+        let mut e = KeyEvent::new();
+        e.set_control_key(k);
+        e.down = down;
+        e.mode = KeyboardMode::Map.into();
+        e
+    }
+
+    fn chr(c: u32, down: bool) -> KeyEvent {
+        let mut e = KeyEvent::new();
+        e.set_chr(c);
+        e.down = down;
+        e.mode = KeyboardMode::Map.into();
+        e.modifiers.push(ControlKey::Shift.into());
+        e
+    }
+
+    #[test]
+    fn a_drop_mid_drag_releases_the_button_where_it_is() {
+        let mut h = HeldInput::default();
+        h.on_mouse(&mouse(MOUSE_TYPE_DOWN, MOUSE_BUTTON_LEFT, 10, 10));
+        h.on_mouse(&mouse(MOUSE_TYPE_MOVE, 0, 50, 60));
+        let (m, k) = h.take_releases();
+        assert!(k.is_empty());
+        assert_eq!(m.len(), 1);
+        assert_eq!(m[0].mask, (MOUSE_BUTTON_LEFT << 3) | MOUSE_TYPE_UP);
+        assert_eq!((m[0].x, m[0].y), (50, 60));
+        assert!(h.is_empty());
+    }
+
+    #[test]
+    fn released_buttons_and_keys_are_not_released_again() {
+        let mut h = HeldInput::default();
+        h.on_mouse(&mouse(MOUSE_TYPE_DOWN, MOUSE_BUTTON_RIGHT, 0, 0));
+        h.on_mouse(&mouse(MOUSE_TYPE_UP, MOUSE_BUTTON_RIGHT, 0, 0));
+        h.on_key(&ck(ControlKey::Shift, true), false);
+        h.on_key(&ck(ControlKey::Shift, false), false);
+        assert!(h.is_empty());
+        let (m, k) = h.take_releases();
+        assert!(m.is_empty() && k.is_empty());
+    }
+
+    #[test]
+    fn held_keys_are_released_as_up_events_without_modifiers() {
+        let mut h = HeldInput::default();
+        h.on_key(&ck(ControlKey::Control, true), false);
+        h.on_key(&chr(0x26, true), false);
+        // A click holds nothing.
+        h.on_key(&ck(ControlKey::Return, true), true);
+        let (_, k) = h.take_releases();
+        assert_eq!(k.len(), 2);
+        assert!(k.iter().all(|e| !e.down && !e.press && e.modifiers.is_empty()));
+        assert!(k.iter().all(|e| e.mode.enum_value() == Ok(KeyboardMode::Map)));
+        assert!(h.take_releases().1.is_empty());
+    }
+
+    #[test]
+    fn a_key_held_twice_is_released_once() {
+        let mut h = HeldInput::default();
+        h.on_key(&ck(ControlKey::Alt, true), false);
+        h.on_key(&ck(ControlKey::Alt, true), false);
+        assert_eq!(h.take_releases().1.len(), 1);
+    }
+
+    #[test]
+    fn unicode_and_sequences_hold_nothing() {
+        let mut h = HeldInput::default();
+        let mut e = KeyEvent::new();
+        e.set_seq("abc".into());
+        e.down = true;
+        h.on_key(&e, false);
+        let mut u = KeyEvent::new();
+        u.set_unicode(0x41);
+        u.down = true;
+        h.on_key(&u, false);
+        assert!(h.is_empty());
+    }
+}
