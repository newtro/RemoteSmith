     async fn handle_request_relay(&self, rr: RequestRelay, server: ServerPtr) -> ResultType<()> {
         let addr = AddrMangle::decode(&rr.socket_addr);
+        // RemoteSmith (AC-61): hbbs forwards relay requests without a key check, so a keyless
+        // client could name its own relay. Only ours is followed.
+        let pinned = crate::remotesmith_trust::relay_pin::pinned_relay(
+            &Config::get_option("relay-server"),
