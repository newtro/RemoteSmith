+        if !crate::remotesmith_trust::relay_pin::is_allowed(&rr.relay_server, &pinned) {
+            log::warn!(
+                "refused a relay request from {} naming relay {:?}; this host only uses {}",
+                addr,
+                rr.relay_server,
+                pinned
+            );
+            return Ok(());
+        }
         let last = *LAST_RELAY_MSG.lock().await;
         *LAST_RELAY_MSG.lock().await = (addr, Instant::now());
         // skip duplicate relay request messages
@@ -1330,14 +1345,25 @@ impl RendezvousMediator {
     }
 
     fn get_relay_server(&self, provided_by_rendezvous_server: String) -> String {
-        let mut relay_server = Config::get_option("relay-server");
-        if relay_server.is_empty() {
-            relay_server = provided_by_rendezvous_server;
-        }
-        if relay_server.is_empty() {
-            relay_server = crate::increase_port(&self.host, 1);
+        // RemoteSmith (AC-61): always our pinned relay (the configured one, else our rendezvous
+        // server's relay port), never one named by the rendezvous server.
+        let pinned = crate::remotesmith_trust::relay_pin::pinned_relay(
+            &Config::get_option("relay-server"),
+            &self.host,
+        );
+        if !provided_by_rendezvous_server.is_empty()
+            && !crate::remotesmith_trust::relay_pin::is_allowed(
+                &provided_by_rendezvous_server,
+                &pinned,
+            )
+        {
+            log::warn!(
+                "rendezvous server named relay {:?}; using this host's relay {}",
+                provided_by_rendezvous_server,
+                pinned
+            );
         }
-        relay_server
+        pinned
     }
 }
 
