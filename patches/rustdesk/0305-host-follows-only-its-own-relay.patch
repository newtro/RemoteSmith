+//! Relay pinning on the host (RemoteSmith AC-61, mitigating the AC-5 server limitation).
+//!
+//! OSS hbbs 1.1.16 forwards a controller's `RequestRelay` to the host without any key check,
+//! and a stock host connects to whatever relay the request names. So a keyless client that
+//! knows the host's ID could steer the host's session to a relay it controls. The host now
+//! uses only its own relay:
+//! - the configured `relay-server` option when set, otherwise
+//! - the relay port (21117) on its own rendezvous server, which is what RemoteSmith's hbbs
+//!   advertises (`--relay-servers <same host>:21117`).
+//!
+//! A `RequestRelay` naming any other relay is refused and logged. Where the host itself picks
+//! the relay (punch hole, intranet fallback) it picks the pinned one, ignoring a different one
+//! from hbbs. Direct and LAN paths do not involve a relay and are unaffected.
+
+use hbb_common::config::RELAY_PORT;
+
+/// `host:port` lowercased, with the relay port added when missing.
+pub fn normalize(relay: &str) -> String {
+    hbb_common::socket_client::check_port(relay.trim().to_lowercase(), RELAY_PORT)
+}
+
+/// The only relay this host uses. `rendezvous_host` is the `host:port` of its rendezvous server.
+pub fn pinned_relay(configured_relay: &str, rendezvous_host: &str) -> String {
+    if !configured_relay.trim().is_empty() {
+        normalize(configured_relay)
+    } else {
+        normalize(&hbb_common::socket_client::increase_port(
+            rendezvous_host.trim(),
+            1,
+        ))
+    }
+}
+
+/// Whether a relay named by someone else (hbbs, or a controller through hbbs) is ours.
+pub fn is_allowed(requested: &str, pinned: &str) -> bool {
+    !requested.trim().is_empty() && normalize(requested) == normalize(pinned)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_configured_relay_wins() {
+        assert_eq!(
+            pinned_relay("Relay.Example.org", "rs.example.org:21116"),
+            "relay.example.org:21117"
+        );
+        assert_eq!(
+            pinned_relay("relay.example.org:9000", "rs.example.org:21116"),
+            "relay.example.org:9000"
+        );
+    }
+
+    #[test]
+    fn without_one_it_is_the_rendezvous_hosts_relay_port() {
+        assert_eq!(pinned_relay("", "rs.example.org:21116"), "rs.example.org:21117");
+        assert_eq!(pinned_relay("  ", "10.0.0.2:21116"), "10.0.0.2:21117");
+    }
+
+    #[test]
+    fn our_relay_is_allowed_in_any_spelling() {
+        let pinned = pinned_relay("", "rs.example.org:21116");
+        assert!(is_allowed("rs.example.org:21117", &pinned));
+        assert!(is_allowed("RS.EXAMPLE.ORG", &pinned));
+        assert!(is_allowed(" rs.example.org ", &pinned));
+    }
+
+    #[test]
+    fn any_other_relay_is_refused() {
+        let pinned = pinned_relay("", "rs.example.org:21116");
+        assert!(!is_allowed("evil.example.net:21117", &pinned));
+        assert!(!is_allowed("rs.example.org:21118", &pinned));
+        assert!(!is_allowed("rs.example.org.evil.net", &pinned));
+        assert!(!is_allowed("203.0.113.9:21117", &pinned));
+        assert!(!is_allowed("", &pinned));
+    }
+}
diff --git a/src/rendezvous_mediator.rs b/src/rendezvous_mediator.rs
