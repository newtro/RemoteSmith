# RemoteSmith rendezvous/ID server: RustDesk hbbs (OSS) 1.1.16.
# Installed by deploy/server/install.sh. Edit the repo copy, not /etc/systemd/system.
#
# Ports (all interfaces, IPv4 and IPv6): TCP 21115 (NAT test), TCP+UDP 21116
# (rendezvous). hbbs also always binds TCP 21118 (WebSocket); it has no switch to turn
# that off, so ufw and the Lightsail firewall keep 21118 closed (DEF-14).

[Unit]
Description=RemoteSmith rendezvous server (RustDesk hbbs)
Documentation=https://github.com/rustdesk/rustdesk-server
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/remotesmith-server/bin/hbbs
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=remotesmith
Group=remotesmith
# hbbs reads id_ed25519 and reads/writes db_v2.sqlite3 in its cwd.
WorkingDirectory=/opt/remotesmith-server/data
# install.sh creates the keypair before the first start (rustdesk-utils genkeypair).
# hbbs 1.1.16 fails OPEN when it can't read or create its key: it runs with an empty
# key and accepts every client. So hbbs never starts without a valid, readable key,
# and never gets to mint one itself (an unreadable id_ed25519 would also make it
# overwrite id_ed25519.pub with a fresh, mismatched key).
ExecStartPre=/opt/remotesmith-server/libexec/keycheck.sh /opt/remotesmith-server/data
# hbbs resolves the -r name once at startup and silently drops it if DNS fails, after
# which it hands clients no relay until restarted. Give DNS up to 60 s at boot; start
# anyway if it never answers (the "-" prefix), and install.sh --status flags it.
ExecStartPre=-/opt/remotesmith-server/libexec/wait-resolve.sh rs.johnnycode.ai 60
# -k _ : load the keypair from data/ and refuse clients whose key differs. This is
#        hbbs's default ("-"); it is spelled out so it can't drift.
# -r   : the relay that hbbs hands to clients.
ExecStart=/opt/remotesmith-server/bin/hbbs --port 21116 --relay-servers rs.johnnycode.ai:21117 --key _
TimeoutStartSec=120
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=RUST_LOG=info
LimitNOFILE=65536

# Measured on 1.1.16 (README "Memory"): ~5 MiB idle, ~7 MiB peak under 600 concurrent
# TCP sessions plus 3000 UDP registrations. The cap protects the neighbours on a VM
# with ~1.6 GiB available; it is ~9x the measured peak.
MemoryHigh=48M
MemoryMax=64M
TasksMax=256

# --- sandboxing -------------------------------------------------------------
# Internet-facing on a box with ~18 other production apps.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/opt/remotesmith-server/data
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
