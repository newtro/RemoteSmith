# RemoteSmith server: per-deployment settings.
#
# Copy to site.env (same directory) and fill in your own values. site.env is
# gitignored: the public repo carries no deployment's host, addresses or account
# names (PLAN AC-33, DEC-15). The kit reads it as data (site-env.sh), never as a script.
#
# Who reads what:
#   install.sh        RS_HOST (or --host). The kit is copied to the server with
#                     site.env alongside it, so the server-side copy knows its name.
#   verify-server.sh  RS_HOST, RS_IPV4, RS_IPV6, SSH_TARGET (each also a flag).
#   scripts/verify.sh every value below, as strings that must not appear in tracked files.
#   dns.md, firewall.md, README.md   the procedures refer to these by name.
#
# The ports are fixed at RustDesk's defaults (TCP 21115-21117, UDP 21116), which is
# what clients assume when given only a host; they are not settings.

# Public DNS name of the server. Clients use it as the ID server and RS_HOST:21117 as
# the relay; hbbs hands out RS_HOST:21117 as its relay (--relay-servers).
RS_HOST=rs.example.com

# The server's public addresses: what the A and AAAA records must say (DNS-only).
# Leave RS_IPV6 empty if the server has no IPv6.
RS_IPV4=192.0.2.10
RS_IPV6=2001:db8::10

# How the Mac reaches the server over ssh (an ~/.ssh/config alias or user@host).
SSH_TARGET=ubuntu@rs.example.com

# Lightsail instance firewall (firewall.md section 1). Leave empty if not on Lightsail.
LIGHTSAIL_INSTANCE=my-instance
LIGHTSAIL_REGION=us-east-1
AWS_PROFILE=default

# Cloudflare zone that holds RS_HOST, and the local file with CLOUDFLARE_API_TOKEN
# (dns.md). Leave empty if your DNS is elsewhere.
CF_ZONE=example.com
CF_CREDENTIALS_FILE=~/path/to/cloudflare-credentials.env
